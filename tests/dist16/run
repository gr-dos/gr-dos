#!/usr/bin/env perl

use 5.042;
use warnings;
use Digest::SHA qw( sha256_hex );
use File::Basename qw( dirname );
use File::Path qw( make_path remove_tree );
use Archive::Tar ();
use IO::Compress::Gzip ();
use IO::Compress::Zip ();
use JSON::PP ();

# ABSTRACT: Test scripts/dist16 offline, against a fake GitHub (make test-dist16)

=head1 SYNOPSIS

 tests/dist16/run OUTDIR

=head1 DESCRIPTION

Runs F<scripts/dist16> against fixtures in OUTDIR, which stand in for the
GitHub API, release downloads and raw files through C<file://> URLs, so
it needs no network. Each case is a config, the repositories and releases
GitHub has, and what C<resolve>, C<check> or C<fetch> must then do:
gr-dos/libc16 and the other lib*16 libraries excluded (issue #61); include and exclude precedence; no release, a
pinned release and a prerelease; malformed releases; checksum and size
mismatches; unexpected and ambiguous asset names; collisions with GR-DOS's
files and between programs; missing and disallowed licenses; 32-bit and
malformed programs; GitHub refusing (a rate limit) or failing; forks,
archived and private repositories; a deterministic lock, reproduced
offline from the cache; and programs under a source license (issue #56):
GPL-2.0-or-later and GPL-1.0-or-later programs with their corresponding
source and a linked library's, resolved, locked, fetched, staged and packaged, and each way
its source can be missing, unverifiable or mislabeled; and a license
override (issue #83), verified by SHA-256, and each way it is refused;
and a license asset (issue #37), a release's license notice for its
program, pinned, staged as STEM.LIC and checked in the distribution.

=cut

my $root = dirname(dirname(dirname(__FILE__)));
my $tool = "$root/scripts/dist16";
my $out = shift // die "usage: tests/dist16/run OUTDIR\n";
my $json = JSON::PP->new->canonical;
my($tests, $failed) = (0, 0);

sub diag (@lines) { say "# $_" for @lines }

sub ok ($cond, $what) {
  $tests++;
  $failed++ unless $cond;
  say $cond ? "ok $tests - $what" : "not ok $tests - $what";
  return $cond;
}

sub spew ($path, $data) {
  make_path(dirname($path));
  open my $fh, '>:raw', $path or die "$path: $!";
  print $fh $data;
  close $fh;
}

sub slurp ($path) {
  open my $fh, '<:raw', $path or return undef;
  local $/;
  return scalar <$fh>;
}

# A small real-mode MZ program: a header of 2 paragraphs and SIZE bytes in
# all, filled from SEED so each program differs.
sub mz ($size = 600, $seed = 'x') {
  my $pages = int(($size + 511) / 512);
  my $last = $size % 512;
  my $hdr = pack('a2 v4 v4 v2 v', 'MZ', $last, $pages, 0, 2, 0, 0xFFFF, 0, 0x100, 0, 0, 0, 0x1C, 0);
  return substr($hdr . ($seed x $size), 0, $size);
}

# A license file: the GPL version 1's is its own text, not version 2's.
sub license_text ($full, $spdx) {
  return "GNU GENERAL PUBLIC LICENSE\nVersion 1, February 1989\n(GPL-1.0 license of $full)\n" if $spdx eq 'GPL-1.0';
  return "$spdx license of $full\n";
}

# Archives of FILES, { path => content }: a .tar.gz and a .zip.
sub tgz (%files) {
  my $t = Archive::Tar->new;
  $t->add_data($_, $files{$_}, { mtime => 0 }) for sort keys %files;
  open my $fh, '>', \my $tar or die;
  $t->write($fh);
  close $fh;
  IO::Compress::Gzip::gzip(\$tar => \my $gz, Minimal => 1) or die;
  return $gz;
}

sub zip (%files) {
  my @names = sort keys %files;
  my $z = IO::Compress::Zip->new(\my $out, Name => shift(@names), Minimal => 1) or die;
  $z->print($files{ (sort keys %files)[0] });
  for my $n (@names) {
    $z->newStream(Name => $n, Minimal => 1);
    $z->print($files{$n});
  }
  $z->close;
  return $out;
}

# The fake GitHub, in $dir: owners' repositories and their releases.
# A release is { tag, assets => { name => data }, license => SPDX or undef,
# draft, prerelease, digest => { name => sha256 }, size => { name => n } }.
my $case_n = 0;
sub github (%gh) {
  my $dir = "$out/case" . ++$case_n;
  remove_tree($dir);
  my $api = "$dir/api";
  for my $owner (sort keys $gh{owners}->%*) {
    my @repos = $gh{owners}{$owner}->@*;
    my @list = map { { name => $_->{name}, full_name => "$owner/$_->{name}",
      fork => $_->{fork} ? JSON::PP::true : JSON::PP::false,
      archived => $_->{archived} ? JSON::PP::true : JSON::PP::false,
      private => $_->{private} ? JSON::PP::true : JSON::PP::false } } @repos;
    # GitHub lists only the public repositories.
    spew("$api/users/$owner/repos\@per_page=100&page=1", $json->encode([ map { $list[$_] } grep { !$repos[$_]{private} } 0 .. $#repos ]));
    for my $i (0 .. $#repos) {
      my $r = $repos[$i];
      my $full = "$owner/$r->{name}";
      spew("$api/repos/$full/index", $json->encode($list[$i]));
      for my $rel (($r->{releases} // [])->@*) {
        my $tag = $rel->{tag};
        my $sha = substr(sha256_hex("$full $tag"), 0, 40);
        my @assets = map {
          my $name = $_;
          my $data = $rel->{assets}{$name};
          { name => $name, size => $rel->{size}{$name} // length($data),
            digest => exists $rel->{digest}{$name} ? $rel->{digest}{$name} : 'sha256:' . sha256_hex($data) }
        } sort keys $rel->{assets}->%*;
        my $release = { tag_name => $tag, draft => $rel->{draft} ? JSON::PP::true : JSON::PP::false,
          prerelease => $rel->{prerelease} ? JSON::PP::true : JSON::PP::false, assets => \@assets };
        $release = $rel->{raw} if exists $rel->{raw};
        spew("$api/repos/$full/releases/tags/$tag", ref $release ? $json->encode($release) : $release);
        spew("$api/repos/$full/releases/latest", ref $release ? $json->encode($release) : $release) if $rel->{latest};
        spew("$api/repos/$full/commits/$tag", $json->encode({ sha => $sha }));
        if(defined $rel->{license}) {
          my $path = $rel->{license_path} // 'LICENSE';
          spew("$api/repos/$full/license\@ref=$sha", $json->encode({ path => $path, license => { spdx_id => $rel->{license} } }));
          spew("$dir/raw/$full/$sha/$path", license_text($full, $rel->{license}));
        }
        spew("$dir/raw/$full/$sha/$_", $rel->{files}{$_}) for keys(($rel->{files} // {})->%*);
        spew("$dir/dl/$full/releases/download/$tag/$_", $rel->{assets}{$_}) for keys $rel->{assets}->%*;
      }
    }
  }
  for my $status (sort keys(($gh{status} // {})->%*)) {
    spew("$api$status.status", $gh{status}{$status});
  }
  spew("$dir/config", $gh{config});
  return $dir;
}

# Run dist16 in a case: (exit status, output).
sub dist16 ($dir, @args) {
  my @opts = ('--config', "$dir/config", '--lock', "$dir/lock", '--cache', "$dir/cache",
    '--api', "file://$dir/api", '--github', "file://$dir/dl", '--raw', "file://$dir/raw",
    '--reserved', 'IO.SYS MSDOS.SYS COMMAND.COM MORE.COM TICO.EXE');
  my $cmd = join ' ', map { quotemeta } $tool, @opts, @args;
  my $output = `$cmd 2>&1`;
  return ($? >> 8, $output);
}

sub lock_lines ($dir) { [ grep { !/^#/ } split /\n/, slurp("$dir/lock") // '' ] }
sub has ($lines, $re) { scalar grep { $_ =~ $re } @$lines }

my $base_config = "discover gr-dos 16\nlicense MIT\n";
my $LIBRARY = 'library repository (lib*16 convention), not a DOS executable';
sub prog ($name, %r) {
  return { name => $name, releases => [ { tag => 'v0.01', latest => 1, license => 'MIT',
    assets => { ($name =~ s/16$//r) . '.exe' => mz(600, $name) }, %r } ] };
}

# 1. gr-dos/libc16 is excluded as a library (lib*16), with no exclude,
# though its name ends in 16 and it has a release; the others are
# included, in a deterministic, sorted lock.
{
  my $dir = github(config => $base_config, owners => { 'gr-dos' => [
    prog('md5sum16'), prog('crcsum16'),
    { name => 'libc16', releases => [ { tag => 'v0.04', latest => 1, license => 'MIT',
      assets => { 'libc16-0.04.zip' => 'PK' } } ] },
    { name => 'gr-dos' }, { name => 'notes' } ] });
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'resolve succeeds');
  ok(has($lines, qr{^skip gr-dos/libc16 excluded \Q$LIBRARY\E$}), 'gr-dos/libc16 is excluded, with its reason');
  ok(!has($lines, qr{^program gr-dos/libc16}), 'gr-dos/libc16 is not a program');
  ok($o =~ m{^excluded +gr-dos/libc16: \Q$LIBRARY\E$}m, 'the report says libc16 is excluded');
  ok(@$lines == 3 && $lines->[0] =~ m{^program gr-dos/crcsum16 v0\.01 [0-9a-f]{40} crcsum\.exe CRCSUM\.EXE 600 }
    && $lines->[1] =~ m{^program gr-dos/libc16|^skip gr-dos/libc16} && $lines->[2] =~ m{^program gr-dos/md5sum16 },
    'only *16 repositories, sorted by name');
  my $first = slurp("$dir/lock");
  ($rc) = dist16($dir, 'resolve');
  ok(slurp("$dir/lock") eq $first, 'resolving again writes the same lock');
  ($rc, $o) = dist16($dir, 'check');
  ok($rc == 0 && $o =~ /is up to date/, 'check: the lock is up to date');

  # A new release changes the lock only through resolve; check shows it.
  spew("$dir/api/repos/gr-dos/md5sum16/releases/latest", slurp("$dir/api/repos/gr-dos/md5sum16/releases/tags/v0.01") =~ s/v0\.01/v0.02/r);
  ($rc, $o) = dist16($dir, 'check');
  ok($rc == 1 && $o =~ /^- program gr-dos\/md5sum16 v0\.01/m, 'check: a new release is drift, exit 1, with the lines');
  ok(slurp("$dir/lock") eq $first, 'check does not change the lock');

  # fetch: the programs and licenses, then offline from the cache.
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest");
  ok($rc == 0 && -f "$dir/dest/CRCSUM.EXE" && -f "$dir/dest/MD5SUM.EXE" && -f "$dir/dest/licenses/MD5SUM.EXE.txt",
    'fetch stages the programs and licenses');
  ok(slurp("$dir/dest/CRCSUM.EXE") eq mz(600, 'crcsum16'), 'a fetched program is the release asset');
  remove_tree("$dir/dl", "$dir/raw");
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest2");
  ok($rc == 0 && slurp("$dir/dest2/MD5SUM.EXE") eq slurp("$dir/dest/MD5SUM.EXE"), 'offline, fetch reproduces them from the cache');
  spew("$dir/cache/gr-dos/md5sum16/v0.01/md5sum.exe", 'tampered');
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest3");
  ok($rc == 2 && $o =~ /md5sum16 v0\.01 md5sum\.exe: cannot download .*no verified copy/, 'offline, a corrupt cache is refused, not used');
  unlink "$dir/cache/gr-dos/md5sum16/v0.01/md5sum.exe";
  spew("$dir/dl/gr-dos/md5sum16/releases/download/v0.01/md5sum.exe", mz(600, 'md5sum16'));
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest3");
  ok($rc == 0 && -f "$dir/dest3/MD5SUM.EXE", 'a fetch that failed part way can be run again');
  my($lrc, $list) = dist16($dir, 'list');
  ok($lrc == 0 && $list eq "CRCSUM.EXE\nMD5SUM.EXE\n", 'list: the DOS names, in lock order');
  ok(!-e "$dir/dest/SOURCES.TXT" && !-e "$dir/dest/source", 'permissive programs only: no SOURCES.TXT and no source');
  make_path("$dir/zip/BIN");
  spew("$dir/zip/README.txt", "GR-DOS\r\n");
  ($rc, $o) = dist16($dir, 'check-dist', "$dir/zip", "$dir/dest");
  ok($rc == 0 && $o =~ /no program under a source license/, 'check-dist: a ZIP with no source is right then');
  spew("$dir/zip/BIN/SOURCES.TXT", '');
  ($rc, $o) = dist16($dir, 'check-dist', "$dir/zip", "$dir/dest");
  ok($rc == 2 && $o =~ /no program has a source license, but it exists/, 'check-dist: and a SOURCES.TXT then is an error');
  spew("$dir/notdist", 'x');
  ($rc, $o) = dist16($dir, 'fetch', "$dir/notdist");
  ok($rc == 2 && $o =~ /not a dist16 directory/, 'fetch will not remove a directory it did not make');
}

# 2. Include and exclude precedence.
{
  my $dir = github(config => "$base_config" . "exclude gr-dos/libc16 a library\ninclude gr-dos/libc16\n", owners => { 'gr-dos' => [ prog('libc16') ] });
  my($rc, $o) = dist16($dir, 'resolve');
  ok($rc == 2 && $o =~ /both included and excluded/ && !-e "$dir/lock", 'a repository both included and excluded is an error');

  $dir = github(config => "discover gr-dos 16\nexclude gr-dos/x16\nlicense MIT\n", owners => { 'gr-dos' => [] });
  ($rc, $o) = dist16($dir, 'resolve');
  ok($rc == 2 && $o =~ /the reason is required/, 'an exclude needs a reason');

  $dir = github(config => "$base_config" . "exclude gr-dos/gone16 removed\ninclude other/tool16\ninclude gr-dos/a16 tag=v0.01\n",
    owners => { 'gr-dos' => [ { name => 'a16', releases => [
        { tag => 'v0.01', license => 'MIT', assets => { 'a.exe' => mz(600, 'a1') } },
        { tag => 'v0.02', latest => 1, license => 'MIT', assets => { 'a.exe' => mz(600, 'a2') } } ] } ],
      other => [ prog('tool16'), prog('unrelated16') ] });
  ($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0 && has($lines, qr{^program other/tool16 v0\.01 .* TOOL\.EXE }), 'an include adds another owner\'s repository');
  ok(!has($lines, qr{unrelated16}), 'only the named repository of that owner');
  ok(has($lines, qr{^program gr-dos/a16 v0\.01 }) && (grep { m{gr-dos/a16} } @$lines) == 1,
    'an include of a discovered repository pins its tag, with no duplicate');
  ok($o =~ m{gr-dos/a16 is pinned at v0\.01; the latest release is v0\.02}, 'the report notes the newer release');
  ok($o =~ m{exclude gr-dos/gone16 matches no discovered repository}, 'an exclude that matches nothing is reported');
}

# 3. No release, a missing pinned release, drafts and prereleases;
# forks, archived and private repositories.
{
  my $dir = github(config => "$base_config" . "include gr-dos/pin16 tag=v9.99\ninclude gr-dos/oldfork16\ninclude other/secret16\n",
    owners => { 'gr-dos' => [ { name => 'none16' }, prog('pin16'), prog('pre16', prerelease => 1),
      prog('fork16'), { %{ prog('oldfork16') }, fork => 1 }, { %{ prog('fork16b') }, name => 'fork16', fork => 1 },
      { %{ prog('arch16') }, archived => 1 } ],
    other => [ { %{ prog('secret16') }, private => 1 } ] });
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'resolve succeeds');
  ok(has($lines, qr{^skip gr-dos/none16 unavailable no release$}), 'no release: unavailable');
  ok(has($lines, qr{^skip gr-dos/pin16 unavailable no release v9\.99$}), 'a pinned release that does not exist: unavailable');
  ok(has($lines, qr{^skip gr-dos/pre16 unavailable v0\.01 is a prerelease$}), 'a prerelease: unavailable');
  ok(has($lines, qr{^skip gr-dos/fork16 unavailable a fork$}), 'a fork: unavailable');
  ok(has($lines, qr{^program gr-dos/oldfork16 }), 'an included fork is a program');
  ok(has($lines, qr{^skip gr-dos/arch16 unavailable archived$}), 'archived: unavailable');
  ok(has($lines, qr{^skip other/secret16 failed private$}), 'a private repository: failed');
  ok($o =~ m{^unavailable +gr-dos/none16: no release$}m && $o =~ m{^failed +other/secret16: private$}m,
    'the report says why each is left out');
}

# 4. Malformed releases, checksums and sizes.
{
  my $dir = github(config => $base_config, owners => { 'gr-dos' => [
    prog('badjson16', raw => '{ not json'),
    prog('noassets16', raw => { tag_name => 'v0.01' }),
    prog('noname16', raw => { tag_name => 'v0.01', assets => [ { size => 3 } ] }),
    prog('sum16', digest => { 'sum.exe' => 'sha256:' . ('0' x 64) }),
    prog('size16', size => { 'size.exe' => 999 }),
    prog('baddig16', digest => { 'baddig.exe' => 'md5:1234' }),
    prog('nodigest16', digest => { 'nodigest.exe' => undef }) ] });
  my($rc, $o) = dist16($dir, 'resolve');
  ok($rc == 2 && $o =~ m{badjson16/releases/latest: malformed JSON} && !-e "$dir/lock",
    'malformed JSON from GitHub stops resolve, writing nothing');
  unlink "$dir/api/repos/gr-dos/badjson16/releases/latest";
  ($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'resolve succeeds');
  ok(has($lines, qr{^skip gr-dos/noassets16 failed v0\.01: malformed release: no assets list$}), 'a release without assets: failed');
  ok(has($lines, qr{^skip gr-dos/noname16 failed v0\.01: malformed release: an asset without a name}), 'an asset without a name: failed');
  ok(has($lines, qr{^skip gr-dos/sum16 failed v0\.01: sum\.exe checksum mismatch: GitHub says 0{64}, downloaded [0-9a-f]{64}$}),
    'a checksum mismatch: failed');
  ok(has($lines, qr{^skip gr-dos/size16 failed v0\.01: size\.exe is 600 bytes, but GitHub says 999$}), 'a size mismatch: failed');
  ok(has($lines, qr{^skip gr-dos/baddig16 failed v0\.01: baddig\.exe has a malformed digest$}), 'a malformed digest: failed');
  ok(has($lines, qr{^program gr-dos/nodigest16 }), 'no digest from GitHub: the download\'s SHA-256 is pinned');

  # fetch refuses a download that is not what the lock pins.
  ($rc) = dist16($dir, 'fetch', "$dir/dest");
  ok($rc == 0, 'fetch succeeds');
  remove_tree("$dir/cache");
  spew("$dir/dl/gr-dos/nodigest16/releases/download/v0.01/nodigest.exe", mz(600, 'changed'));
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest");
  ok($rc == 2 && $o =~ /nodigest16 v0\.01 nodigest\.exe: checksum mismatch: dist16\/lock pins [0-9a-f]{64}/,
    'fetch: a changed release asset is a checksum mismatch');
  spew("$dir/lock", slurp("$dir/lock") . "program gr-dos/x16 v1\n");
  ($rc, $o) = dist16($dir, 'list');
  ok($rc == 2 && $o =~ /a program line has 10 fields/, 'a malformed lock is refused');
}

# 5. Asset names.
{
  my $dir = github(config => "$base_config" . "include gr-dos/pick16 asset=pick.com\ninclude gr-dos/nopick16 asset=other.exe\n",
    owners => { 'gr-dos' => [
    prog('zip16', assets => { 'zip16-1.0.zip' => 'PK', 'README' => 'r' }),
    prog('both16', assets => { 'both.exe' => mz(600, 'b'), 'both.com' => "\xC3" }),
    prog('two16', assets => { 'two.exe' => mz(600, 't'), 'other.exe' => mz(600, 'o') }),
    prog('ambi16', assets => { 'ambi.exe' => mz(600, 'a'), 'ambi16.exe' => mz(600, 'b') }),
    prog('full16', assets => { 'full16.exe' => mz(600, 'f') }),
    prog('pick16', assets => { 'pick.exe' => mz(600, 'p'), 'pick.com' => "\xC3" }),
    prog('nopick16'),
    prog('longname16', assets => { 'longname16.exe' => mz(600, 'l') }) ] });
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'resolve succeeds');
  ok(has($lines, qr{^skip gr-dos/zip16 unavailable v0\.01 has no program asset zip\.exe or zip\.com \(assets: README zip16-1\.0\.zip\)$}),
    'only unexpected assets: unavailable, listing them');
  ok(has($lines, qr{^program gr-dos/both16 v0\.01 \S+ both\.exe BOTH\.EXE }) && $o =~ /both\.exe as BOTH\.EXE, MIT, \.exe preferred \(the default\) \(ignored: both\.com\)/,
    'NAME.exe and NAME.com: the .exe, and the .com is reported ignored');
  ok(has($lines, qr{^program gr-dos/two16 v0\.01 \S+ two\.exe }), 'an asset with another name is ignored');
  ok(has($lines, qr{^skip gr-dos/ambi16 failed v0\.01 has more than one program \(ambi\.exe ambi16\.exe\): set asset=}),
    'STEM.exe and STEM16.exe: ambiguous, failed');
  ok(has($lines, qr{^program gr-dos/full16 v0\.01 \S+ full16\.exe FULL16\.EXE }), 'STEM16.exe is a program name too');
  ok(has($lines, qr{^program gr-dos/pick16 v0\.01 \S+ pick\.com PICK\.COM }), 'asset= chooses the .com');
  ok(has($lines, qr{^skip gr-dos/nopick16 failed v0\.01 has no asset other\.exe \(assets: nopick\.exe\)$}), 'asset= naming no asset: failed');
  ok(has($lines, qr{^skip gr-dos/longname16 failed v0\.01: longname16\.exe is not an 8\.3 \.COM or \.EXE name$}), 'a name longer than 8.3: failed');
}

# 5a. prefer= and prefer (issue #42): the .com, the fallback to the .exe,
# the global default and its per-repository override, and asset= with
# prefer= an error.
{
  my $both = sub ($name) { prog($name, assets => { "$name.exe" =~ s/16\././r => mz(600, $name), "$name.com" =~ s/16\././r => "\xC3" }) };
  my $owners = { 'gr-dos' => [ $both->('com16'), $both->('exe16'), $both->('dflt16'),
    prog('noc16'), prog('onlyc16', assets => { 'onlyc.com' => "\xC3" }) ] };
  my $dir = github(config => "$base_config" . "include gr-dos/com16 prefer=com\ninclude gr-dos/noc16 prefer=com\n", owners => $owners);
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'prefer=: resolve succeeds');
  ok(has($lines, qr{^program gr-dos/com16 v0\.01 \S+ com\.com COM\.COM 1 })
    && $o =~ m{gr-dos/com16 v0\.01 com\.com as COM\.COM, MIT, \.com preferred \(prefer=com\) \(ignored: com\.exe\)},
    'prefer=com ships the .com, and the report says why');
  ok(has($lines, qr{^program gr-dos/noc16 v0\.01 \S+ noc\.exe NOC\.EXE })
    && $o =~ m{gr-dos/noc16 v0\.01 noc\.exe as NOC\.EXE, MIT, no \.com, so the \.exe \(prefer=com\)},
    'prefer=com with no .com falls back to the .exe, and says so');
  ok(has($lines, qr{^program gr-dos/dflt16 v0\.01 \S+ dflt\.exe DFLT\.EXE }) && $o =~ /dflt\.exe as DFLT\.EXE, MIT, \.exe preferred \(the default\)/,
    'without prefer, the .exe');
  ok(has($lines, qr{^program gr-dos/onlyc16 v0\.01 \S+ onlyc\.com ONLYC\.COM }) && $o =~ /onlyc\.com as ONLYC\.COM, MIT\n/,
    'only a .com: shipped, with nothing to say about a preference');

  # The global prefer com, overridden by prefer=exe, and by asset=.
  $dir = github(config => "$base_config" . "prefer com\ninclude gr-dos/exe16 prefer=exe\ninclude gr-dos/com16 asset=com.exe\n", owners => $owners);
  ($rc, $o) = dist16($dir, 'resolve');
  $lines = lock_lines($dir);
  ok($rc == 0, 'prefer com: resolve succeeds');
  ok(has($lines, qr{^program gr-dos/dflt16 v0\.01 \S+ dflt\.com DFLT\.COM }) && $o =~ /dflt\.com as DFLT\.COM, MIT, \.com preferred \(prefer com\)/,
    'prefer com ships the .com of every repository');
  ok(has($lines, qr{^program gr-dos/noc16 v0\.01 \S+ noc\.exe NOC\.EXE }) && $o =~ /noc\.exe as NOC\.EXE, MIT, no \.com, so the \.exe \(prefer com\)/,
    'prefer com with no .com falls back to the .exe');
  ok(has($lines, qr{^program gr-dos/exe16 v0\.01 \S+ exe\.exe EXE\.EXE }) && $o =~ /exe\.exe as EXE\.EXE, MIT, \.exe preferred \(prefer=exe\)/,
    'prefer=exe overrides prefer com');
  ok(has($lines, qr{^program gr-dos/com16 v0\.01 \S+ com\.exe COM\.EXE }), 'asset= overrides prefer com');

  # Errors in the config.
  my %bad = (
    "include gr-dos/com16 asset=com.com prefer=com\n" => qr{gr-dos/com16 has both asset= and prefer=},
    "include gr-dos/com16 prefer=bin\n" => qr{prefer=bin: prefer= is com or exe},
    "prefer bin\n" => qr{prefer com\|exe},
    "prefer com\nprefer exe\n" => qr{prefer is set twice},
  );
  for my $cfg (sort keys %bad) {
    spew("$dir/config", $base_config . $cfg);
    ($rc, $o) = dist16($dir, 'list');
    ok($rc == 2 && $o =~ $bad{$cfg}, "a config error: @{[ $cfg =~ s/\n/; /gr ]}");
  }
}

# 6. Names: GR-DOS's own, and each other's.
{
  my $dir = github(config => "$base_config" . "include other/dup16\n", owners => {
    'gr-dos' => [ prog('more16', assets => { 'more.exe' => mz(600, 'm') }), prog('dup16'), prog('io16', assets => { 'io.com' => "\xC3" }) ],
    other => [ prog('dup16', assets => { 'dup.com' => "\xC3" }) ] });
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'resolve succeeds');
  ok(has($lines, qr{^skip gr-dos/more16 failed MORE\.EXE has the name of GR-DOS's MORE\.COM$}), 'MORE.EXE would shadow GR-DOS\'s MORE.COM: failed');
  ok(has($lines, qr{^skip gr-dos/io16 failed IO\.COM has the name of GR-DOS's IO\.SYS$}), 'any extension collides');
  ok(has($lines, qr{^skip gr-dos/dup16 failed DUP\.EXE has the name of other/dup16's program$})
    && has($lines, qr{^skip other/dup16 failed DUP\.COM has the name of gr-dos/dup16's program$}),
    'two programs with one name: both failed');
  # The lock is checked again when the build reads it.
  spew("$dir/lock", "program gr-dos/x16 v0.01 " . ('a' x 40) . " more.com MORE.COM 1 " . ('b' x 64) . " MIT LICENSE " . ('c' x 64) . "\n");
  ($rc, $o) = dist16($dir, 'list');
  ok($rc == 2 && $o =~ /MORE\.COM \(gr-dos\/x16\) has the name of GR-DOS's MORE\.COM/, 'list refuses a lock that collides');
}

# 7. Licenses.
{
  my $dir = github(config => $base_config, owners => { 'gr-dos' => [
    prog('nolic16', license => undef), prog('gpl16', license => 'GPL-3.0'), prog('other16', license => 'NOASSERTION') ] });
  my($rc) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok(has($lines, qr{^skip gr-dos/nolic16 failed v0\.01: no license$}), 'no license at the release\'s commit: failed');
  ok(has($lines, qr{^skip gr-dos/gpl16 failed v0\.01: license GPL-3\.0 is not one dist16/config allows$}), 'a license the config does not allow: failed');
  ok(has($lines, qr{^skip gr-dos/other16 failed v0\.01: license NOASSERTION is not one}), 'an unrecognized license: failed');
}

# 8. Architecture: real-mode DOS programs only.
{
  my $pe = mz(0x100, 'p');
  substr($pe, 0x18, 2) = pack 'v', 0x40;
  substr($pe, 0x3C, 4) = pack 'V', 0x80;
  substr($pe, 0x80, 4) = "PE\0\0";
  my $ne = $pe =~ s/PE\0\0/NE\0\0/r;
  my $coff = mz(512, 'c') . pack('v', 0x014C) . ('c' x 100);
  my $dos4g = mz(600, 'g') . 'DOS/4G';
  my $bad = mz(600, 'h');
  substr($bad, 4, 2) = pack 'v', 9;
  my $dir = github(config => $base_config, owners => { 'gr-dos' => [
    prog('pe16', assets => { 'pe.exe' => $pe }), prog('ne16', assets => { 'ne.exe' => $ne }),
    prog('coff16', assets => { 'coff.exe' => $coff }), prog('dosx16', assets => { 'dosx.exe' => $dos4g }),
    prog('nomz16', assets => { 'nomz.exe' => 'not a program' }), prog('hdr16', assets => { 'hdr.exe' => $bad }),
    prog('bigcom16', assets => { 'bigcom.com' => "\x90" x 0xFF01 }), prog('com16', assets => { 'com.com' => "\x90" x 0xFF00 }) ] });
  my($rc) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok(has($lines, qr{^skip gr-dos/pe16 failed v0\.01: pe\.exe is a PE program, not a real-mode DOS one$}), 'a PE program: failed');
  ok(has($lines, qr{^skip gr-dos/ne16 failed v0\.01: ne\.exe is a NE program}), 'an NE program: failed');
  ok(has($lines, qr{^skip gr-dos/coff16 failed v0\.01: coff\.exe is a 32-bit \(COFF\) program behind a DOS stub$}), 'a 32-bit COFF program behind a stub: failed');
  ok(has($lines, qr{^skip gr-dos/dosx16 failed v0\.01: dosx\.exe needs a 32-bit DOS extender \(DOS/4G\)$}), 'a DOS extender program: failed');
  ok(has($lines, qr{^skip gr-dos/nomz16 failed v0\.01: nomz\.exe has no MZ header$}), 'an .exe with no MZ header: failed');
  ok(has($lines, qr{^skip gr-dos/hdr16 failed v0\.01: hdr\.exe has a malformed MZ header$}), 'a malformed MZ header: failed');
  ok(has($lines, qr{^skip gr-dos/bigcom16 failed v0\.01: bigcom\.com is 65281 bytes, too big for a \.COM$}), 'a .COM over 65,280 bytes: failed');
  ok(has($lines, qr{^program gr-dos/com16 v0\.01 \S+ com\.com COM\.COM 65280 }), 'a .COM of 65,280 bytes is a program');
}

# 9. GitHub refusing or failing stops resolve, and leaves the lock as it was.
{
  my $dir = github(config => $base_config, owners => { 'gr-dos' => [ prog('a16') ] });
  my($rc) = dist16($dir, 'resolve');
  my $lock = slurp("$dir/lock");
  spew("$dir/api/users/gr-dos/repos\@per_page=100&page=1.status", "403\n");
  my $o;
  ($rc, $o) = dist16($dir, 'resolve');
  ok($rc == 2 && $o =~ /HTTP 403: rate limited or forbidden/, 'a rate limit (403) stops resolve');
  ok(slurp("$dir/lock") eq $lock, 'and the lock is unchanged');
  unlink "$dir/api/users/gr-dos/repos\@per_page=100&page=1.status";
  spew("$dir/api/repos/gr-dos/a16/releases/latest.status", "500\n");
  ($rc, $o) = dist16($dir, 'resolve');
  ok($rc == 2 && $o =~ m{releases/latest: HTTP 500}, 'a server error on one release stops resolve too');
  ok(slurp("$dir/lock") eq $lock, 'and the lock is unchanged');
  ($rc, $o) = dist16($dir, '--api', 'file:///nonexistent/api', 'resolve');
  ok($rc == 2 && $o =~ /no user or organization gr-dos/, 'an owner GitHub does not have stops resolve');

  # A required repository that cannot be included stops resolve.
  spew("$dir/config", "$base_config" . "include gr-dos/a16 required\n");
  unlink "$dir/api/repos/gr-dos/a16/releases/latest.status";
  unlink "$dir/api/repos/gr-dos/a16/releases/latest";
  ($rc, $o) = dist16($dir, 'resolve');
  ok($rc == 2 && $o =~ m{gr-dos/a16 is required \(dist16/config\), but unavailable: no release}, 'a required repository with no release stops resolve');
  ok(slurp("$dir/lock") eq $lock, 'and the lock is unchanged');
}

# 10. Programs under a source license (issue #56): GPL-2.0-or-later and
# GPL-1.0-or-later, with their corresponding source and that of the
# library linked into them.
{
  my $libc = { name => 'libc16', releases => [ { tag => 'v0.07', latest => 1, license => 'MIT',
    assets => { 'libc16-0.07.zip' => 'PK', 'libc16-0.07-src.zip' => zip('libc16-0.07/LICENSE' => license_text('gr-dos/libc16', 'MIT'),
      'libc16-0.07/src/stdio.c' => "int printf;\n") } } ] };
  my $manifest = sub ($stem, %o) {
    join '', map { "$_\n" } grep { defined } "license @{[ $o{license} // 'GPL-2.0-or-later' ]}",
      "source @{[ $o{source} // \"$stem-0.01-src.tar.gz\" ]}", $o{nobuild} ? undef : 'build BUILDING.md',
      'notice AUTHORS', "depends @{[ $o{depends} // 'gr-dos/libc16 v0.07 libc16-0.07-src.zip' ]}", $o{extra};
  };
  my $gpl = sub ($name, %o) {
    my $stem = $name =~ s/16$//r;
    my $m = $o{manifest} // $manifest->($stem, %o);
    my $top = "$stem-0.01/";
    my %src = ("${top}dist16.source" => $m, "${top}COPYING" => license_text("gr-dos/$name", $o{github} // 'GPL-2.0'),
      "${top}AUTHORS" => "authors of $name\n", "${top}BUILDING.md" => "make\n", "${top}src/main.c" => "int main;\n",
      ($o{src} // {})->%*);
    delete @src{ map { "$top$_" } ($o{drop} // [])->@* };
    my %files = ('dist16.source' => $m, AUTHORS => "authors of $name\n");
    delete @files{ ($o{nofile} // [])->@* };
    my %assets = ("$stem.exe" => $o{exe} // mz(600, $name), "$stem-0.01-src.tar.gz" => tgz(%src), ($o{assets} // {})->%*);
    delete @assets{ ($o{noasset} // [])->@* };
    return { name => $name, releases => [ { tag => 'v0.01', latest => 1, license => $o{github} // 'GPL-2.0',
      license_path => 'COPYING', files => \%files, assets => \%assets, ($o{rel} // {})->%* } ] };
  };
  my $dir = github(config => $base_config . "source-license GPL-2.0-or-later GPL-1.0-or-later\n", owners => { 'gr-dos' => [
    $libc, prog('md5sum16'), $gpl->('gpl16'),
    $gpl->('nomani16', nofile => ['dist16.source']),
    $gpl->('mitsays16', license => 'MIT'),
    $gpl->('only16', license => 'GPL-2.0-only'),
    $gpl->('gpl3x16', github => 'GPL-3.0'),
    # The GPL version 1 or later (perl16's Perl 3), and its failures.
    $gpl->('perl16', github => 'GPL-1.0', license => 'GPL-1.0-or-later'),
    $gpl->('v1only16', github => 'GPL-1.0', license => 'GPL-1.0-only'),
    $gpl->('v1says216', github => 'GPL-1.0', license => 'GPL-2.0-or-later'),
    $gpl->('v2says116', license => 'GPL-1.0-or-later'),
    $gpl->('v1nomani16', github => 'GPL-1.0', license => 'GPL-1.0-or-later', nofile => ['dist16.source']),
    $gpl->('v1copy16', github => 'GPL-1.0', license => 'GPL-1.0-or-later',
      src => { 'v1copy-0.01/COPYING' => license_text('gr-dos/v1copy16', 'GPL-2.0') }),
    $gpl->('v1dep16', github => 'GPL-1.0', license => 'GPL-1.0-or-later', depends => 'gr-dos/libc16 v0.07 libc16-0.07.zip'),
    $gpl->('nosrc16', noasset => ['nosrc-0.01-src.tar.gz']),
    $gpl->('other16', src => { 'other-0.01/COPYING' => "another license\n" }),
    $gpl->('nobuild16', drop => ['BUILDING.md']),
    $gpl->('stale16', src => { 'stale-0.01/dist16.source' => "license GPL-2.0-or-later\n" }),
    $gpl->('badman16', extra => 'frobnicate'),
    $gpl->('nobld16', nobuild => 1),
    $gpl->('watcom16', exe => mz(600, 'w') . 'Open Watcom C/C++16 Run Time system'),
    $gpl->('nodep16', depends => 'gr-dos/libc16 v9.99 libc16-9.99-src.zip'),
    $gpl->('binlib16', depends => 'gr-dos/libc16 v0.07 libc16-0.07.zip'),
    $gpl->('xz16', source => 'xz-0.01-src.tar.xz', assets => { 'xz-0.01-src.tar.xz' => 'xz' }),
    $gpl->('noauth16', nofile => ['AUTHORS']),
    $gpl->('sum16', rel => { digest => { 'sum-0.01-src.tar.gz' => 'sha256:' . ('0' x 64) } }),
    $gpl->('self16', source => 'self.exe'),
    prog('sources16') ] });
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'source licenses: resolve succeeds');
  ok(has($lines, qr{^program gr-dos/gpl16 v0\.01 [0-9a-f]{40} gpl\.exe GPL\.EXE 600 [0-9a-f]{64} GPL-2\.0-or-later COPYING [0-9a-f]{64}$}),
    'a GPL program is locked with the exact license its dist16.source gives, and COPYING');
  my($i) = grep { $lines->[$_] =~ m{^program gr-dos/gpl16 } } 0 .. $#$lines;
  ok(defined $i && $lines->[$i + 1] =~ m{^source gr-dos/gpl16 gpl-0\.01-src\.tar\.gz \d+ [0-9a-f]{64} BUILDING\.md$}
    && $lines->[$i + 2] =~ m{^notice gr-dos/gpl16 AUTHORS [0-9a-f]{64}$}
    && $lines->[$i + 3] =~ m{^depend gr-dos/gpl16 gr-dos/libc16 v0\.07 [0-9a-f]{40} libc16-0\.07-src\.zip \d+ [0-9a-f]{64} MIT LICENSE [0-9a-f]{64}$},
    'its source, notice and linked library\'s source are locked after it');
  ok(scalar $o =~ m{^included +gr-dos/gpl16 v0\.01 gpl\.exe as GPL\.EXE, GPL-2\.0-or-later, source gpl-0\.01-src\.tar\.gz, with gr-dos/libc16 v0\.07 \(MIT, source libc16-0\.07-src\.zip\)$}m,
    'the report gives the license, the source and the library');
  ok(has($lines, qr{^program gr-dos/md5sum16 .* MIT LICENSE }) && !has($lines, qr{^(source|notice|depend) gr-dos/md5sum16 }),
    'an MIT program beside it is locked as before, with no source lines');
  # GPL-1.0-or-later: GitHub's GPL-1.0 with the manifest's exact license,
  # and the original GPL version 1 text kept.
  my $v1 = license_text('gr-dos/perl16', 'GPL-1.0');
  ok(has($lines, qr{^program gr-dos/perl16 v0\.01 [0-9a-f]{40} perl\.exe PERL\.EXE 600 [0-9a-f]{64} GPL-1\.0-or-later COPYING \Q@{[ sha256_hex($v1) ]}\E$}),
    'a GPL-1.0-or-later program is locked with its exact license and the GPL version 1 text\'s SHA-256');
  ok(has($lines, qr{^source gr-dos/perl16 perl-0\.01-src\.tar\.gz }) && has($lines, qr{^depend gr-dos/perl16 gr-dos/libc16 v0\.07 }),
    'with its source and its linked library\'s, under the same contract');
  my %why = (
    nomani16 => q{license GPL-2.0 needs the program's source, but there is no dist16.source at its commit},
    mitsays16 => 'GitHub finds GPL-2.0 in COPYING, but dist16.source says MIT',
    only16 => 'license GPL-2.0-only (dist16.source) is not one dist16/config allows',
    gpl3x16 => 'license GPL-3.0 is not one dist16/config allows',
    nosrc16 => 'dist16.source names the source nosrc-0.01-src.tar.gz, which the release does not have',
    other16 => q{the source other-0.01-src.tar.gz has no COPYING, or another one than the commit's},
    nobuild16 => 'the source nobuild-0.01-src.tar.gz has no BUILDING.md (the build instructions dist16.source names)',
    stale16 => q{the source stale-0.01-src.tar.gz has another dist16.source than the commit's},
    badman16 => 'dist16.source: line 6: unknown directive frobnicate',
    nobld16 => 'dist16.source: no build line',
    watcom16 => q{watcom.exe contains Open Watcom's C runtime, which dist16.source does not cover},
    nodep16 => 'depends gr-dos/libc16 v9.99: no release v9.99',
    binlib16 => 'depends gr-dos/libc16 v0.07: libc16-0.07.zip is not a zip archive',
    xz16 => 'xz-0.01-src.tar.xz is not a .zip, .tar.gz or .tgz archive',
    noauth16 => 'the notice AUTHORS (dist16.source) is not at the commit',
    sum16 => 'sum-0.01-src.tar.gz checksum mismatch: GitHub says ' . ('0' x 64),
    self16 => 'dist16.source names the program as its source',
    v1only16 => 'license GPL-1.0-only (dist16.source) is not one dist16/config allows',
    v1says216 => 'GitHub finds GPL-1.0 in COPYING, but dist16.source says GPL-2.0-or-later',
    v2says116 => 'GitHub finds GPL-2.0 in COPYING, but dist16.source says GPL-1.0-or-later',
    v1nomani16 => q{license GPL-1.0 needs the program's source, but there is no dist16.source at its commit},
    v1copy16 => q{the source v1copy-0.01-src.tar.gz has no COPYING, or another one than the commit's},
    v1dep16 => 'depends gr-dos/libc16 v0.07: libc16-0.07.zip is not a zip archive',
  );
  for my $name (sort keys %why) {
    ok(has($lines, qr{^skip gr-dos/$name failed v0\.01: \Q$why{$name}\E}), "a GPL program fails: $why{$name}")
      or diag(grep { m{gr-dos/$name } } @$lines);
  }
  ok(has($lines, qr{^skip gr-dos/libc16 excluded \Q$LIBRARY\E$}) && !has($lines, qr{^program gr-dos/libc16 }),
    'libc16 is excluded as a program, while gpl16 and perl16 depend on its source');
  ok(slurp("$dir/lock") =~ m{^skip gr-dos/libc16 }m, 'and its skip line is in the lock');
  ok(has($lines, qr{^skip gr-dos/sources16 failed SOURCES\.EXE has the name of GR-DOS's SOURCES\.TXT}),
    'no program may be named SOURCES, the source description\'s name');
  my $first = slurp("$dir/lock");
  dist16($dir, 'resolve');
  ok(slurp("$dir/lock") eq $first, 'source licenses: resolving again writes the same lock');

  # fetch stages the source, and SOURCES.TXT with the licenses.
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest");
  my $src_asset = slurp("$dir/dl/gr-dos/gpl16/releases/download/v0.01/gpl-0.01-src.tar.gz");
  ok($rc == 0 && slurp("$dir/dest/GPL.EXE") eq mz(600, 'gpl16'), 'fetch stages the GPL program');
  ok(slurp("$dir/dest/source/GPL/gpl-0.01-src.tar.gz") eq $src_asset
    && slurp("$dir/dest/source/GPL/libc16-0.07-src.zip") eq slurp("$dir/dl/gr-dos/libc16/releases/download/v0.07/libc16-0.07-src.zip"),
    'and its source and the library\'s, in source/GPL');
  ok(!-e "$dir/dest/source/MD5SUM", 'and no source for the MIT program');
  my $sources = slurp("$dir/dest/SOURCES.TXT") // '';
  my $sha = sha256_hex($src_asset);
  ok($sources =~ /\r\n/ && $sources !~ /[^\r]\n/, 'SOURCES.TXT has DOS line ends');
  ok($sources =~ m{^GPL\.EXE: gr-dos/gpl16 v0\.01, GPL-2\.0-or-later\r$}m && index($sources, $sha) >= 0
    && index($sources, 'https://github.com/gr-dos/gpl16/releases/download/v0.01/gpl-0.01-src.tar.gz') >= 0
    && index($sources, 'in the ZIP: SOURCE\GPL\gpl-0.01-src.tar.gz') >= 0
    && index($sources, 'https://github.com/gr-dos/libc16/releases/download/v0.07/libc16-0.07-src.zip') >= 0,
    'SOURCES.TXT names the exact source and library source, by URL and SHA-256, and where they are in the ZIP');
  ok(index($sources, "GPL-2.0 license of gr-dos/gpl16") >= 0 && index($sources, "authors of gpl16") >= 0
    && index($sources, "MIT license of gr-dos/libc16") >= 0 && index($sources, 'MIT license of gr-dos/md5sum16') < 0,
    'SOURCES.TXT has the GPL text, the notice and the library\'s license, and not the MIT program\'s');
  ok(index($sources =~ s/\r//gr, $v1) >= 0 && $sources =~ m{^PERL\.EXE: gr-dos/perl16 v0\.01, GPL-1\.0-or-later\r$}m
    && slurp("$dir/dest/licenses/PERL.EXE.txt") eq $v1,
    'the GPL-1.0-or-later program keeps the original GPL version 1 text, not version 2\'s');
  my($lrc, $list) = dist16($dir, 'list');
  ok($lrc == 0 && $list eq "GPL.EXE\nMD5SUM.EXE\nPERL.EXE\nSOURCES.TXT\n", 'list: SOURCES.TXT after the programs');
  my(undef, $bin) = dist16($dir, 'bin-list');
  ok($bin =~ m{^  BIN\\GPL\.EXE +from gr-dos/gpl16 v0\.01, GPL-2\.0-or-later$}m
    && $bin =~ m{^  BIN\\SOURCES\.TXT  where to get the source of GPL\.EXE, PERL\.EXE$}m, 'bin-list: each license, and SOURCES.TXT');
  my(undef, $notices) = dist16($dir, 'notices', "$dir/dest");
  ok($notices =~ /^GPL\.EXE: gr-dos\/gpl16 v0\.01 \(commit [0-9a-f]{40}\), GPL-2\.0-or-later$/m
    && $notices =~ /^GPL\.EXE: AUTHORS$/m && $notices =~ /^GPL\.EXE: linked with gr-dos\/libc16 v0\.07 \(commit [0-9a-f]{40}\), MIT$/m
    && index($notices, 'MIT license of gr-dos/libc16') >= 0, 'notices: the GPL text, the notice and the library\'s license');
  my(undef, $readme) = dist16($dir, 'sources');
  ok($readme =~ /^Corresponding source$/m && $readme =~ /aggregation of separately licensed programs/, 'sources: README.txt\'s section');

  # check-dist: a ZIP tree and a CF install, then each thing missing.
  my $zip = "$dir/zip";
  my $pack = sub {
    remove_tree($zip);
    make_path("$zip/BIN");
    system('cp', "$dir/dest/$_", "$zip/BIN/") for 'GPL.EXE', 'MD5SUM.EXE', 'PERL.EXE', 'SOURCES.TXT';
    system('cp', '-R', "$dir/dest/source", "$zip/SOURCE");
    spew("$zip/README.txt", ("GR-DOS\n$readme$notices") =~ s/\n/\r\n/gr);
  };
  $pack->();
  ($rc, $o) = dist16($dir, 'check-dist', $zip, "$dir/dest");
  ok($rc == 0 && $o =~ /GPL\.EXE \(GPL-2\.0-or-later\), PERL\.EXE \(GPL-1\.0-or-later\) with source and licenses/, 'check-dist: the ZIP has the source and licenses');
  spew("$zip/README.txt", slurp("$zip/README.txt") =~ s/GPL-2\.0 license of gr-dos\/gpl16//r);
  ($rc, $o) = dist16($dir, 'check-dist', $zip, "$dir/dest");
  ok($rc == 2 && $o =~ /a license text of GPL\.EXE is not in full/, 'check-dist: README.txt without the GPL text fails');
  $pack->();
  unlink "$zip/SOURCE/GPL/libc16-0.07-src.zip";
  ($rc, $o) = dist16($dir, 'check-dist', $zip, "$dir/dest");
  ok($rc == 2 && $o =~ m{SOURCE/GPL/libc16-0\.07-src\.zip is not the source dist16/lock pins}, 'check-dist: a missing library source fails');
  $pack->();
  spew("$zip/SOURCE/GPL/extra.tar.gz", 'x');
  ($rc, $o) = dist16($dir, 'check-dist', $zip, "$dir/dest");
  ok($rc == 2 && $o =~ /extra\.tar\.gz is not a source dist16\/lock pins/, 'check-dist: an unpinned file in SOURCE fails');
  $pack->();
  unlink "$zip/BIN/SOURCES.TXT";
  ($rc, $o) = dist16($dir, 'check-dist', $zip, "$dir/dest");
  ok($rc == 2 && $o =~ /SOURCES\.TXT is missing/, 'check-dist: a missing SOURCES.TXT fails');
  my $cf = "$dir/cf";
  make_path($cf);
  spew("$cf/manifest.txt", '');
  system('cp', "$dir/dest/$_", "$cf/") for 'GPL.EXE', 'PERL.EXE', 'SOURCES.TXT';
  ($rc, $o) = dist16($dir, 'check-dist', $cf, "$dir/dest");
  ok($rc == 0, 'check-dist: a CF install has SOURCES.TXT, with the licenses');

  # The lock is checked: a GPL program without its source is refused.
  my $lock = slurp("$dir/lock");
  spew("$dir/lock", $lock =~ s/^source gr-dos\/gpl16 .*\n(notice .*\n|depend .*\n)*//mr);
  ($rc, $o) = dist16($dir, 'list');
  ok($rc == 2 && $o =~ /GPL\.EXE \(gr-dos\/gpl16\) is under GPL-2\.0-or-later, which needs a source line/, 'a lock with a GPL program but no source is refused');
  spew("$dir/lock", $lock =~ s/GPL-2\.0-or-later COPYING/MIT COPYING/r);
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest");
  ok($rc == 2 && $o =~ /has a source line, but MIT is not a source-license/, 'a source line under a permissive license is refused');
  spew("$dir/lock", $lock =~ s/^(source gr-dos\/gpl16 .*\n)(notice .*\n)/$2$1/mr);
  ($rc, $o) = dist16($dir, 'list');
  ok($rc == 2 && $o =~ /a notice line out of place/, 'a notice before the source line is refused');
  spew("$dir/lock", $lock);

  # Offline from the cache, and a corrupt source archive refused.
  remove_tree("$dir/dl", "$dir/raw");
  ($rc) = dist16($dir, 'fetch', "$dir/dest2");
  ok($rc == 0 && slurp("$dir/dest2/SOURCES.TXT") eq $sources, 'offline, fetch reproduces the source and SOURCES.TXT');
  spew("$dir/cache/gr-dos/gpl16/v0.01/gpl-0.01-src.tar.gz", 'tampered');
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest3");
  ok($rc == 2 && $o =~ /gpl16 v0\.01 gpl-0\.01-src\.tar\.gz: cannot download .*no verified copy/, 'offline, a corrupt cached source is refused');

  # A config with a source license that is not a versioned one, or is
  # also a license, is an error.
  spew("$dir/config", $base_config . "source-license GPL-2.0\n");
  ($rc, $o) = dist16($dir, 'list');
  ok($rc == 2 && $o =~ /GPL-2\.0 is not a license with a version/, 'source-license needs -only or -or-later');
  spew("$dir/config", $base_config . "license GPL-2.0\nsource-license GPL-2.0-or-later\n");
  ($rc, $o) = dist16($dir, 'list');
  ok($rc == 2 && $o =~ /GPL-2\.0-or-later is both a license and a source-license/, 'a license may not be both');
}

# 11. The lib*16 convention (issue #61): libraries are excluded without an
# exclude, in any case; other *16 repositories are programs; an include
# makes a library a program; an explicit exclude keeps its own reason;
# and a GPL program's depends on an excluded library still ships its
# source.
{
  my $lib = sub ($name) { { name => $name, releases => [ { tag => 'v0.01', latest => 1, license => 'MIT',
    assets => { "$name-0.01.zip" => 'PK', 'lib.exe' => mz(600, $name) } } ] } };
  my $libc = { name => 'libc16', releases => [ { tag => 'v0.07', latest => 1, license => 'MIT',
    assets => { 'libc16-0.07.zip' => 'PK', 'libc16-0.07-src.zip' => zip('libc16-0.07/LICENSE' => license_text('gr-dos/libc16', 'MIT')) } } ] };
  my $m = "license GPL-2.0-or-later\nsource patch-0.01-src.tar.gz\nbuild BUILDING.md\ndepends gr-dos/libc16 v0.07 libc16-0.07-src.zip\n";
  my $patch = { name => 'patch16', releases => [ { tag => 'v0.01', latest => 1, license => 'GPL-2.0', license_path => 'COPYING',
    files => { 'dist16.source' => $m },
    assets => { 'patch.exe' => mz(600, 'patch16'), 'patch-0.01-src.tar.gz' => tgz('patch-0.01/dist16.source' => $m,
      'patch-0.01/COPYING' => license_text('gr-dos/patch16', 'GPL-2.0'), 'patch-0.01/BUILDING.md' => "make\n") } } ] };
  my $config = "discover gr-dos 16\nexclude gr-dos/hello16 the template\nlicense MIT\nsource-license GPL-2.0-or-later\n";
  my $owners = { 'gr-dos' => [ $libc, $lib->('libkitchen16'), $lib->('libfoo16'), $lib->('LibMixed16'), $lib->('LIBUPPER16'),
    prog('diff16'), $patch, prog('perl16'), prog('hello16'), prog('glib16'), prog('library') ],
    other => [ { name => 'libother16', releases => [ { tag => 'v0.01', latest => 1, license => 'MIT',
      assets => { 'libother16-0.01.zip' => 'PK', 'libother.exe' => mz(600, 'libother16') } } ] } ] };
  my $dir = github(config => $config, owners => $owners);
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'lib*16: resolve succeeds');
  for my $name (qw( libc16 libkitchen16 libfoo16 LibMixed16 LIBUPPER16 )) {
    ok(has($lines, qr{^skip gr-dos/$name excluded \Q$LIBRARY\E$}) && $o =~ m{^excluded +gr-dos/$name: \Q$LIBRARY\E$}m,
      "gr-dos/$name is excluded as a library, reported and locked, with no exclude");
  }
  ok(!has($lines, qr{^program gr-dos/lib}i), 'no library is a program');
  ok(has($lines, qr{^program gr-dos/diff16 }) && has($lines, qr{^program gr-dos/perl16 }) && has($lines, qr{^program gr-dos/glib16 }),
    'other *16 repositories are programs, glib16 among them (lib* is the whole name)');
  ok(has($lines, qr{^program gr-dos/patch16 v0\.01 \S+ patch\.exe PATCH\.EXE \d+ \S+ GPL-2\.0-or-later COPYING })
    && has($lines, qr{^depend gr-dos/patch16 gr-dos/libc16 v0\.07 [0-9a-f]{40} libc16-0\.07-src\.zip \d+ [0-9a-f]{64} MIT LICENSE }),
    'patch16\'s depends on the excluded libc16 still resolves libc16\'s source');
  ok(has($lines, qr{^skip gr-dos/hello16 excluded the template$}), 'hello16 keeps its explicit exclusion');
  ok(!has($lines, qr{library$}) && !has($lines, qr{libother16}), 'only repositories that end in 16, of the discovered owner');
  ok($o !~ /matches no discovered repository/, 'no stale exclude note');
  my $first = slurp("$dir/lock");
  my(undef, $o2) = dist16($dir, 'resolve');
  ok(slurp("$dir/lock") eq $first && $o2 eq $o, 'lib*16: resolve output and lock are deterministic');
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest");
  ok($rc == 0 && -f "$dir/dest/source/PATCH/libc16-0.07-src.zip" && !-e "$dir/dest/LIB.EXE",
    'fetch ships libc16\'s source with PATCH.EXE, and no library program');

  # An explicit include is the exception: the library is a program.
  $dir = github(config => "$config" . "include gr-dos/libfoo16 asset=lib.exe\ninclude other/libother16\n", owners => $owners);
  ($rc, $o) = dist16($dir, 'resolve');
  $lines = lock_lines($dir);
  ok($rc == 0 && has($lines, qr{^program gr-dos/libfoo16 v0\.01 \S+ lib\.exe LIB\.EXE }), 'an include ships a lib*16 repository as a program');
  ok(has($lines, qr{^program other/libother16 v0\.01 \S+ libother\.exe LIBOTHER\.EXE }),
    'an include of another owner\'s lib*16 is a candidate program too');
  ok(has($lines, qr{^skip gr-dos/libkitchen16 excluded \Q$LIBRARY\E$}), 'the other libraries are still excluded');

  # An explicit exclude gives its reason; with an include, it is an error.
  $dir = github(config => "$config" . "exclude gr-dos/libc16 the C runtime\n", owners => $owners);
  ($rc, $o) = dist16($dir, 'resolve');
  ok($rc == 0 && has(lock_lines($dir), qr{^skip gr-dos/libc16 excluded the C runtime$}), 'an explicit exclude of a library keeps its reason');
  $dir = github(config => "$config" . "exclude gr-dos/libc16 the C runtime\ninclude gr-dos/libc16\n", owners => $owners);
  ($rc, $o) = dist16($dir, 'resolve');
  ok($rc == 2 && $o =~ /both included and excluded/, 'a library both included and excluded is still an error');
}

# 12. A license-override (issue #83): a license GitHub's detector does not
# recognize (NOASSERTION), taken for one repository only when its file at
# the release's commit has the SHA-256 the config pins; otherwise failed,
# as without it.
{
  my $tcl_text = license_text('gr-dos/tcl16', 'NOASSERTION');
  my $tcl_sha = sha256_hex($tcl_text);
  my $tiny = "Tiny Tcl: copyrighted by the Regents of the University of California\n";
  my $tcl = sub ($name, %r) { prog($name, license => 'NOASSERTION', files => { 'vendor/LICENSE.tinytcl' => $tiny }, %r) };
  my $owners = { 'gr-dos' => [ $tcl->('tcl16'), prog('plain16', license => 'NOASSERTION'), prog('mit16'),
    $tcl->('changed16'), $tcl->('path16', license_path => 'COPYING'), $tcl->('gone16'), $tcl->('nonotice16', files => {}),
    prog('known16', license => 'TCL') ] };
  my $ov = sub ($repo, %o) { "license-override $repo TCL @{[ $o{path} // 'LICENSE' ]} sha256=@{[ $o{sha} // sha256_hex(license_text($repo, 'NOASSERTION')) ]}"
    . ($o{nonotice} ? '' : ' notice=vendor/LICENSE.tinytcl') . "\n" };
  my $config = "discover gr-dos 16\nlicense MIT TCL\n" . $ov->('gr-dos/tcl16') . $ov->('gr-dos/mit16', nonotice => 1)
    . $ov->('gr-dos/changed16', sha => 'f' x 64) . $ov->('gr-dos/path16') . $ov->('gr-dos/gone16') . $ov->('gr-dos/nonotice16')
    . $ov->('gr-dos/known16', nonotice => 1)
    . $ov->('other/nowhere16');
  my $dir = github(config => $config, owners => $owners);
  unlink "$dir/raw/gr-dos/gone16/" . substr(sha256_hex('gr-dos/gone16 v0.01'), 0, 40) . '/LICENSE';
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'license-override: resolve succeeds');
  my($i) = grep { $lines->[$_] =~ m{^program gr-dos/tcl16 } } 0 .. $#$lines;
  ok(defined $i && $lines->[$i] =~ m{^program gr-dos/tcl16 v0\.01 ([0-9a-f]{40}) tcl\.exe TCL\.EXE 600 [0-9a-f]{64} TCL LICENSE \Q$tcl_sha\E$}
    && $lines->[$i + 1] eq "override gr-dos/tcl16 NOASSERTION TCL LICENSE $tcl_sha"
    && $lines->[$i + 2] eq 'notice gr-dos/tcl16 vendor/LICENSE.tinytcl ' . sha256_hex($tiny),
    'a verified override: the program is under TCL, with an override line and its notice');
  ok($o =~ m{^included +gr-dos/tcl16 v0\.01 tcl\.exe as TCL\.EXE, TCL by license-override \(GitHub finds NOASSERTION; LICENSE SHA-256 verified, notice vendor/LICENSE\.tinytcl\)$}m,
    'the report says the license is the override\'s, not GitHub\'s');
  ok(has($lines, qr{^skip gr-dos/plain16 failed v0\.01: license NOASSERTION is not one dist16/config allows$}),
    'NOASSERTION with no override still fails');
  ok(has($lines, qr{^skip gr-dos/changed16 failed v0\.01: LICENSE at [0-9a-f]{40} has SHA-256 [0-9a-f]{64}, but the license-override TCL \(\S+:\d+\) pins f{64}$}),
    'a license file with another SHA-256 fails');
  ok(has($lines, qr{^skip gr-dos/path16 failed v0\.01: GitHub finds an unrecognized license in COPYING, but the license-override TCL \(\S+\) names LICENSE$}),
    'a license in another file than the override names fails');
  ok(has($lines, qr{^skip gr-dos/gone16 failed v0\.01: license file LICENSE is missing, for the license-override TCL}),
    'a license file missing at the commit fails');
  ok(has($lines, qr{^skip gr-dos/nonotice16 failed v0\.01: the notice vendor/LICENSE\.tinytcl \(license-override TCL \(\S+\)\) is not at the commit$}),
    'a notice the override names, missing at the commit, fails');
  ok(has($lines, qr{^program gr-dos/mit16 v0\.01 \S+ mit\.exe MIT\.EXE \d+ \S+ MIT LICENSE }) && !has($lines, qr{^override gr-dos/mit16 })
    && $o =~ m{gr-dos/mit16 v0\.01: the license-override \(\S+\) is not used: GitHub finds MIT},
    'a license GitHub recognizes is not overridden, and the unused override is reported');
  ok($o =~ m{license-override other/nowhere16 matches no repository}, 'an override of no repository is reported');
  ok(has($lines, qr{^skip gr-dos/known16 failed v0\.01: GitHub finds TCL itself, so the license-override \(\S+\) is not needed: remove it$}),
    'GitHub recognizing the override\'s own license fails, so the override is removed, not kept unrecorded');
  my $first = slurp("$dir/lock");
  dist16($dir, 'resolve');
  ok(slurp("$dir/lock") eq $first, 'license-override: resolving again writes the same lock');

  # fetch, list and notices: the license and its notice are shipped.
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest");
  ok($rc == 0 && slurp("$dir/dest/licenses/TCL.EXE.txt") eq $tcl_text && slurp("$dir/dest/licenses/TCL.EXE.notice1.txt") eq $tiny,
    'fetch stages the overridden license and its notice');
  ok(!-e "$dir/dest/SOURCES.TXT" && !-e "$dir/dest/source", 'and, a permissive license, no source');
  my(undef, $notices) = dist16($dir, 'notices', "$dir/dest");
  ok($notices =~ m{^TCL\.EXE: gr-dos/tcl16 v0\.01 \(commit [0-9a-f]{40}\), TCL$}m && index($notices, $tcl_text) >= 0
    && $notices =~ m{^TCL\.EXE: vendor/LICENSE\.tinytcl$}m && index($notices, $tiny) >= 0, 'notices: the license and the notice in full');
  my(undef, $bin) = dist16($dir, 'bin-list');
  ok($bin =~ m{^  BIN\\TCL\.EXE +from gr-dos/tcl16 v0\.01, TCL$}m, 'bin-list: TCL');
  remove_tree("$dir/dl", "$dir/raw");
  ($rc) = dist16($dir, 'fetch', "$dir/dest2");
  ok($rc == 0 && slurp("$dir/dest2/licenses/TCL.EXE.notice1.txt") eq $tiny, 'offline, fetch reproduces them from the cache');

  # The lock is checked against the config's override.
  my $lock = slurp("$dir/lock");
  my %bad = (
    'an override line the config does not have' =>
      [ $lock, $config =~ s/^license-override gr-dos\/tcl16 .*\n//mr, qr{TCL\.EXE \(gr-dos/tcl16\) has a license-override that \S+ does not have} ],
    'another SHA-256 than the config pins' =>
      [ $lock, $config =~ s/(license-override gr-dos\/tcl16 TCL LICENSE sha256=)\S+/$1 . ('e' x 64)/er, qr{has another license-override than} ],
    'another notice than the config names' =>
      [ $lock, $config =~ s/(license-override gr-dos\/tcl16 .*) notice=\S+/$1/r, qr{has another license-override than} ],
    'an override line that is not the program\'s license' =>
      [ $lock =~ s/^(override gr-dos\/tcl16 NOASSERTION TCL LICENSE )\S+/$1 . ('d' x 64)/mer, $config, qr{the override line is not its program's license} ],
    'a notice before the override line' =>
      [ $lock =~ s/^(override gr-dos\/tcl16 .*\n)(notice gr-dos\/tcl16 .*\n)/$2$1/mr, $config, qr{a notice line out of place} ],
    'no override line or notice, under the override\'s license' =>
      [ $lock =~ s/^(override|notice) gr-dos\/tcl16 .*\n//mgr, $config,
        qr{TCL\.EXE \(gr-dos/tcl16\) is under TCL, the license-override's \(\S+\), but has no override line} ],
    'no override line, with its notice' =>
      [ $lock =~ s/^override gr-dos\/tcl16 .*\n//mr, $config, qr{a notice line out of place} ],
  );
  for my $what (sort keys %bad) {
    my($l, $cfg, $re) = $bad{$what}->@*;
    spew("$dir/lock", $l);
    spew("$dir/config", $cfg);
    ($rc, $o) = dist16($dir, 'list');
    ok($rc == 2 && $o =~ $re, "the lock is refused: $what") or diag($o);
  }
  spew("$dir/lock", $lock);

  # Errors in the config: only a license the config allows, and a pinned,
  # well-formed SHA-256.
  my %cfg = (
    "license-override gr-dos/tcl16 GPL-3.0 LICENSE sha256=$tcl_sha\n" => qr{GPL-3\.0 is not a license dist16/config allows},
    "license-override gr-dos/tcl16 TCL LICENSE\n" => qr{license-override OWNER/NAME SPDX PATH sha256=HEX},
    "license-override gr-dos/tcl16 TCL LICENSE sha256=ABC\n" => qr{sha256= and 64 lowercase hex digits},
    "license-override gr-dos/tcl16 NOASSERTION LICENSE sha256=$tcl_sha\n" => qr{NOASSERTION is not a license to override with},
    "license-override gr-dos/tcl16 TCL ../LICENSE sha256=$tcl_sha\n" => qr{\.\./LICENSE is not a path},
    "license-override gr-dos/tcl16 TCL LICENSE sha256=$tcl_sha frob\n" => qr{unknown license-override option frob},
    "license-override gr-dos/tcl16 TCL LICENSE sha256=$tcl_sha\nlicense-override gr-dos/TCL16 TCL LICENSE sha256=$tcl_sha\n"
      => qr{has two license-overrides},
  );
  for my $c (sort keys %cfg) {
    spew("$dir/config", "discover gr-dos 16\nlicense MIT TCL\n$c");
    ($rc, $o) = dist16($dir, 'list');
    ok($rc == 2 && $o =~ $cfg{$c}, "a config error: @{[ $c =~ s/\n/; /gr ]}") or diag($o);
  }
}

# 13. A license-asset (issue #37): another owner's program whose release
# gives its license notice as an asset of its own, as plicease/sprocket's
# sprocket-exe-license.txt, pinned, staged beside it as STEM.LIC, and
# checked in the distribution; and each way it is refused.
{
  my $lic = sub ($repo) { license_text($repo, 'MIT') };
  my $rel = sub ($repo, %r) {
    my($name) = $repo =~ m{/(.*)};
    return { name => $name, releases => [ { tag => 'v0.5.1', latest => 1, license => 'MIT',
      assets => { "$name.exe" => mz(700, $name), "$name-exe-license.txt" => $lic->("plicease/$name"),
        "$name-v0.5.1-x86_64-unknown-linux-gnu.tar.gz" => 'tgz' }, %r } ] };
  };
  my $inc = sub ($name) { "include plicease/$name asset=$name.exe license-asset=$name-exe-license.txt\n" };
  my $config = $base_config . join '', map { $inc->($_) } qw( sprocket nolic other badsum );
  my $dir = github(config => $config, owners => {
    'gr-dos' => [ prog('md5sum16') ],
    plicease => [
      $rel->('plicease/sprocket'),
      { name => 'nolic', releases => [ { tag => 'v0.5.1', latest => 1, license => 'MIT', assets => { 'nolic.exe' => mz(700, 'nolic') } } ] },
      $rel->('plicease/other', assets => { 'other.exe' => mz(700, 'other'), 'other-exe-license.txt' => "another notice\n" }),
      $rel->('plicease/badsum', digest => { 'badsum-exe-license.txt' => 'sha256:' . ('0' x 64) }),
    ] });
  my($rc, $o) = dist16($dir, 'resolve');
  my $lines = lock_lines($dir);
  ok($rc == 0, 'license-asset: resolve succeeds') or diag($o);
  my $lsha = sha256_hex($lic->('plicease/sprocket'));
  my $len = length $lic->('plicease/sprocket');
  my($i) = grep { $lines->[$_] =~ m{^program plicease/sprocket } } 0 .. $#$lines;
  ok(defined $i && $lines->[$i] =~ m{^program plicease/sprocket v0\.5\.1 [0-9a-f]{40} sprocket\.exe SPROCKET\.EXE 700 \S+ MIT LICENSE \Q$lsha\E$}
    && $lines->[$i + 1] eq "license-asset plicease/sprocket sprocket-exe-license.txt SPROCKET.LIC $len $lsha",
    'the program is locked, with its license asset right after it, as SPROCKET.LIC');
  ok($o =~ m{^included +plicease/sprocket v0\.5\.1 sprocket\.exe as SPROCKET\.EXE, MIT, license sprocket-exe-license\.txt as SPROCKET\.LIC \(ignored: sprocket-v0\.5\.1-x86_64-unknown-linux-gnu\.tar\.gz\)$}m,
    'the report names the license asset, and not as ignored') or diag($o);
  ok(has($lines, qr{^skip plicease/nolic failed v0\.5\.1 has no license asset nolic-exe-license\.txt \(license-asset=\)$}),
    'a release without the license asset fails');
  ok(has($lines, qr{^skip plicease/other failed v0\.5\.1: the license asset other-exe-license\.txt is not LICENSE at [0-9a-f]{40}$}),
    'a license asset that is not the license at the commit fails');
  ok(has($lines, qr{^skip plicease/badsum failed v0\.5\.1: badsum-exe-license\.txt checksum mismatch}),
    'a license asset that does not match GitHub\'s digest fails');
  ok(has($lines, qr{^program gr-dos/md5sum16 }) && !has($lines, qr{^license-asset gr-dos/}), 'the other programs have no license asset');
  my $first = slurp("$dir/lock");
  ($rc) = dist16($dir, 'resolve');
  ok(slurp("$dir/lock") eq $first, 'license-asset: resolving again writes the same lock');

  ($rc, $o) = dist16($dir, 'list');
  ok($rc == 0 && $o eq "MD5SUM.EXE\nSPROCKET.EXE\nSPROCKET.LIC\n", 'list: the license asset follows its program') or diag($o);
  ($rc, $o) = dist16($dir, 'bin-list');
  ok($rc == 0 && $o =~ m{^  BIN\\SPROCKET\.EXE +from plicease/sprocket v0\.5\.1, MIT\n  BIN\\SPROCKET\.LIC +SPROCKET\.EXE's license notice, the release's sprocket-exe-license\.txt$}m,
    'bin-list: the README names it after its program') or diag($o);
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest");
  ok($rc == 0 && slurp("$dir/dest/SPROCKET.LIC") eq $lic->('plicease/sprocket')
    && slurp("$dir/dest/licenses/SPROCKET.EXE.txt") eq $lic->('plicease/sprocket'), 'fetch stages SPROCKET.LIC beside the program')
    or diag($o);
  remove_tree("$dir/dl", "$dir/raw");
  ($rc) = dist16($dir, 'fetch', "$dir/dest2");
  ok($rc == 0 && slurp("$dir/dest2/SPROCKET.LIC") eq $lic->('plicease/sprocket'), 'offline, fetch reproduces it from the cache');
  spew("$dir/cache/plicease/sprocket/v0.5.1/sprocket-exe-license.txt", "tampered\n");
  ($rc, $o) = dist16($dir, 'fetch', "$dir/dest3");
  ok($rc == 2 && $o =~ /sprocket-exe-license\.txt.*cannot download/, 'a corrupt cached license asset is refused, not used') or diag($o);

  # check-dist: the CF files and the ZIP's BIN must have it, unchanged.
  my $cf = "$dir/cf";
  make_path($cf);
  spew("$cf/$_", slurp("$dir/dest/$_")) for qw( MD5SUM.EXE SPROCKET.EXE SPROCKET.LIC );
  ($rc, $o) = dist16($dir, 'check-dist', $cf, "$dir/dest");
  ok($rc == 0 && $o =~ /SPROCKET\.LIC, the license of SPROCKET\.EXE/, 'check-dist accepts the CF files with SPROCKET.LIC') or diag($o);
  my $zip = "$dir/zip";
  spew("$zip/BIN/$_", slurp("$dir/dest/$_")) for qw( MD5SUM.EXE SPROCKET.EXE SPROCKET.LIC );
  spew("$zip/README.txt", "GR-DOS\n");
  ($rc, $o) = dist16($dir, 'check-dist', $zip, "$dir/dest");
  ok($rc == 0, 'check-dist accepts the ZIP\'s BIN with SPROCKET.LIC') or diag($o);
  spew("$cf/SPROCKET.LIC", "another\n");
  ($rc, $o) = dist16($dir, 'check-dist', $cf, "$dir/dest");
  ok($rc == 2 && $o =~ m{SPROCKET\.LIC is not the license of SPROCKET\.EXE dist16/lock pins}, 'check-dist refuses a changed SPROCKET.LIC') or diag($o);
  unlink "$zip/BIN/SPROCKET.LIC";
  ($rc, $o) = dist16($dir, 'check-dist', $zip, "$dir/dest");
  ok($rc == 2 && $o =~ m{BIN/SPROCKET\.LIC is not the license}, 'check-dist refuses a ZIP without SPROCKET.LIC') or diag($o);

  # The lock is checked against the config's license-asset=.
  my $lock = slurp("$dir/lock");
  my $la = qr{^license-asset plicease/sprocket .*\n}m;
  my %bad = (
    'a license-asset line the config does not name' =>
      [ $lock, $config =~ s/ license-asset=sprocket-exe-license\.txt//r, qr{has the license-asset sprocket-exe-license\.txt, but \S+ names none} ],
    'another license asset than the config names' =>
      [ $lock, $config =~ s/license-asset=sprocket-exe-license\.txt/license-asset=LICENSE.txt/r, qr{but \S+ names LICENSE\.txt} ],
    'no license-asset line, though the config names one' =>
      [ $lock =~ s/$la//r, $config, qr{SPROCKET\.EXE \(plicease/sprocket\) has no license-asset line, but \S+ names sprocket-exe-license\.txt} ],
    'a license-asset line that is not the program\'s license' =>
      [ $lock =~ s/^(license-asset plicease\/sprocket .* )\S+$/$1 . ('d' x 64)/mer, $config, qr{the license-asset line is not its program's license} ],
    'a license-asset line with another DOS name' =>
      [ $lock =~ s/ SPROCKET\.LIC / SPROCKET.TXT /r, $config, qr{malformed license-asset line} ],
    'a license-asset line of another program' =>
      [ $lock =~ s/^license-asset plicease\/sprocket /license-asset plicease\/other /mr, $config, qr{a license-asset line must follow its program's} ],
    'a license-asset line before its program\'s' =>
      [ $lock =~ s/^(program plicease\/sprocket .*\n)(license-asset .*\n)/$2$1/mr, $config, qr{a license-asset line must follow its program's} ],
    'two license-asset lines' =>
      [ $lock =~ s/^(license-asset .*\n)/$1$1/mr, $config, qr{a license-asset line out of place} ],
  );
  for my $what (sort keys %bad) {
    my($l, $cfg, $re) = $bad{$what}->@*;
    spew("$dir/lock", $l);
    spew("$dir/config", $cfg);
    ($rc, $o) = dist16($dir, 'list');
    ok($rc == 2 && $o =~ $re, "the lock is refused: $what") or diag($o);
  }
  spew("$dir/lock", $lock);

  # Errors in the config.
  my %cfg = (
    "include plicease/sprocket asset=sprocket.exe license-asset=sprocket.exe\n" => qr{license-asset= names the program asset=},
    "include plicease/sprocket license-asset=../LICENSE\n" => qr{license-asset= is the name of a release asset},
    "include plicease/sprocket license-asset=\n" => qr{license-asset= is the name of a release asset},
  );
  for my $c (sort keys %cfg) {
    spew("$dir/config", "$base_config$c");
    ($rc, $o) = dist16($dir, 'list');
    ok($rc == 2 && $o =~ $cfg{$c}, "a config error: @{[ $c =~ s/\n/; /gr ]}") or diag($o);
  }
  spew("$dir/config", $config);
}

say "1..$tests";
say $failed ? "dist16 tests: $failed of $tests failed" : "dist16 tests: passed";
exit($failed ? 1 : 0);
