# A blank 40 MB disk (820 cylinders, 6 heads, 17 sectors): a Primary DOS
# Partition of all of it, made active, and displayed.
disk 42823680 820/6/17
expect table
expect sectors
wait A:\\>
type FDISK
key ret
screen main
key 1 ret
wait Enter choice
key 1 ret
screen create-primary
key ret
screen restart
key spc
wait A:\\>
type FDISK
key ret
wait Enter choice
key 4 ret
screen display
key esc
wait Enter choice
key esc
wait A:\\>
quit
