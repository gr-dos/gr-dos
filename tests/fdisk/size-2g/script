# A blank 2 GB disk (4160 cylinders, 16 heads, 63 sectors), which the BIOS
# gives DOS as 520 cylinders and 128 heads: a Primary DOS Partition of all
# of it, made active, and displayed.
disk 2146959360 4160/16/63 lba
expect table
expect sectors
wait A:\\>
type FDISK
key ret
screen main
key 1 ret
wait Enter choice
key 1 ret
screen create-primary
key ret
screen restart
key spc
wait A:\\>
type FDISK
key ret
wait Enter choice
key 4 ret
screen display
key esc
wait Enter choice
key esc
wait A:\\>
quit
