@ECHO OFF
REM JOIN and SUBST tests (make test-join-subst), run from C:\ of a CF
REM install: D:\AUTOEXEC.BAT starts it, as D: is joined in it. CTTY AUX
REM sends the output to COM1; after each command, EL.BAT (in C:\DOS)
REM reports the errorlevel. The expected output, expect.log, is Microsoft's
REM JOIN.EXE's and SUBST.EXE's (make join-subst-expect).
CTTY AUX
ECHO GRDOS-TEST-BEGIN
MD D:\JS
MD D:\JS\WORK
MD D:\JS\WORK\SUB
MD D:\JS\EMPTY
ECHO hello from D:>D:\JS\WORK\HELLO.TXT
MD C:\FULL
ECHO x>C:\FULL\X.TXT
ECHO x>C:\FILE.TXT
MD C:\INUSE
MD C:\JN
MD C:\JN\DEEP
D:
CD \JS
C:
ECHO == nothing yet
JOIN
CALL EL
SUBST
CALL EL

ECHO == SUBST E: D:\JS\WORK
SUBST E: D:\JS\WORK
CALL EL
SUBST
CALL EL
TYPE E:\HELLO.TXT
ECHO written through E:>E:\SUB\NEW.TXT
TYPE D:\JS\WORK\SUB\NEW.TXT
IF EXIST E:\SUB\NEW.TXT ECHO E:\SUB\NEW.TXT exists
E:
CD SUB
CD
CD \
C:
ECHO == SUBST errors with E: substituted
SUBST E: D:\JS\EMPTY
CALL EL
JOIN E: C:\EJOIN
CALL EL
IF EXIST C:\EJOIN\NUL ECHO C:\EJOIN was made
E:
SUBST E: /D
CALL EL
C:
SUBST
CALL EL
ECHO == SUBST E: /D
SUBST E: /D
CALL EL
SUBST
CALL EL
IF NOT EXIST E:\HELLO.TXT ECHO E: is gone
SUBST E: /D
CALL EL

ECHO == SUBST forms
subst e: d:\js\work
CALL EL
SUBST
SUBST E: /d
SUBST E: D:\JS\WORK\
CALL EL
SUBST
SUBST E: /D
SUBST E: D:WORK
CALL EL
SUBST
SUBST E: /D
D:
SUBST E: ..\JS\WORK\SUB
CALL EL
SUBST
SUBST E: /D
SUBST E: .
CALL EL
SUBST
SUBST E: /D
C:
SUBST E:D:\JS\WORK
CALL EL
SUBST
SUBST E: /D
SUBST E: D:\JS\WORK /D
CALL EL
SUBST
ECHO == SUBST A: (a floppy drive)
SUBST A: D:\JS\WORK
CALL EL
SUBST
TYPE A:\HELLO.TXT
SUBST A: /D
CALL EL
SUBST
CALL EL

ECHO == SUBST errors
SUBST E:
CALL EL
SUBST D:\JS\WORK
CALL EL
SUBST /D
CALL EL
SUBST E: D:\JS\NOPE
CALL EL
SUBST E: D:\JS\WORK\HELLO.TXT
CALL EL
SUBST E: D:\
CALL EL
SUBST
SUBST E: /D
SUBST E: D:
CALL EL
SUBST E: E:\
CALL EL
SUBST C: D:\JS\WORK
CALL EL
SUBST F: D:\JS\WORK
CALL EL
SUBST Q: D:\JS\WORK
CALL EL
SUBST E: Q:\JS
CALL EL
SUBST E: D:\JS\WORK EXTRA
CALL EL
SUBST E: D:\JS\WORK /X
CALL EL
SUBST /D /D
CALL EL
SUBST E: /D /D
CALL EL
SUBST E: D:\JS\WORK\..\..\..
CALL EL
SUBST 1: D:\JS\WORK
CALL EL
SUBST E D:\JS\WORK
CALL EL
SUBST
CALL EL

ECHO == JOIN D: C:\MNT
JOIN D: C:\MNT
CALL EL
JOIN
CALL EL
IF EXIST C:\MNT\JS\WORK\HELLO.TXT ECHO C:\MNT is D:
TYPE C:\MNT\JS\WORK\HELLO.TXT
ECHO written through C:\MNT>C:\MNT\JS\JOINED.TXT
D:
CD
C:
ECHO == JOIN errors with D: joined
JOIN D: C:\OTHER
CALL EL
SUBST D: C:\FULL
CALL EL
SUBST E: C:\MNT\JS
CALL EL
SUBST
SUBST E: /D
CD \MNT
JOIN D: /D
CALL EL
CD \
ECHO == JOIN D: /D
JOIN D: /D
CALL EL
JOIN
CALL EL
TYPE D:\JS\JOINED.TXT
IF EXIST C:\MNT\NUL ECHO C:\MNT is still there
JOIN D: /D
CALL EL

ECHO == JOIN forms
join d: c:\mnt
CALL EL
JOIN
JOIN D: /d
JOIN D: C:\JN\DEEP
CALL EL
JOIN
TYPE C:\JN\DEEP\JS\WORK\HELLO.TXT
JOIN D: /D
JOIN D:C:\MNT
CALL EL
JOIN
JOIN D: /D
JOIN D: \NEWDIR
CALL EL
JOIN
IF EXIST C:\NEWDIR\JS\NUL ECHO C:\NEWDIR is D:
JOIN D: /D
CD \JN
JOIN D: DEEP
CALL EL
JOIN
JOIN D: /D
CD \
JOIN D: C:\EMPTY\
CALL EL
JOIN
JOIN D: /D
JOIN A: C:\FLOPPY
CALL EL
JOIN
JOIN A: /D
CALL EL
JOIN
CALL EL

ECHO == JOIN errors
JOIN D:
CALL EL
JOIN C:\MNT
CALL EL
JOIN /D
CALL EL
JOIN D: C:\MNT /D
CALL EL
JOIN C: D:\JS\CJOIN
CALL EL
JOIN D: D:\JS\EMPTY
CALL EL
JOIN D: C:\
CALL EL
JOIN D: C:\FULL
CALL EL
JOIN D: C:\FILE.TXT
CALL EL
JOIN D: C:\NO\SUCH
CALL EL
JOIN E: C:\EJOIN
CALL EL
JOIN Q: C:\QJOIN
CALL EL
JOIN D: Q:\QJOIN
CALL EL
JOIN D: C:\MNT EXTRA
CALL EL
JOIN D: C:\MNT /X
CALL EL
JOIN D: /D /D
CALL EL
CD \INUSE
JOIN D: C:\INUSE
CALL EL
JOIN
JOIN D: /D
CALL EL
CD \
JOIN D: C:\INUSE\..\..
CALL EL
JOIN D C:\MNT
CALL EL
JOIN
CALL EL
SUBST
CALL EL
ECHO GRDOS-TEST-END
CTTY CON
