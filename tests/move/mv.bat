@ECHO OFF
REM MOVE tests (make test-move), run from C:\ of a CF install with an empty
REM 1.44 MB A: and a write-protected B:: D:\AUTOEXEC.BAT starts it. CTTY
REM AUX sends the output to COM1, and takes the keys from it; after each
REM command, EL.BAT (in C:\DOS) reports the errorlevel. "== keys KEYS"
REM gives scripts/move-test the answers to the questions that follow.
REM D:\M\T01 to T24 hold the same files, put there by scripts/move-test:
REM A.TXT, B.TXT, C.TXT, X.DAT, Y.DAT, a read-only RO.TXT, a hidden
REM HID.TXT, a system SYS.TXT, SUB with B.TXT and a read-only ROX.TXT,
REM and DIR1 with IN.TXT and DEEP\IN2.TXT; D:\M\BIG\BIG.BIN is larger
REM than a floppy. scripts/move-test lists the files and directories that
REM MOVE leaves.
REM
REM Only COMMAND.COM's own commands are used, so that this file runs the
REM same on MS-DOS 6.22, whose output, MOVE.EXE's, is expect.log (make
REM move-expect). When this file ends, scripts/move-test types the lines
REM of typed.txt at the prompt.
CTTY AUX
ECHO GRDOS-TEST-BEGIN
D:
CD \M\T01

ECHO == T01: parameters
MOVE
CALL EL
MOVE A.TXT
CALL EL
MOVE /X A.TXT SUB
CALL EL
MOVE A.TXT SUB EXTRA
CALL EL
MOVE A.TXT SUB /Y
CALL EL
MOVE /Y
CALL EL
MOVE /Y/-Y A.TXT B.TXT C.TXT
CALL EL
MOVE -Y A.TXT SUB
CALL EL
MOVE A.TXT, SUB
CALL EL
MOVE A.TXT ,SUB
CALL EL
MOVE /? > NUL
CALL EL
MOVE /? A.TXT SUB > NUL
CALL EL
MOVE /y /-y /Y B.TXT B2.TXT
CALL EL

ECHO == T02: a file renamed, into a directory, with a new name there
CD \M\T02
MOVE A.TXT NEW.TXT
CALL EL
MOVE B.TXT SUB\NEWB.TXT
CALL EL
MOVE C.TXT SUB
CALL EL
MOVE X.DAT .\SUB\
CALL EL
MOVE y.dat sub\lower.dat
CALL EL
MOVE RO.TXT NOEXT
CALL EL
MOVE SUB\ROX.TXT LONGNAMEXYZ.TEXT
CALL EL

ECHO == T03: replacing a file, from a batch file: no question, then /-Y
CD \M\T03
MOVE B.TXT SUB
CALL EL
ECHO == keys n^M
MOVE /-Y A.TXT SUB\B.TXT
CALL EL
ECHO == keys Y^M
MOVE /-Y A.TXT SUB\B.TXT
CALL EL
ECHO == keys x^MA^M
MOVE /-Y C.TXT SUB\B.TXT
CALL EL

ECHO == T04: wildcards
CD \M\T04
MOVE *.DAT SUB
CALL EL
MOVE ?.TXT SUB
CALL EL
MOVE *.TXT SUB
CALL EL
MOVE *.NO SUB
CALL EL
MOVE DIR1\*.* DIR1\DEEP
CALL EL

ECHO == T05: several files, separated by commas
CD \M\T05
MOVE A.TXT,X.DAT,Y.DAT SUB
CALL EL
MOVE B.TXT, C.TXT SUB
CALL EL
MOVE SUB\A.TXT,NOPE.TXT,SUB\X.DAT .
CALL EL
MOVE SUB\Y.DAT ,SUB\C.TXT , D:\M\T05\SUB\B.TXT D:\M\T05
CALL EL
MOVE RO.TXT,DIR1\IN.TXT,*.DAT SUB
CALL EL

ECHO == T06: several files to one, and to a directory that is not there
CD \M\T06
MOVE A.TXT,B.TXT C.TXT
CALL EL
MOVE *.DAT C.TXT
CALL EL
MOVE A.TXT,B.TXT NEWDIR
CALL EL
MOVE *.DAT NEWDAT\
CALL EL
MOVE C.TXT NEWC\
CALL EL
MOVE RO.TXT NEW1\NEW2\
CALL EL
MOVE SUB\*.TXT NEW3\NEW4
CALL EL
ECHO == keys n^M
MOVE /-Y DIR1\IN.TXT,DIR1\DEEP\IN2.TXT NEWA
CALL EL
ECHO == keys xy^M
MOVE /-Y DIR1\IN.TXT,DIR1\DEEP\IN2.TXT NEWA
CALL EL

ECHO == T07: a file onto itself
CD \M\T07
MOVE A.TXT A.TXT
CALL EL
MOVE A.TXT .\A.TXT
CALL EL
MOVE A.TXT D:\M\T07
CALL EL
MOVE a.txt A.TXT
CALL EL
MOVE *.TXT .
CALL EL
MOVE SUB\B.TXT ..\T07\SUB
CALL EL
MOVE B.TXT,B.TXT SUB
CALL EL

ECHO == T08: missing files, directories and drives
CD \M\T08
MOVE NOPE.TXT SUB
CALL EL
MOVE NOPE\*.TXT SUB
CALL EL
MOVE A.TXT NOPE\X\Y.TXT
CALL EL
MOVE A.TXT Q:\
CALL EL
MOVE Q:A.TXT SUB
CALL EL
MOVE B.TXT,C.TXT NOPE\X\
CALL EL
MOVE X.DAT NUL
CALL EL

ECHO == T09: attributes
CD \M\T09
MOVE RO.TXT SUB
CALL EL
MOVE HID.TXT SUB
CALL EL
MOVE SYS.TXT SUB
CALL EL
MOVE A.TXT SUB\ROX.TXT
CALL EL
MOVE *.TXT SUB
CALL EL

ECHO == T10: directories
CD \M\T10
MOVE DIR1 DIR2
CALL EL
MOVE DIR2 SUB\DIR3
CALL EL
MOVE DIR2 SUB
CALL EL
MOVE DIR2 DIR2\X
CALL EL
MOVE DIR2 A:\DIR
CALL EL
MOVE DIR2\ DIR4
CALL EL
MOVE DIR2\DEEP DIR2\DEEPER
CALL EL
MOVE D:\M\T10\DIR2 D:\M\T10\DIR5
CALL EL
MOVE DIR5 ..\T10\DIR6
CALL EL
MOVE DIR6 SUB\DIR7
CALL EL
MOVE A.TXT DIR6
CALL EL
MOVE DIR6 dir6
CALL EL
MOVE DIR6 DIR6X
CALL EL
MOVE DIR6X B.TXT
CALL EL
CD \M\T11
MOVE DIR* DIRX
CALL EL
MOVE DIRX,C.TXT SUB
CALL EL
MOVE DIRX\DEEP,A.TXT DIRX
CALL EL
MOVE DIRX .
CALL EL

ECHO == T12: to another drive
CD \M\T12
MOVE A.TXT A:\
CALL EL
MOVE B.TXT,RO.TXT A:
CALL EL
MOVE C.TXT A:\NEW.TXT
CALL EL
MOVE HID.TXT,SYS.TXT A:\
CALL EL
MOVE A:\NEW.TXT D:
CALL EL
MOVE X.DAT A:\SUBDIR\
CALL EL
MOVE DIR1\*.* A:\IN
CALL EL
ECHO == keys F
MOVE Y.DAT B:\
CALL EL
MOVE ..\BIG\BIG.BIN A:\
CALL EL
ECHO == keys F F F F F F
MOVE B:\B.TXT D:
CALL EL
MOVE SUB\B.TXT A:\B.TXT
CALL EL
MOVE A:\B.TXT,A:\RO.TXT SUB
CALL EL

ECHO == T13: COPYCMD
CD \M\T13
SET COPYCMD=/-Y
ECHO == keys n^M
MOVE A.TXT SUB\B.TXT
CALL EL
MOVE /Y A.TXT SUB\B.TXT
CALL EL
SET COPYCMD=/Y
ECHO == keys N^M
MOVE /-Y B.TXT SUB\B.TXT
CALL EL
MOVE B.TXT SUB\B.TXT
CALL EL
SET COPYCMD=/y
COPY C.TXT SUB\B.TXT > NUL
MOVE C.TXT SUB\B.TXT
CALL EL
SET COPYCMD=junk
ECHO == keys y^M
MOVE X.DAT SUB\B.TXT
CALL EL
SET COPYCMD=/A /-Y
ECHO == keys n^M
MOVE Y.DAT SUB\B.TXT
CALL EL
SET COPYCMD=/A /Y
ECHO == keys n^M
MOVE Y.DAT SUB\B.TXT
CALL EL
SET COPYCMD=/-Y/Y
ECHO == keys n^M
MOVE Y.DAT SUB\B.TXT
CALL EL
SET COPYCMD=

ECHO == T14: relative and drive-relative paths
CD \M\T14\SUB
MOVE ..\A.TXT .
CALL EL
MOVE ..\B.TXT ..\DIR1
CALL EL
C:
MOVE D:..\C.TXT D:
CALL EL
MOVE D:\M\T14\X.DAT D:..\DIR1\DEEP
CALL EL
MOVE D:..\Y.DAT D:\M\T14\SUB\Z.DAT
CALL EL
D:
CD \
MOVE M\T14\RO.TXT M\T14\SUB
CALL EL
MOVE \M\T14\SUB\ROX.TXT M\T14
CALL EL

ECHO == T15: two sources of the same name
CD \M\T15
MOVE B.TXT,SUB\B.TXT DIR1
CALL EL
MOVE A.TXT,A.TXT SUB
CALL EL
ECHO == keys n^M y^M
MOVE /-Y C.TXT,DIR1\B.TXT,SUB\A.TXT DIR1\DEEP\
CALL EL
COPY X.DAT DIR1\DEEP\B.TXT > NUL
ECHO == keys n^M
MOVE /-Y X.DAT,DIR1\DEEP\B.TXT DIR1
CALL EL

ECHO == T16: Yes, No and All
CD \M\T16
COPY *.TXT SUB > NUL
COPY *.DAT SUB > NUL
ECHO == keys y^M n^M a^M
MOVE /-Y *.TXT SUB
CALL EL
ECHO == keys n^M qy^M
MOVE /-Y *.DAT SUB
CALL EL

ECHO == T17: Ctrl-C and Ctrl-Z at a question, and Enter alone
CD \M\T17
ECHO == keys ^C N
MOVE /-Y A.TXT SUB\B.TXT
CALL EL
ECHO == keys ^C N
MOVE /-Y A.TXT,C.TXT NEWC\
CALL EL
ECHO == keys ^Z
MOVE /-Y C.TXT SUB\B.TXT
CALL EL
ECHO == keys ^M^My^M
MOVE /-Y C.TXT SUB\B.TXT
CALL EL
COPY X.DAT SUB > NUL
COPY Y.DAT SUB > NUL
ECHO == keys y^M ^C N
MOVE /-Y X.DAT,Y.DAT SUB
CALL EL

ECHO == T18: a file name as a directory, and wildcards in the destination
CD \M\T18
MOVE A.TXT B.TXT\
CALL EL
MOVE A.TXT *.BAK
CALL EL
MOVE C.TXT SUB\*.*
CALL EL
MOVE DIR1 *.X
CALL EL
MOVE X.DAT D:
CALL EL
MOVE Y.DAT \M\T18\SUB\.
CALL EL
MOVE RO.TXT SUB\..\NEWRO.TXT
CALL EL
MOVE B.TXT ..\T18\SUB\..\DIR1
CALL EL

ECHO == T19: the current directory and the root
CD \M\T19
MOVE . SUB
CALL EL
MOVE .. SUB
CALL EL
MOVE A.TXT \
CALL EL
MOVE \A.TXT D:\M\T19
CALL EL
MOVE SUB\*.* .
CALL EL
CD SUB
MOVE ..\*.TXT
CALL EL

ECHO == T21: a directory renamed, its paths no longer than DOS's 66
MD \M\T21
CD \M\T21
MD A
MD A\BBBBBBBB
MD A\BBBBBBBB\CCCCCCCC
MD A\BBBBBBBB\CCCCCCCC\DDDDDDDD
MD A\BBBBBBBB\CCCCCCCC\DDDDDDDD\EEEEEEEE
MD A\BBBBBBBB\CCCCCCCC\DDDDDDDD\EEEEEEEE\FFFFFFFF
MD A\BBBBBBBB\CCCCCCCC\DDDDDDDD\EEEEEEEE\FFFFFFFF\GG
MOVE A ABCDEFGH.XYZ
CALL EL
MOVE A ABCDEFGH
CALL EL
MOVE ABCDEFGH AB
CALL EL

ECHO == typed
