@ECHO OFF
REM FC tests (make test-fc). CTTY AUX sends FC's output to COM1; after each
REM command, EL.BAT reports the errorlevel. The expected output, expect.log,
REM is Microsoft's FC.EXE's (make fc-expect).
CTTY AUX
ECHO GRDOS-TEST-BEGIN
COPY A.TXT A2.TXT >NUL
COPY A.TXT A.EXE >NUL
COPY B.TXT B.EXE >NUL
COPY A.TXT EOF.TXT /A >NUL
MD SUB
ECHO == identical
FC A.TXT A2.TXT
CALL EL
ECHO == lines
FC A.TXT B.TXT
CALL EL
FC B.TXT A.TXT
CALL EL
ECHO == /A
FC /A A.TXT B.TXT
CALL EL
FC /A A.TXT MANY.TXT
CALL EL
ECHO == /C
FC A.TXT CASE.TXT
CALL EL
FC /C A.TXT CASE.TXT
CALL EL
ECHO == /W
FC A.TXT SPACE.TXT
CALL EL
FC /W A.TXT SPACE.TXT
CALL EL
FC /W /C SPACE.TXT CASE.TXT
CALL EL
ECHO == /C, code page 437
FC INTL.TXT INTLUP.TXT
CALL EL
FC /C INTL.TXT INTLUP.TXT
CALL EL
ECHO == /N
FC /N A.TXT B.TXT
CALL EL
ECHO == /T
FC TABS.TXT SPACES.TXT
CALL EL
FC /T TABS.TXT SPACES.TXT
CALL EL
ECHO == /nnnn
FC /1 A.TXT B.TXT
CALL EL
FC /4 A.TXT B.TXT
CALL EL
ECHO == /LBnn
FC /LB3 A.TXT MANY.TXT
CALL EL
FC /LB5 A.TXT B.TXT
CALL EL
REM Out of memory: Microsoft's errorlevel is undefined (usage's second
REM argument is missing); GR-DOS's is 1.
FC /LB400 A.TXT B.TXT
ECHO == longer
FC WIDE.TXT WIDE2.TXT
CALL EL
FC /T WIDE.TXT WIDE2.TXT
CALL EL
FC A.TXT LONG.TXT
CALL EL
FC LONG.TXT A.TXT
CALL EL
FC A.TXT EOF.TXT
CALL EL
ECHO == /B
FC /B A.TXT A2.TXT
CALL EL
FC /B A.TXT B.TXT
CALL EL
FC /B A.TXT LONG.TXT
CALL EL
FC /B LONG.TXT A.TXT
CALL EL
FC /b a.txt eof.txt
CALL EL
ECHO == binary by extension
FC A.EXE B.EXE
CALL EL
FC /L A.EXE B.EXE
CALL EL
ECHO == errors
FC
CALL EL
FC A.TXT
CALL EL
FC A.TXT B.TXT LONG.TXT
CALL EL
FC /X A.TXT B.TXT
CALL EL
FC /B /L A.TXT B.TXT
CALL EL
FC /B /N A.TXT B.TXT
CALL EL
FC NOFILE.TXT A.TXT
CALL EL
FC A.TXT NOFILE.TXT
CALL EL
FC A.TXT \NODIR\A.TXT
CALL EL
FC SUB A.TXT
CALL EL
FC *.TXT A.TXT
CALL EL
ECHO GRDOS-TEST-END
CTTY CON
