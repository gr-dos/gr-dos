@ECHO OFF
REM Utility tests (make test-utils). CTTY AUX sends the programs' output,
REM and their error messages, to COM1; their input comes from the .IN files.
REM Drive B: is a blank, disposable 1.44 MB image, not formatted.
CTTY AUX
ECHO GRDOS-TEST-BEGIN
ECHO == MORE
MORE <LINES.TXT
REM A file named (issue #34): relative, with a drive and path, piped
REM input ignored; an empty file; then the errors and their errorlevels
ECHO -- MORE LINES.TXT
MORE LINES.TXT
ECHO -- MORE A:\LINES.TXT
MORE A:\LINES.TXT
ECHO -- TYPE LINES.TXT : MORE
TYPE LINES.TXT | MORE
TYPE NUL >EMPTY.TXT
ECHO -- MORE EMPTY.TXT
MORE EMPTY.TXT
IF NOT ERRORLEVEL 1 ECHO MORE-EMPTY-0
MORE NOFILE.TXT
IF ERRORLEVEL 1 IF NOT ERRORLEVEL 2 ECHO MORE-ERRORLEVEL-1
MORE A:\NODIR\X.TXT
IF ERRORLEVEL 1 IF NOT ERRORLEVEL 2 ECHO MORE-ERRORLEVEL-1
MORE LINES.TXT EXTRA
IF ERRORLEVEL 2 IF NOT ERRORLEVEL 3 ECHO MORE-ERRORLEVEL-2
MORE /X
IF ERRORLEVEL 2 IF NOT ERRORLEVEL 3 ECHO MORE-ERRORLEVEL-2
MORE LINES.TXT /X
IF ERRORLEVEL 2 IF NOT ERRORLEVEL 3 ECHO MORE-ERRORLEVEL-2
ECHO == FIND
FIND "beta" LINES.TXT
FIND /C "a" LINES.TXT
FIND /N /V "a" LINES.TXT
TYPE LINES.TXT | FIND "lt"
ECHO == ATTRIB
ATTRIB +R LINES.TXT
ATTRIB LINES.TXT
DEL LINES.TXT
IF EXIST LINES.TXT ECHO GRDOS-READ-ONLY-KEPT
ATTRIB -R LINES.TXT
ATTRIB LINES.TXT
ATTRIB -A LINES.TXT
ATTRIB LINES.TXT
ATTRIB +A LINES.TXT
ATTRIB NOFILE.TXT
ATTRIB /X
ECHO == DEBUG
DEBUG <DEBUG.IN
HI
DEBUG HI.COM <DEBUGU.IN
ECHO == MEM
MEM
MEM /PROGRAM
MEM /DEBUG
REM MEM /HUMAN (issue #89): alone, in lower case, with /PROGRAM and
REM /DEBUG in either order; then a second /HUMAN, and /PROGRAM with /DEBUG
ECHO -- MEM /HUMAN
MEM /HUMAN
ECHO -- mem /human
mem /human
ECHO -- MEM /PROGRAM /HUMAN
MEM /PROGRAM /HUMAN
ECHO -- MEM /HUMAN /DEBUG
MEM /HUMAN /DEBUG
ECHO -- MEM /HUMAN /HUMAN
MEM /HUMAN /HUMAN
ECHO -- MEM /PROGRAM /DEBUG /HUMAN
MEM /PROGRAM /DEBUG /HUMAN
ECHO == MODE
MODE COM1:9600,N,8,1
MODE LPT1:132,8
ECHO == CHKDSK
CHKDSK A:
ECHO == DISKCOPY
DISKCOPY A: B: <DISKCOPY.IN
IF NOT ERRORLEVEL 1 ECHO GRDOS-DISKCOPY-OK
DIR B:LINES.TXT
TYPE B:LINES.TXT
ECHO == DIR
REM A switch before the filespec (issue #91): the filespec's drive, not
REM the default drive A:, whether it is relative to B:'s current directory
REM or absolute, and with the switch after it, or none, as before
MD B:\SUB
COPY B:LINES.TXT B:\SUB\SUBLINES.TXT >NUL
CD B:\SUB
ECHO -- DIR /W *.BAT
DIR /W *.BAT
ECHO -- DIR B:*.TXT /W
DIR B:*.TXT /W
ECHO -- DIR /W B:*.TXT
DIR /W B:*.TXT
ECHO -- DIR /W B:\*.TXT
DIR /W B:\*.TXT
ECHO -- DIR /P B:\SUB\*.TXT
DIR /P B:\SUB\*.TXT
ECHO -- DIR /W /P B:\SUB
DIR /W /P B:\SUB
ECHO -- DIR B:\LINES.TXT
DIR B:\LINES.TXT
ECHO -- DIR /W B:\NOFILE.TXT
DIR /W B:\NOFILE.TXT
CD B:\
ECHO == FORMAT
FORMAT B: /S /V:GRTEST <FORMAT.IN
IF NOT ERRORLEVEL 1 ECHO GRDOS-FORMAT-OK
COPY BOOTB.BAT B:AUTOEXEC.BAT
CHKDSK B:
ECHO GRDOS-TEST-END
CTTY CON
