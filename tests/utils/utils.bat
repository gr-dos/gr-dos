@ECHO OFF
REM Utility tests (make test-utils). CTTY AUX sends the programs' output,
REM and their error messages, to COM1; their input comes from the .IN files.
REM Drive B: is a blank, disposable 1.44 MB image.
CTTY AUX
ECHO GRDOS-TEST-BEGIN
ECHO == MORE
MORE <LINES.TXT
ECHO == FIND
FIND "beta" LINES.TXT
FIND /C "a" LINES.TXT
FIND /N /V "a" LINES.TXT
TYPE LINES.TXT | FIND "lt"
ECHO == ATTRIB
ATTRIB +R LINES.TXT
ATTRIB LINES.TXT
DEL LINES.TXT
IF EXIST LINES.TXT ECHO GRDOS-READ-ONLY-KEPT
ATTRIB -R LINES.TXT
ATTRIB LINES.TXT
ATTRIB NOFILE.TXT
ECHO == DEBUG
DEBUG <DEBUG.IN
HI
DEBUG HI.COM <DEBUGU.IN
ECHO == MEM
MEM
MEM /PROGRAM
ECHO == MODE
MODE COM1:9600,N,8,1
MODE LPT1:132,8
ECHO == CHKDSK
CHKDSK A:
ECHO == DISKCOPY
DISKCOPY A: B: <DISKCOPY.IN
IF NOT ERRORLEVEL 1 ECHO GRDOS-DISKCOPY-OK
DIR B:LINES.TXT
TYPE B:LINES.TXT
ECHO == FORMAT
FORMAT B: /S /V:GRTEST <FORMAT.IN
IF NOT ERRORLEVEL 1 ECHO GRDOS-FORMAT-OK
COPY BOOTB.BAT B:AUTOEXEC.BAT
CHKDSK B:
ECHO GRDOS-TEST-END
CTTY CON
