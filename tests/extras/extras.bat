@ECHO OFF
REM Tests of the utilities of issue #17 (make test-extras). CTTY AUX sends
REM the programs' output, and their error messages, to COM1; their input
REM comes from the .IN files. Drive B: is a blank, disposable 1.44 MB
REM image, made by mformat with the label GRDATA.
CTTY AUX
ECHO GRDOS-TEST-BEGIN
ECHO == SORT
SORT <SORT.TXT
SORT /R <SORT.TXT
SORT /+2 <SORT.TXT
SORT /X <SORT.TXT
ECHO == COMP
COMP SAME1.TXT SAME2.TXT <COMP.IN
COMP SAME1.TXT DIFF.TXT <COMP.IN
COMP SAME1.TXT NOFILE.TXT <COMP.IN
ECHO == TREE
MD B:\ONE
MD B:\ONE\TWO
COPY SAME1.TXT B:\ONE\TWO
TREE B:
TREE B: /F
TREE B: /X
ECHO == XCOPY
XCOPY A:\*.TXT B:\X\
DIR B:\X
XCOPY B:\ONE B:\COPY\ /S
DIR B:\COPY\TWO
XCOPY NOFILE.TXT B:\
XCOPY /Z
ECHO == LABEL
LABEL B:GRLABEL
VOL B:
LABEL B: <LABEL.IN
VOL B:
LABEL B:TOO-LONG-LABEL
VOL B:
ECHO == EDLIN
EDLIN B:NEW.TXT <EDLIN.IN
TYPE B:NEW.TXT
EDLIN
ECHO == EXE2BIN
EXE2BIN HELLOX.EXE B:HELLOX.COM
B:HELLOX
IF ERRORLEVEL 7 ECHO GRDOS-EXE2BIN-OK
EXE2BIN NOFILE.EXE B:NOFILE.COM
ECHO == RECOVER
COPY SORT.TXT B:REC.TXT
RECOVER B:REC.TXT <RECOVER.IN
TYPE B:REC.TXT
RECOVER
ECHO == APPEND
COPY SAME1.TXT B:\X\ONLYB.TXT
TYPE ONLYB.TXT
APPEND B:\X
TYPE ONLYB.TXT
APPEND
APPEND ;
APPEND
TYPE ONLYB.TXT
APPEND /Y
ECHO == ASSIGN
DIR B:LINES.TXT
ASSIGN B=A
DIR B:LINES.TXT
ASSIGN
DIR B:LINES.TXT
ASSIGN D=B
ASSIGN /X
ECHO == SHARE
SHARE
SHARE
ECHO == GRAFTABL
GRAFTABL /STATUS
GRAFTABL 437
GRAFTABL /STATUS
GRAFTABL 999
ECHO == GRAPHICS
GRAPHICS NOSUCH
GRAPHICS
GRAPHICS
ECHO == PRINT
PRINT /D:NUL SORT.TXT <PRINT.IN
PRINT <PRINT.IN
PRINT /X <PRINT.IN
ECHO == KEYB
KEYB
KEYB UK
ECHO == NLSFUNC
NLSFUNC
NLSFUNC
ECHO == FASTOPEN
FASTOPEN A:
FASTOPEN
ECHO == IFSFUNC
IFSFUNC
IFSFUNC
ECHO == RESIDENT
MEM /PROGRAM
ECHO == DISKCOMP
DISKCOPY A: B: <DISKCOPY.IN
DISKCOMP A: B: <DISKCOMP.IN
IF NOT ERRORLEVEL 1 ECHO GRDOS-DISKCOMP-OK
LABEL B:CHANGED
DISKCOMP A: B: <DISKCOMP.IN
DISKCOMP A: B: /X
ECHO GRDOS-TEST-END
CTTY CON
