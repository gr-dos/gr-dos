# Lines the IBM 4201 printer test (printer.bat) must write to COM1 with
# DEVICE=A:\PRINTER.SYS LPT1=(4201,437,1) (scripts/smoke-test); what it
# sends to LPT1 is in lpt.

^GRDOS-TEST-BEGIN$

# At boot PRINTER.SYS has the printer's own code page, 437, and one slot
# for a downloaded font, and no code page selected
^== BOOT$
^No code page has been selected$
^Hardware code pages:$
^  code page 437$
^Prepared code pages:$
^  code page not prepared$
^MODE status code page function completed$

# 850 from 4201.CPI
^== PREPARE$
^MODE prepare code page function completed$
^No code page has been selected$
^Hardware code pages:$
^  code page 437$
^Prepared code pages:$
^  code page 850$
^MODE status code page function completed$

^== SELECT$
^MODE select code page function completed$
^Active code page for device LPT1 is 850$
^Hardware code pages:$
^  code page 437$
^Prepared code pages:$
^  code page 850$
^MODE status code page function completed$

^== TEXT$
^ +1 File\(s\) copied$

^== HARDWARE$
^MODE select code page function completed$
^== AGAIN$
^MODE select code page function completed$
^== REFRESH$
^MODE refresh code page function completed$

# 865 is not prepared; two code pages are one more than the slots, and
# the failed PREPARE leaves the slot empty and nothing selected; 4208.CPI
# is another printer's; 999 is in no font file; and there is no NOFILE.CPI
^== ERRORS$
^Code page not prepared$
^Device error during prepare$
^Device or code page missing from font file$
^Device or code page missing from font file$
^Failure to access code page font file$
