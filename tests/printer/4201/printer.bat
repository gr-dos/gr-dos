@ECHO OFF
REM PRINTER.SYS with an IBM Proprinter (4201): hardware code page 437 and
REM one for a font MODE prepares from 4201.CPI, which selecting it sends to
REM the printer. Each == line on COM1 is also on LPT1, between what each
REM step sends to the printer (tests/printer/check-lpt).
CTTY AUX
ECHO GRDOS-TEST-BEGIN
ECHO == BOOT
ECHO == BOOT>LPT1
MODE LPT1 CP /STATUS
ECHO == PREPARE
ECHO == PREPARE>LPT1
MODE LPT1 CP PREPARE=((850) A:\4201.CPI)
MODE LPT1 CP /STATUS
ECHO == SELECT
ECHO == SELECT>LPT1
MODE LPT1 CP SELECT=850
MODE LPT1 CP /STATUS
ECHO == TEXT
ECHO == TEXT>LPT1
COPY A:\HELLO.TXT LPT1
ECHO == HARDWARE
ECHO == HARDWARE>LPT1
MODE LPT1 CP SELECT=437
ECHO == AGAIN
ECHO == AGAIN>LPT1
MODE LPT1 CP SELECT=850
ECHO == REFRESH
ECHO == REFRESH>LPT1
MODE LPT1 CP REFRESH
ECHO == ERRORS
ECHO == ERRORS>LPT1
MODE LPT1 CP SELECT=865
MODE LPT1 CP PREPARE=((860,865) A:\4201.CPI)
MODE LPT1 CP PREPARE=((850) A:\4208.CPI)
MODE LPT1 CP PREPARE=((999) A:\4201.CPI)
MODE LPT1 CP PREPARE=((850) A:\NOFILE.CPI)
MODE LPT1 CP /STATUS
ECHO == END>LPT1
ECHO GRDOS-TEST-END
CTTY CON
