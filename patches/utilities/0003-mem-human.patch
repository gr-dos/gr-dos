+/************************************************************************/
+/* GR-DOS: SIZEMESSAGE and HUMANSIZE, for MEM /HUMAN (issue #89).	*/
+/*									*/
+/* SizeMessage prints a summary line: in bytes with Msg_Num, as	*/
+/* before, or with /HUMAN the size as HumanSize gives it, with		*/
+/* Human_Msg_Num, which has no "bytes". Both right-align it in 10	*/
+/* columns.								*/
+/*									*/
+/* HumanSize writes a size as df -h does (gr-dos/df16): whole bytes	*/
+/* below 1 KiB ("512B", "0B"), otherwise KiB, MiB or GiB with one	*/
+/* decimal, rounded up, moving up a unit once it would show 1024.0.	*/
+/* The tenths are worked out without multiplying the remainder by 10,	*/
+/* which would overflow 32 bits for GiB.				*/
+/************************************************************************/
+
+void SizeMessage(Msg_Num,Human_Msg_Num,Size)
+int                  Msg_Num;
+int                  Human_Msg_Num;
+unsigned long int    *Size;
+{
+        char    Text[12];
+
+        if (!Human)
+                {
+                Sub1_Message(Msg_Num,STDOUT,Utility_Msg_Class,Size);
+                return;
+                }
+        HumanSize(Text,*Size);
+        sublist[1].value     = (unsigned far *)Text;
+        sublist[1].size      = Sublist_Length;
+        sublist[1].reserved  = Reserved;
+        sublist[1].id        = 1;
+        sublist[1].flags     = Char_Field_ASCIIZ+Right_Align;
+        sublist[1].max_width = 10;
+        sublist[1].min_width = 10;
+        sublist[1].pad_char  = Blank;
+
+        InRegs.x.ax = Human_Msg_Num;
+        InRegs.x.bx = STDOUT;
+        InRegs.x.cx = SubCnt1;
+        InRegs.h.dl = No_Input;
+        InRegs.h.dh = Utility_Msg_Class;
+        InRegs.x.si = (unsigned int)&sublist[1];
+        sysdispmsg(&InRegs,&OutRegs);
+        return;
+}
+
+void HumanSize(Text,Bytes)
+char                 *Text;
+unsigned long int    Bytes;
+{
+        static char     *Units[] = { "B", "KiB", "MiB", "GiB" };
+        unsigned long   Div, Whole, Rest, Tenths;
+        unsigned        Unit, Frac;
+        char            Digits[11];
+        int             n;
+
+        if (Bytes < 1024l)
+                {
+                Unit = 0;
+                Tenths = Bytes;
+                }
+        else
+                {
+                for (Unit = 1, Div = 1024l; ; Unit++, Div *= 1024l)
+                        {
+                        Whole = Bytes / Div;
+                        Rest  = Bytes % Div;
+                        /* the least Frac with Rest * 10 <= Frac * Div */
+                        for (Frac = 0; Frac < 10; Frac++)
+                                if (Rest <= (Div / 10) * Frac + (Div % 10) * Frac / 10)
+                                        break;
+                        Tenths = Whole * 10 + Frac;
+                        if (Tenths < 10240l || Unit == 3)
+                                break;
+                        }
+                }
+        n = 0;
+        do
+                {
+                Digits[n++] = (char)('0' + (int)(Tenths % 10));
+                Tenths /= 10;
+                if (Unit && n == 1)
+                        Digits[n++] = '.';
+                }
+        while (Tenths != 0 || (Unit && n < 3));
+        while (n > 0)
+                *Text++ = Digits[--n];
+        strcpy(Text,Units[Unit]);
+        return;
+}
