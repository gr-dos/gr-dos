             //if( Parse_Pass == PASS_1 ) {
             if( Parse_Pass == PASS_1 && !( flags & EXPF_NOUNDEF ) ) {
                 /* if symbol wasn't found, assume it is a forward ref! */
-                Masm5FwdRef = TRUE;
+                /* -Zj: but not the operand of TYPE, which Masm 5 makes the
+                 * constant 0 in pass one (type_op) */
+                if ( !( Options.masm5_compat && i > 0 &&
+                       tokenarray[i-1].token == T_UNARY_OPERATOR &&
