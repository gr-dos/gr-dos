@@ -1219,6 +1224,9 @@ static ret_code type_op( int oper, struct expr *opnd1, struct expr *opnd2, struc
                 break;
             }
         }
+    } else if ( Options.masm5_compat && sym && sym->state == SYM_UNDEFINED ) {
+        /* -Zj: Masm 5's TYPE of a symbol not yet defined is 0 */
+        opnd1->value = 0;
     } else if ( sym == NULL ) {
