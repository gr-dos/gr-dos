+static unsigned Masm5HashPos( const struct masm5_pos *pos )
+/*********************************************************/
+{
+    uint_32 h = pos->file * 0x9E3779B1UL;
+    h = ( h ^ pos->visit ) * 0x85EBCA77UL;
+    h = ( h ^ pos->line ) * 0xC2B2AE3DUL;
+    h = ( h ^ pos->text ) * 0x165667B1UL;
+    h = ( h ^ pos->seq ) * 0x27D4EB2FUL;
+    return( ( h ^ ( h >> 15 ) ) & ( Masm5HashSize - 1 ) );
+}
+
+static bool Masm5SamePos( const struct masm5_pos *a, const struct masm5_pos *b )
+/******************************************************************************/
+{
+    return( a->file == b->file && a->visit == b->visit && a->line == b->line &&
+           a->text == b->text && a->seq == b->seq );
+}
+
 void Masm5PassInit( void )
 /************************/
 {
-    if ( Parse_Pass == PASS_1 )
+    unsigned i;
+    unsigned h;
+
+    if ( Parse_Pass == PASS_1 ) {
         Masm5Count = 0;
-    Masm5Index = 0;
+        free( Masm5Hash );
+        Masm5Hash = NULL;
+    } else if ( Masm5Hash == NULL ) {
+        /* index the pass one sizes by position */
+        for ( Masm5HashSize = 1024; Masm5HashSize < 2 * Masm5Count; Masm5HashSize *= 2 );
+        Masm5Hash = malloc( Masm5HashSize * sizeof( *Masm5Hash ) );
+        if ( Masm5Hash == NULL )
+            Fatal( OUT_OF_MEMORY );
+        memset( Masm5Hash, -1, Masm5HashSize * sizeof( *Masm5Hash ) );
+        for ( i = 0; i < Masm5Count; i++ ) {
+            for ( h = Masm5HashPos( &Masm5Sizes[i].pos ); Masm5Hash[h] >= 0; h = ( h + 1 ) & ( Masm5HashSize - 1 ) );
+            Masm5Hash[h] = i;
+        }
+    }
+    Masm5Pos.file = (unsigned)-1;
+    Masm5LineTexts = 0;
+    Masm5Cur = -1;
+}
+
+/* called before an instruction is parsed: determine its position and, in
+ * later passes, its pass one entry.
+ */
+void Masm5Begin( const char *text )
+/*********************************/
+{
+    struct masm5_pos pos;
+    unsigned h;
+    unsigned i;
+
+    /* FNV-1a of the mnemonic, and a bit for SHORT */
+    for ( pos.text = 0x811C9DC5UL; *text && !isspace( *text ); text++ )
+        pos.text = ( pos.text ^ toupper( *text ) ) * 0x01000193UL;
+    pos.text &= ~1UL;
+    for ( ; *text; text++ )
+        if ( _memicmp( text, "SHORT", 5 ) == 0 && !is_valid_id_char( *(text+5) ) &&
+            ( !is_valid_id_char( *(text-1) ) ) ) {
+            pos.text |= 1;
+            break;
+        }
+    get_curr_srcpos( &pos.file, &pos.visit, &pos.line );
+    if ( pos.file != Masm5Pos.file || pos.visit != Masm5Pos.visit || pos.line != Masm5Pos.line )
+        Masm5LineTexts = 0;
+    for ( i = 0; i < Masm5LineTexts && Masm5LineText[i] != pos.text; i++ );
+    if ( i == Masm5LineTexts ) {
+        if ( i == MASM5_LINE_TEXTS )
+            i--; /* very long expansion: share the last slot */
+        else
+            Masm5LineTexts++;
+        Masm5LineText[i] = pos.text;
+        Masm5LineCount[i] = 0;
+    }
+    pos.seq = Masm5LineCount[i]++;
+    Masm5Pos = pos;
+    Masm5Cur = -1;
+    if ( Parse_Pass == PASS_1 || Masm5Hash == NULL )
+        return;
+    for ( h = Masm5HashPos( &pos ); Masm5Hash[h] >= 0; h = ( h + 1 ) & ( Masm5HashSize - 1 ) )
+        if ( Masm5SamePos( &Masm5Sizes[Masm5Hash[h]].pos, &pos ) ) {
+            Masm5Cur = Masm5Hash[h];
+            break;
+        }
 }
 
