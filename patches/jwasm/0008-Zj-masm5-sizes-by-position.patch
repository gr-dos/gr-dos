+ */
+void get_curr_srcpos( unsigned *file, uint_32 *visit, uint_32 *line )
+/*******************************************************************/
+{
+    struct src_item *curr;
+    for ( curr = src_stack; curr ; curr = curr->next )
+        if ( curr->type == SIT_FILE ) {
+            *file = curr->srcfile;
+            *visit = curr->visit;
+            *line = curr->line_num;
+            return;
+        }
+    *file = ModuleInfo.srcfile;
+    *visit = 0;
+    *line = 0;
+}
