JWasm: -Zj defines a variable that refers to itself before it is set

JWasm does not define X in X = X + 1 while X is undefined, so that X
stays undefined and is an error in pass two. MASM 5 defines it, the
undefined part counting as 0. Under -Zj, in pass one, a variable whose
only undefined operand is itself is defined in that way.

Needed for ASSIGN's and NLSFUNC's own SaveReg and RestoreReg, which count
?stackdepth = ?stackdepth + 1 without DOSMAC.INC's ?stackdepth = 0.

diff --git a/src/equate.c b/src/equate.c
index 73c58c8..b247b77 100644
--- a/src/equate.c
+++ b/src/equate.c
@@ -181,6 +181,19 @@ static struct asym *CreateAssemblyTimeVariable( struct asm_tok tokenarray[] )
 #if FASTPASS
                 if ( StoreState == FALSE ) FStoreLine( FSL_NOCMT ); /* make sure this line is evaluated in pass two */
 #endif
+                /* -Zj: Masm 5 defines a variable that refers to itself before
+                 * any value is given to it (ASSIGN's and NLSFUNC's SaveReg,
+                 * ?stackdepth = ?stackdepth + 1, without DOSMAC.INC's
+                 * ?stackdepth = 0), the undefined part counting as 0. */
+                if ( Options.masm5_compat && Parse_Pass == PASS_1 && opnd.kind == EXPR_ADDR &&
+                    opnd.mbr == NULL && opnd.sym->name_size == strlen( name ) &&
+                    SymCmpFunc( opnd.sym->name, name, opnd.sym->name_size ) == 0 ) {
+                    opnd.kind = EXPR_CONST;
+                    opnd.sym = NULL;
+                    opnd.mem_type = MT_EMPTY;
+                    opnd.hlvalue = 0;
+                    goto define;
+                }
             } else
                 EmitError( CONSTANT_EXPECTED );
             return( NULL );
@@ -196,6 +209,7 @@ static struct asym *CreateAssemblyTimeVariable( struct asm_tok tokenarray[] )
             goto check_number;
     }
 
+define:
     sym = SymSearch( name );
     if( sym == NULL || sym->state == SYM_UNDEFINED ) {
         if( sym == NULL ) {
