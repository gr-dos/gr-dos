+         * call sysloadmsg) */
+        if ( Options.masm5_compat && CodeInfo->token == T_CALL &&
+            CodeInfo->mem_type == MT_EMPTY && sym->mem_type == MT_FAR )
+            CodeInfo->mem_type = MT_FAR;
         /* v1.94: if a segment override is active,
          check if it's matching the assumed value of CS.
          If no, assume a FAR call.
@@ -413,7 +419,7 @@ ret_code process_branch( struct code_info *CodeInfo, unsigned CurrOpnd, const st
      * Masm does NOT optimize if destination is external!
