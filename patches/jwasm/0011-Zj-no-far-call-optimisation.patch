@@ -272,6 +272,12 @@ ret_code process_branch( struct code_info *CodeInfo, unsigned CurrOpnd, const st
             sym->offset < GetCurrOffset() &&
             (int_32)sym->offset - (int_32)( GetCurrOffset() + 2 ) < SCHAR_MIN )
             CodeInfo->mem_type = MT_FAR;
+        /* -Zj: nor a "far call optimisation" (PUSH CS, CALL near): a CALL to
