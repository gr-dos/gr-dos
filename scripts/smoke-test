#!/usr/bin/env perl

use 5.042;
use warnings;
use Time::HiRes qw( sleep time );

# ABSTRACT: Boot a GR-DOS image in headless QEMU and check its serial output

=head1 SYNOPSIS

 scripts/smoke-test [--timeout SECONDS] [--expect FILE]... [--drive-b IMAGE] [--keys FILE]
   IMAGE EXPECT OUTDIR

=head1 DESCRIPTION

Boots the floppy image C<IMAGE> in headless C<qemu-system-i386> with COM1
written to F<OUTDIR/serial.log> (decision 13).  C<IMAGE> is not changed:
QEMU writes to a snapshot.  With C<--drive-b>, the image given is the second
floppy drive, B:, and is written to: it is for the tests of FORMAT, SYS and
DISKCOPY, and must be a disposable copy.  The image's F<AUTOEXEC.BAT>
reports to C<AUX>, and ends with the line C<GRDOS-TEST-END>.  QEMU is
stopped when that line arrives, or after C<--timeout> seconds (default 60),
since DOS keeps running at the prompt.

The serial output, without carriage returns, is printed and saved as
F<OUTDIR/serial.txt>, and the QEMU version as F<OUTDIR/qemu.version>.  The
file C<EXPECT> holds one Perl regular expression per line (blank lines and
lines starting with C<#> are ignored); each must match a line of the output,
in order.  Each C<--expect> FILE is checked against the output in the same
way, on its own: F<tests/smoke/expect-1200k>, for example, holds the free
space C<DIR> reports on a 1.2 MB disk.  Exits non-zero if any pattern is
not found.

With C<--keys>, COM1 has input too, for a program that reads its keys
from C<AUX> under C<CTTY AUX>, as MORE does (F<tests/more>).  C<FILE>'s
first line is the prompt, and each further line is the bytes to send, as
the contents of a Perl double-quoted string (C<\x00;> is an extended key,
C<\r> Enter).  When the output ends with the nth prompt, the nth line is
sent, the list starting again after its last.  A key can be lost, if DOS
reads it (its ^C check does) before the program flushes its input, as
MORE does with INT 21h function 0Ch; so if the program writes nothing in
the next two seconds, the key is sent again.

=cut

my $end_marker = 'GRDOS-TEST-END';

sub slurp ($path) {
  open my $fh, '<:raw', $path or return '';
  local $/;
  return scalar <$fh>;
}

sub boot ($image, $drive_b, $outdir, $timeout, $keys) {
  my $serial = "$outdir/serial.log";
  my $input  = "$outdir/serial.in";
  unlink $serial, $input;
  my @serial = (-serial => "file:$serial");
  my $in;
  if($keys) {
    require POSIX;
    POSIX::mkfifo($input, 0600) or die "mkfifo $input: $!";
    @serial = (-chardev => "file,id=com1,path=$serial,input-path=$input", -serial => 'chardev:com1');
  }
  my @cmd = (
    'qemu-system-i386',
    -display => 'none',
    -m       => 4,
    '-no-reboot',
    -drive   => "file=$image,if=floppy,index=0,format=raw,snapshot=on",
    (defined $drive_b ? (-drive => "file=$drive_b,if=floppy,index=1,format=raw") : ()),
    -boot    => 'a',
    @serial,
    -monitor => 'none',
  );

  my $pid = fork // die "fork: $!";
  if($pid == 0) {
    open STDOUT, '>', "$outdir/qemu.log" or die "unable to write $outdir/qemu.log: $!";
    open STDERR, '>&', \*STDOUT or die "dup: $!";
    exec @cmd or die "exec qemu-system-i386: $!";
  }

  # Read and write, so that the open does not wait for QEMU's.
  if($keys) {
    open $in, '+<:raw', $input or die "unable to open $input: $!";
    $in->autoflush(1);
  }

  my $deadline = time + $timeout;
  my $finished = 0;
  my($sent_for, $sent_at, $sent_length) = (0);
  while(time < $deadline) {
    my $out = slurp($serial);
    if($out =~ /^\Q$end_marker\E\r?$/m) {
      $finished = 1;
      last;
    }
    # The nth prompt, waiting for its key, gets the nth.
    if($keys && $out =~ /\Q$keys->{prompt}\E\z/) {
      my $prompts = () = $out =~ /\Q$keys->{prompt}\E/g;
      my $key = $keys->{keys}[($prompts - 1) % $keys->{keys}->@*];
      if($sent_for != $prompts) {
        sleep 0.25;
        print $in $key;
        ($sent_for, $sent_at, $sent_length) = ($prompts, time, length $out);
      } elsif(length $out == $sent_length && time - $sent_at > 2) {
        print $in $key;
        $sent_at = time;
      }
    }
    last if waitpid($pid, 1) == $pid;   # QEMU exited early
    sleep 0.1;
  }
  kill 'TERM', $pid;
  waitpid $pid, 0;
  if($keys) {
    close $in;
    unlink $input;
  }
  warn "smoke-test: no $end_marker within $timeout seconds\n" unless $finished;
  return slurp($serial) =~ s/\r//gr;
}

# Match each pattern of the file $expect against a line of @$lines, in
# order; returns 1 if any is not found.
sub check ($lines, $expect) {
  my $at = 0;
  my $failed = 0;
  for my $pattern (grep { /\S/ && !/^#/ } split /\n/, slurp($expect)) {
    my $re = qr/$pattern/;
    my $found;
    for my $i ($at .. $lines->$#*) {
      if($lines->[$i] =~ $re) {
        $found = $i;
        last;
      }
    }
    if(defined $found) {
      $at = $found + 1;
    } else {
      say "smoke-test: not found in $expect: $pattern";
      $failed = 1;
    }
  }
  return $failed;
}

sub main (@args) {
  my $timeout = 60;
  my(@also, $drive_b, $keys);
  while(@args && $args[0] =~ /^--(timeout|expect|drive-b|keys)$/) {
    shift @args;
    die "$0: --$1 needs a value\n" unless @args;
    if($1 eq 'timeout') {
      $timeout = shift @args;
    } elsif($1 eq 'drive-b') {
      $drive_b = shift @args;
    } elsif($1 eq 'keys') {
      my $file = shift @args;
      my($prompt, @keys) = grep { length } split /\n/, slurp($file);
      die "$file: no prompt, or no keys\n" unless defined $prompt && @keys;
      $keys = { prompt => $prompt, keys => [ map { eval qq{"$_"} // die "$file: $@" } @keys ] };
    } else {
      push @also, shift @args;
    }
  }
  die "usage: $0 [--timeout SECONDS] [--expect FILE]... [--drive-b IMAGE] [--keys FILE] IMAGE EXPECT OUTDIR\n"
    unless @args == 3;
  my($image, $expect, $outdir) = @args;
  -r $_ or die "unable to read $_\n" for $expect, @also;
  die "unable to write $drive_b\n" if defined $drive_b && !-w $drive_b;
  mkdir $outdir unless -d $outdir;

  my $version = `qemu-system-i386 --version`;
  die "qemu-system-i386 not found\n" unless $? == 0;
  open my $fh, '>', "$outdir/qemu.version" or die "unable to write $outdir/qemu.version: $!";
  print $fh $version;
  close $fh;
  print $version =~ /^(.*)$/m;
  print "\n";

  my $output = boot($image, $drive_b, $outdir, $timeout, $keys);
  open $fh, '>', "$outdir/serial.txt" or die "unable to write $outdir/serial.txt: $!";
  print $fh $output;
  close $fh;
  print $output;

  my @lines = split /\n/, $output;
  my $failed = 0;
  $failed |= check(\@lines, $_) for $expect, @also;
  say $failed ? 'smoke-test: FAILED' : 'smoke-test: passed';
  return $failed;
}

exit main(@ARGV);
