#!/usr/bin/env perl

use 5.042;
use warnings;
use List::Util qw( first pairkeys pairvalues );

# ABSTRACT: Check that a FAT12 floppy image can boot GR-DOS

=head1 SYNOPSIS

 scripts/check-image [--format 1440|1200|720|360] IMAGE IO.SYS MSDOS.SYS

=head1 DESCRIPTION

Checks the layout the MS-DOS 4.00 boot sector and MSLOAD depend on
(decision 12):

=over 4

=item *

the image size and the BPB match the floppy format given by C<--format>, the
size in KB (see L</FORMATS>). Without C<--format> the format is chosen by the
image size;

=item *

the boot sector ends with C<55AAh> and its physical drive number (offset
C<24h>) is C<00h>;

=item *

the first two root directory entries are F<IO.SYS> and F<MSDOS.SYS>, with
the system attribute, and their contents are the given files;

=item *

F<IO.SYS> starts at the first cluster of the data area and both files
occupy contiguous clusters, F<MSDOS.SYS> directly after F<IO.SYS>.

=back

Dies with a description of the first problem found.

=head1 FORMATS

The BPB of each format is the one DOS FORMAT writes, with 512-byte sectors,
one reserved sector, two FATs and two heads:

 format  disk        bytes      cylinders  sectors  cluster  root  media  FAT
 1440    3.5" HD     1,474,560  80         18       1        224   F0h    9
 1200    5.25" HD    1,228,800  80         15       1        224   F9h    7
 720     3.5" DD       737,280  80          9       2        112   F9h    3
 360     5.25" DD      368,640  40          9       2        112   FDh    2

(sectors per track, sectors per cluster, root directory entries, media
byte and sectors per FAT).

=cut

my %common = (bps => 512, reserved => 1, nfats => 2, heads => 2);

my %formats = (
  1440 => { %common, sectors => 2880, spc => 1, nroot => 224, media => 0xf0, spf => 9, spt => 18 },
  1200 => { %common, sectors => 2400, spc => 1, nroot => 224, media => 0xf9, spf => 7, spt => 15 },
  720  => { %common, sectors => 1440, spc => 2, nroot => 112, media => 0xf9, spf => 3, spt => 9 },
  360  => { %common, sectors => 720,  spc => 2, nroot => 112, media => 0xfd, spf => 2, spt => 9 },
);

# BPB fields from offset 0Bh, in order, and their unpack templates.
my @bpb = (
  bps => 'v', spc => 'C', reserved => 'v', nfats => 'C', nroot => 'v',
  sectors => 'v', media => 'C', spf => 'v', spt => 'v', heads => 'v',
);

sub slurp ($path) {
  open my $fh, '<:raw', $path or die "unable to read $path: $!";
  local $/;
  return scalar <$fh>;
}

# Cluster $n of a FAT12 table.
sub fat12 ($fat, $n) {
  my $word = unpack 'v', substr($fat, int($n * 3 / 2), 2);
  return $n & 1 ? $word >> 4 : $word & 0xfff;
}

sub main (@args) {
  my $usage = "usage: $0 [--format 1440|1200|720|360] IMAGE IO.SYS MSDOS.SYS\n";
  my $format;
  if(@args && $args[0] eq '--format') {
    shift @args;
    $format = shift @args;
    die "$0: --format must be one of @{[ sort { $b <=> $a } keys %formats ]}\n"
      unless defined $format && $formats{$format};
  }
  die $usage unless @args == 3;
  my($path, @expect) = @args;
  my $img = slurp($path);

  $format //= first { $formats{$_}->{sectors} * 512 == length $img } sort keys %formats;
  die sprintf "%s: %d bytes is not a supported floppy size\n", $path, length $img
    unless defined $format;
  my $geometry = $formats{$format};
  die sprintf "%s: %d bytes, not %d for a %s image\n", $path, length $img,
    $geometry->{sectors} * 512, $format
    unless length $img == $geometry->{sectors} * 512;

  die "$path: no boot signature\n" unless substr($img, 510, 2) eq "\x55\xaa";
  my $drive = ord substr($img, 0x24, 1);
  die sprintf "%s: boot drive number is %02Xh, not 00h\n", $path, $drive if $drive;

  my @names = pairkeys @bpb;
  my %got;
  @got{@names} = unpack join(' ', pairvalues @bpb), substr($img, 11, 19);
  for my $name (@names) {
    die sprintf "%s: BPB %s is %d, not %d for a %s image\n", $path, $name, $got{$name},
      $geometry->{$name}, $format
      unless $got{$name} == $geometry->{$name};
  }
  my($bps, $spc, $reserved, $nfats, $nroot, $spf) = @got{qw( bps spc reserved nfats nroot spf )};
  my $fat = substr $img, $reserved * $bps, $spf * $bps;
  die sprintf "%s: FAT media byte is %02Xh, not %02Xh\n", $path, ord $fat, $geometry->{media}
    unless ord $fat == $geometry->{media};
  my $root_at = ($reserved + $nfats * $spf) * $bps;
  my $data_at = $root_at + $nroot * 32;
  my $cluster_bytes = $spc * $bps;

  my $next = 2;
  for my $i (0, 1) {
    my $entry = substr $img, $root_at + 32 * $i, 32;
    my($name, $attr, $start, $size) = unpack 'a11 C x14 v V', $entry;
    my $want = $i ? 'MSDOS   SYS' : 'IO      SYS';
    die "$path: root directory entry $i is '$name', not '$want'\n" unless $name eq $want;
    die "$path: $want has no system attribute\n" unless $attr & 0x04;
    die "$path: $want starts at cluster $start, not $next\n" unless $start == $next;

    my $clusters = int(($size + $cluster_bytes - 1) / $cluster_bytes);
    my $c = $start;
    for my $k (1 .. $clusters) {
      my $link = fat12($fat, $c);
      if($k == $clusters) {
        die "$path: $want does not end after $clusters clusters\n" unless $link >= 0xff8;
      } else {
        die "$path: $want is not contiguous at cluster $c\n" unless $link == $c + 1;
      }
      $c++;
    }

    my $data = substr $img, $data_at + ($start - 2) * $cluster_bytes, $size;
    die "$path: $want differs from $expect[$i]\n" unless $data eq slurp($expect[$i]);
    $next = $start + $clusters;
  }
  return 0;
}

exit main(@ARGV);
