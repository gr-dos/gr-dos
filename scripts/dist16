#!/usr/bin/env perl

use 5.042;
use warnings;
use Cwd qw( realpath );
use Digest::SHA qw( sha256_hex );
use File::Basename qw( dirname );
use File::Copy qw( copy );
use File::Path qw( make_path remove_tree );
use File::Temp qw( tempdir );
use Getopt::Long qw( GetOptionsFromArray );
use Archive::Tar ();
use IO::Uncompress::Gunzip ();
use IO::Uncompress::Unzip ();
use JSON::PP ();

# ABSTRACT: Find, pin and fetch the *16 programs of the full distribution

=head1 SYNOPSIS

 scripts/dist16 [OPTIONS] resolve      # GitHub -> dist16/lock, with a report
 scripts/dist16 [OPTIONS] check        # is dist16/lock what resolve would write?
 scripts/dist16 [OPTIONS] fetch DEST   # dist16/lock -> DEST, verified
 scripts/dist16 [OPTIONS] list         # the DOS file names, in the lock's order
 scripts/dist16 [OPTIONS] notices DEST # each program's provenance and license
 scripts/dist16 [OPTIONS] bin-list     # README.txt lines for the ZIP's BIN
 scripts/dist16 [OPTIONS] sources      # README.txt's corresponding source section
 scripts/dist16 [OPTIONS] check-dist DIR DEST  # the ZIP's tree or the CF files: source, licenses

=head1 DESCRIPTION

GR-DOS's full distribution (C:\DOS and the release ZIP) includes the DOS
programs of the GitHub repositories whose names end in C<16> (issue #36),
found on GitHub, not named here, with the exceptions and additions in
F<dist16/config>.

C<resolve> lists the repositories, takes each one's latest release (or
the tag the config pins), chooses its program, downloads it and its
license, checks them, and writes F<dist16/lock>: one C<program> line per
program, pinning the release, its commit, the asset, its SHA-256 and the
license's, and one C<skip> line per repository left out, with why. It
prints what it included, excluded, found unavailable, or failed to
validate. It writes nothing if GitHub cannot be read, or a C<required>
repository fails: a partial lock would drop programs silently.

The build reads only the lock. C<fetch> downloads each program and license
the lock names, from the release and the commit it pins, into the cache
(F<build/tools/dist16>), checks their SHA-256 against the lock, and copies
them to F<DEST> as DOS names (and F<DEST/licenses>). A verified cache is
not downloaded again, so a rebuild needs no network. So the distribution
changes only when the lock does, in a reviewed change; C<check> shows what
a new C<resolve> would change.

=head2 dist16/config

One directive a line; C<#> starts a comment.

=over 4

=item discover OWNER SUFFIX

Every public repository of the GitHub user or organization OWNER whose
name ends in SUFFIX. Forks and archived repositories are left out, and so
are libraries: a repository whose name (not its owner's) matches
C<lib*16>, in any case, such as gr-dos/libc16, is excluded, with the
reason C<library repository (lib*16 convention), not a DOS executable>.
This is only about shipping the library as a program: its source, as a
program's C<depends> (F<dist16.source>), is resolved and shipped as before.

=item exclude OWNER/NAME REASON

Leave a repository out; the reason is required, and is in the lock.

=item include OWNER/NAME [tag=TAG] [asset=FILE | prefer=com|exe] [license-asset=FILE] [required]

Add a repository from any owner, or set options for a discovered one;
it is then not excluded as a library (C<lib*16>).
C<tag=> pins a release instead of the latest; C<asset=> names the release
asset to ship; C<prefer=> chooses between a release's F<STEM.com> and
F<STEM.exe> (issue #42), overriding C<prefer>, below; C<asset=> and
C<prefer=> together are an error; C<license-asset=> names the release's
asset that is the program's license notice, which is shipped beside it as
F<STEM.LIC> (issue #37, below); C<required> makes C<resolve> fail, not
skip it, if it cannot be included. An include overrides fork and archived. A repository
both included and excluded is an error.

A C<license-asset=> is for a project whose release gives the program's
license notice as an asset of its own, to go with the executable, such
as plicease/sprocket's F<sprocket-exe-license.txt>. The asset is checked
against GitHub's size and digest like the program, and must be the
license file GitHub finds at the release's commit, byte for byte, so the
notice in the ZIP's README is the one the project ships. The lock pins it
on a C<license-asset> line after the program's; C<fetch> stages it as the
program's name with F<.LIC> for its extension (F<SPROCKET.LIC>), which
goes in C:\DOS and the ZIP's F<BIN> after the program, and C<check-dist>
checks it there.

=item prefer com|exe

Which program to ship when a release has both a F<STEM.com> and a
F<STEM.exe>, for every repository without its own C<prefer=> or
C<asset=>. The default is C<exe>, the C reference build. With C<com>, a
release with no F<.com> ships its F<.exe>. The report says which was
chosen, and why.

=item license SPDX...

The permissive licenses a program may have (GitHub's SPDX identifiers),
which require only that their notice is kept.

=item license-override OWNER/NAME SPDX PATH sha256=HEX [notice=PATH...]

GitHub's license detector does not know every license: it reports
C<NOASSERTION> for the Tcl license (C<TCL>), for one (issue #83). This
takes SPDX, which must be one of the C<license>s, as the license of the
one repository OWNER/NAME, and only when, at the commit of the release
C<resolve> takes, GitHub reports C<NOASSERTION> for the file PATH, and
that file's bytes have the SHA-256 HEX. Anything else fails, as without
it: another file, other bytes (a changed license, or a newer release's),
none, or another repository. A license GitHub does recognize is not
overridden, and if GitHub reports SPDX itself, the program fails until
the override is removed. Each C<notice=> is a further notice the license
names, which must be at the same commit, and is shipped with the
license. The lock has an C<override> line after the program's, and the
report says the license is the override's, not GitHub's. A program in
the lock under the override's SPDX must have that line, and its
notices, or the lock is refused.

=item source-license SPDX...

The licenses a program may have that also require its corresponding
source to be available, such as C<GPL-2.0-or-later> and
C<GPL-1.0-or-later> (issue #56). A
program under one needs a F<dist16.source> manifest, below.

=back

=head2 dist16.source

GitHub reports a license's family (C<GPL-2.0>), not whether it is C<-only>
or C<-or-later>, nor where the source is. So a program whose license
GitHub finds to be one of the C<source-license> families must have a
F<dist16.source> file at its release's commit, one directive a line:

 license GPL-2.0-or-later        # the exact SPDX identifier, in source-license
 source patch16-0.01-src.tar.gz  # the release's asset of the complete source
 build BUILDING.md               # how to build it, a file in that archive
 notice AUTHORS                  # further notices to keep (any number)
 depends gr-dos/libc16 v0.07 libc16-0.07-src.zip
                                 # a library linked into the program: its
                                 # release, and that release's source asset

The source archive (F<.zip>, F<.tar.gz> or F<.tgz>) must hold, under one
top directory or none, the same F<dist16.source> and license file as the
commit, and the build file, so it is the source of that release. Each
C<depends> archive must hold its release's license file. Each is pinned,
by size and SHA-256, in the lock, fetched with the program, and shipped:
in the release ZIP's F<SOURCE> directory, and described, with the license
texts, in F<SOURCES.TXT> (C:\DOS and the ZIP's F<BIN>). A program under a
source license may not contain Open Watcom's C runtime, which is not
covered by its manifest.

=head2 The release contract

A repository's program is the asset of its release named F<STEM.exe> or
F<STEM.com>, where STEM is the repository name with or without the suffix
(F<crcsum16>: F<crcsum.exe> or F<crcsum16.exe>). With both, the F<.exe>,
the C reference of the gr-dos/hello16 conventions, is shipped, unless
C<prefer> chooses the F<.com>. Other
assets are ignored. The program must have an 8.3 name that is not one of
GR-DOS's own (C<--reserved>), nor another program's, ignoring the
extension, since COMMAND.COM would run only one of them; be a real-mode
DOS program (an F<.exe> must have an MZ header and no NE, LE, LX or PE
header or 32-bit extender; a F<.com> must fit in its 64 KB segment); match
the size and SHA-256 GitHub gives; and have a license file at the
release's commit, under one of the configured licenses (and with a
F<dist16.source> under a source license).

=head1 OPTIONS

=over 4

=item --config FILE, --lock FILE

Default F<dist16/config> and F<dist16/lock>.

=item --reserved "NAME ..."

GR-DOS's own file names (the Makefile passes them).

=item --cache DIR

Default F<build/tools/dist16>.

=item --api URL, --github URL, --raw URL

Default C<https://api.github.com>, C<https://github.com> and
C<https://raw.githubusercontent.com>. A C<file://> URL reads a directory
instead (the tests): a C<?> in a path is C<@> in the file name, a path
that is a directory is its F<index> file, a missing file is a 404, and
F<PATH.status> holds another HTTP status.

=back

The GitHub API token is C<GH_TOKEN> or C<GITHUB_TOKEN>, or C<gh auth
token>; without one, GitHub allows 60 requests an hour.

=cut

my $root = realpath(dirname(dirname(__FILE__)));
my %opt = (
  config => "$root/dist16/config",
  lock   => "$root/dist16/lock",
  cache  => "$root/build/tools/dist16",
  api    => 'https://api.github.com',
  github => 'https://github.com',
  raw    => 'https://raw.githubusercontent.com',
  reserved => '',
);
my $json = JSON::PP->new->canonical;
my $tmp;

# The lock's program fields, in order, and those of the lines that follow
# a program under a source license.
my @FIELDS = qw( repo tag commit asset name size sha256 spdx license license_sha256 );
my @SOURCE = qw( repo asset size sha256 build );
my @NOTICE = qw( repo path sha256 );
my @DEPEND = qw( repo dep tag commit asset size sha256 spdx license license_sha256 );
# After a program whose license is a license-override's (issue #83): what
# GitHub reported, and the file and SHA-256 the override pins.
my @OVERRIDE = qw( repo github spdx license sha256 );
# Right after a program whose include has license-asset= (issue #37): the
# release's license notice asset, and its DOS name.
my @LICENSE_ASSET = qw( repo asset name size sha256 );

# A license-asset's DOS name: the program's, with this extension.
sub lic_name ($name) { base($name) . '.LIC' }

# A program under a source license has this at its release's commit.
my $MANIFEST = 'dist16.source';

# A repository whose name is lib*16, any case, is a library, not a
# program: it is excluded from discovery with this reason.
my $LIBRARY_RE = qr/^lib.*16$/i;
my $LIBRARY_REASON = 'library repository (lib*16 convention), not a DOS executable';

sub is_library ($repo) { ($repo =~ m{([^/]+)$})[0] =~ $LIBRARY_RE }

# Where the build stages the source description, beside the programs; no
# program may have its name.
my $SOURCES = 'SOURCES.TXT';

sub slurp ($path) {
  open my $fh, '<:raw', $path or die "$path: $!\n";
  local $/;
  return scalar <$fh>;
}

sub spew ($path, $data) {
  open my $fh, '>:raw', "$path.tmp" or die "$path.tmp: $!\n";
  print $fh $data;
  close $fh or die "$path.tmp: $!\n";
  rename "$path.tmp", $path or die "$path: $!\n";
}

# HTTP: (status, body). A file:// URL reads the test fixtures.
my $token;
sub token () {
  return $token if defined $token;
  $token = $ENV{GH_TOKEN} // $ENV{GITHUB_TOKEN} // '';
  if($token eq '' && grep { -x "$_/gh" } split /:/, $ENV{PATH} // '') {
    $token = `gh auth token 2>/dev/null` // '';
    chomp $token;
  }
  return $token;
}

sub get ($url, $api = 0) {
  if($url =~ m{^file://(.*)}) {
    my $path = $1 =~ tr/?/@/r;
    $path .= '/index' if -d $path;
    if(-e "$path.status") {
      my($status) = slurp("$path.status") =~ /(\d+)/;
      return ($status, '') if $status != 200;
    }
    return (404, '') unless -f $path;
    return (200, slurp($path));
  }
  $tmp //= tempdir('dist16-XXXXXX', TMPDIR => 1, CLEANUP => 1);
  my @headers;
  if($api) {
    open my $h, '>', "$tmp/headers" or die "$tmp/headers: $!\n";
    print $h "Accept: application/vnd.github+json\nX-GitHub-Api-Version: 2022-11-28\n";
    print $h "Authorization: Bearer ", token(), "\n" if token() ne '';
    close $h;
    @headers = ('-H', "\@$tmp/headers");
  }
  unlink "$tmp/body";
  open my $curl, '-|', 'curl', '-sS', '-L', '--retry', '2', '-o', "$tmp/body", '-w', '%{http_code}', @headers, $url
    or die "curl: $!\n";
  my $status = do { local $/; <$curl> };
  close $curl;
  die "cannot reach $url (curl exit @{[ $? >> 8 ]})\n" if $? != 0 || $status !~ /^[1-9]\d\d$/;
  return ($status, -f "$tmp/body" ? slurp("$tmp/body") : '');
}

# The GitHub API: the decoded JSON, or undef for a 404. Anything else
# stops resolve, since a partial lock would drop programs.
sub api ($path) {
  my($status, $body) = get("$opt{api}$path", 1);
  return undef if $status == 404;
  if($status == 403 || $status == 429) {
    die "GitHub API $path: HTTP $status: rate limited or forbidden"
      . (token() eq '' ? ' (no token: set GH_TOKEN, or log in with gh)' : '') . "\n";
  }
  die "GitHub API $path: HTTP $status\n" unless $status == 200;
  my $data = eval { $json->decode($body) };
  die "GitHub API $path: malformed JSON\n" unless ref $data;
  return $data;
}

sub read_config ($path) {
  my %c = (discover => [], exclude => {}, include => {}, license => {}, source_license => {}, override => {}, order => [], prefer => 'exe');
  my $prefer_line;
  my $n = 0;
  for my $line (split /\n/, slurp($path)) {
    $n++;
    $line =~ s/#.*//;
    my @w = split ' ', $line;
    next unless @w;
    my $where = "$path:$n";
    my $cmd = shift @w;
    my $repo_re = qr{^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$};
    if($cmd eq 'discover') {
      die "$where: discover OWNER SUFFIX\n" unless @w == 2 && $w[0] =~ /^[A-Za-z0-9-]+$/;
      push $c{discover}->@*, [@w];
    } elsif($cmd eq 'exclude') {
      die "$where: exclude OWNER/NAME REASON (the reason is required)\n" unless @w >= 2 && $w[0] =~ $repo_re;
      my $key = lc shift @w;
      die "$where: $key is excluded twice\n" if $c{exclude}{$key};
      $c{exclude}{$key} = "@w";
    } elsif($cmd eq 'include') {
      die "$where: include OWNER/NAME [tag=TAG] [asset=FILE | prefer=com|exe] [license-asset=FILE] [required]\n" unless @w && $w[0] =~ $repo_re;
      my $repo = shift @w;
      die "$where: $repo is included twice\n" if $c{include}{lc $repo};
      my %i = (repo => $repo);
      for (@w) {
        if(/^(tag|asset)=(\S+)$/) { $i{$1} = $2 }
        elsif(/^license-asset=([\w.+-]+)$/) { $i{license_asset} = $1 }
        elsif(/^license-asset=/) { die "$where: $_: license-asset= is the name of a release asset\n" }
        elsif(/^prefer=(com|exe)$/) { $i{prefer} = $1 }
        elsif(/^prefer=/) { die "$where: $_: prefer= is com or exe\n" }
        elsif($_ eq 'required') { $i{required} = 1 }
        else { die "$where: unknown include option $_\n" }
      }
      die "$where: $repo has both asset= and prefer=: asset= names the program, so prefer= would do nothing\n"
        if defined $i{asset} && defined $i{prefer};
      die "$where: $repo: license-asset= names the program asset=\n"
        if defined $i{asset} && defined $i{license_asset} && $i{asset} eq $i{license_asset};
      $c{include}{lc $repo} = \%i;
    } elsif($cmd eq 'prefer') {
      die "$where: prefer com|exe\n" unless @w == 1 && $w[0] =~ /^(com|exe)$/;
      die "$where: prefer is set twice (first at $prefer_line)\n" if $prefer_line;
      $prefer_line = $where;
      $c{prefer} = $w[0];
    } elsif($cmd eq 'license') {
      die "$where: license SPDX...\n" unless @w;
      $c{license}{$_} = 1 for @w;
    } elsif($cmd eq 'license-override') {
      my $usage = "$where: license-override OWNER/NAME SPDX PATH sha256=HEX [notice=PATH...]\n";
      die $usage unless @w >= 4 && $w[0] =~ $repo_re && $w[1] =~ /^[\w.+-]+$/;
      my($repo, $spdx, $lpath, $sum, @more) = @w;
      die "$where: $repo has two license-overrides\n" if $c{override}{lc $repo};
      die "$where: $lpath is not a path in the repository\n" unless safe_path($lpath);
      my($sha) = $sum =~ /^sha256=([0-9a-f]{64})$/ or die "$where: $sum: the license file's SHA-256 is sha256= and 64 lowercase hex digits\n";
      die "$where: NOASSERTION is not a license to override with\n" if $spdx eq 'NOASSERTION';
      my @notices;
      for (@more) {
        my($n) = /^notice=(.+)$/ or die "$where: unknown license-override option $_\n";
        die "$where: $n is not a path in the repository\n" unless safe_path($n) && $n ne $lpath;
        push @notices, $n;
      }
      $c{override}{lc $repo} = { repo => $repo, spdx => $spdx, license => $lpath, sha256 => $sha, notices => \@notices, where => $where };
    } elsif($cmd eq 'source-license') {
      die "$where: source-license SPDX...\n" unless @w;
      for (@w) {
        die "$where: $_ is not a license with a version (such as GPL-2.0-or-later)\n" if spdx_base($_) eq $_;
        $c{source_license}{$_} = 1;
      }
    } else {
      die "$where: unknown directive $cmd\n";
    }
  }
  for my $key (sort keys $c{include}->%*) {
    die "$path: $c{include}{$key}{repo} is both included and excluded\n" if exists $c{exclude}{$key};
  }
  die "$path: no license directive\n" unless %{ $c{license} };
  for my $spdx (sort keys $c{source_license}->%*) {
    die "$path: $spdx is both a license and a source-license\n" if $c{license}{$spdx} || $c{license}{spdx_base($spdx)};
  }
  # An override is only to a permissive license the config allows anyway,
  # so it never decides whether source is shipped.
  for my $o (map { $c{override}{$_} } sort keys $c{override}->%*) {
    die "$o->{where}: $o->{spdx} is not a license dist16/config allows (license)\n" unless $c{license}{$o->{spdx}};
  }
  return \%c;
}

# A license without its -only or -or-later: GitHub reports GPL-2.0 for the
# text of the GPL version 2 (GPL-1.0 for version 1's), whichever the
# program is under.
sub spdx_base ($spdx) { $spdx =~ s/(-only|-or-later|\+)$//r }

# The source licenses of a family GitHub reports.
sub source_licenses ($c, $spdx) { grep { spdx_base($_) eq $spdx } sort keys $c->{source_license}->%* }

sub reserved () {
  my %r;
  $r{base($_)} = $_ for map { uc } split /[\s,]+/, $opt{reserved};
  delete $r{''};
  $r{base($SOURCES)} //= "$SOURCES (dist16's)";
  return \%r;
}

sub base ($name) { $name =~ s/\.[^.]*$//r }

# Why an asset is not a real-mode DOS program, or undef if it is one.
sub not_dos ($name, $data) {
  my $size = length $data;
  if($name =~ /\.com$/i) {
    return "$name is $size bytes, too big for a .COM" if $size > 0xFF00;
    return undef;
  }
  my $sig = substr($data, 0, 2);
  return "$name has no MZ header" unless $size >= 28 && ($sig eq 'MZ' || $sig eq 'ZM');
  my($last, $pages, undef, $hdr) = unpack 'v4', substr($data, 2, 8);
  my $image = $pages * 512 - ($last ? 512 - $last : 0);
  return "$name has a malformed MZ header" if $pages == 0 || $hdr * 16 > $image || $image > $size;
  my $reloc = unpack 'v', substr($data, 0x18, 2);
  if($reloc >= 0x40 && $size >= 0x40) {
    my $new = unpack 'V', substr($data, 0x3C, 4);
    if($new >= 0x40 && $new + 2 <= $size && substr($data, $new, 2) =~ /^(NE|LE|LX|PE)$/) {
      return "$name is a $1 program, not a real-mode DOS one";
    }
  }
  # A DOS extender's stub, and the 32-bit program after it.
  if($image + 2 <= $size && unpack('v', substr($data, $image, 2)) == 0x014C) {
    return "$name is a 32-bit (COFF) program behind a DOS stub";
  }
  for my $x ('DOS/4G', 'CWSDPMI', 'go32stub', 'PMODE/W', 'DOS32A') {
    return "$name needs a 32-bit DOS extender ($x)" if index($data, $x) >= 0;
  }
  return undef;
}

sub valid_83 ($name) { $name =~ /^[A-Z0-9_\$~!#%&'(){}^@`-]{1,8}\.(COM|EXE)$/ }

# Resolve the config against GitHub: (results, notes). Each result is a
# hash with kind included, excluded, unavailable or failed.
sub resolve_all ($c) {
  my(%repos, @notes);
  for my $d ($c->{discover}->@*) {
    my($owner, $suffix) = @$d;
    my $found = 0;
    for(my $page = 1; ; $page++) {
      my $list = api("/users/$owner/repos?per_page=100&page=$page")
        // die "GitHub has no user or organization $owner\n";
      die "GitHub API /users/$owner/repos: not a list\n" unless ref $list eq 'ARRAY';
      last unless @$list;
      for my $r (@$list) {
        my $full = $r->{full_name} // die "GitHub API /users/$owner/repos: a repository without full_name\n";
        next unless lc($r->{name} // '') =~ /\Q@{[ lc $suffix ]}\E$/;
        $found++;
        $repos{lc $full} = { repo => $full, meta => $r, how => 'discovered', suffix => $suffix };
      }
      last if @$list < 100;
    }
    push @notes, "discover $owner *$suffix found no repositories" unless $found;
  }
  for my $key (sort keys $c->{exclude}->%*) {
    push @notes, "exclude $key matches no discovered repository" unless $repos{$key};
  }
  for my $key (sort keys $c->{include}->%*) {
    my $i = $c->{include}{$key};
    my($owner) = $i->{repo} =~ m{^([^/]+)};
    my($d) = grep { lc $_->[0] eq lc $owner } $c->{discover}->@*;
    $repos{$key} //= { repo => $i->{repo}, how => 'included', suffix => $d ? $d->[1] : '16' };
    $repos{$key}{opt} = $i;
  }
  for my $key (sort keys $c->{override}->%*) {
    push @notes, "license-override $c->{override}{$key}{repo} matches no repository" unless $repos{$key};
  }

  my @results;
  for my $key (sort keys %repos) {
    my $r = $repos{$key};
    push @results, resolve_one($c, $r, \@notes);
  }

  # Names: GR-DOS's own, and each other's, ignoring the extension.
  my $reserved = reserved();
  my %by_base;
  for my $res (grep { $_->{kind} eq 'included' } @results) {
    my $b = base($res->{name});
    if(my $own = $reserved->{$b}) {
      fail($res, "$res->{name} has the name of GR-DOS's $own");
      next;
    }
    push $by_base{$b}->@*, $res;
  }
  for my $b (sort keys %by_base) {
    my @same = $by_base{$b}->@*;
    next if @same < 2;
    for my $res (@same) {
      my @others = map { $_->{repo} } grep { $_ != $res } @same;
      fail($res, "$res->{name} has the name of @{[ join ', ', @others ]}'s program");
    }
  }

  for my $res (@results) {
    my $i = $res->{opt} // {};
    die "$res->{repo} is required (dist16/config), but $res->{kind}: $res->{reason}\n"
      if $i->{required} && $res->{kind} ne 'included';
  }
  return (\@results, \@notes);
}

sub fail ($res, $reason) {
  $res->{kind} = 'failed';
  $res->{reason} = $reason;
}

sub resolve_one ($c, $r, $notes) {
  my $repo = $r->{repo};
  my $i = $r->{opt} // {};
  my %res = (repo => $repo, opt => $i);
  my $skip = sub ($kind, $reason) { return { %res, kind => $kind, reason => $reason } };

  if(my $why = $c->{exclude}{lc $repo}) {
    return $skip->('excluded', $why);
  }
  # A discovered library (gr-dos/libc16, gr-dos/libkitchen16) is not a
  # program; an include overrides this. Its source, as a program's
  # dependency (dist16.source), is not affected.
  return $skip->('excluded', $LIBRARY_REASON) if !$i->{repo} && is_library($repo);
  my $meta = $r->{meta} //= api("/repos/$repo") // return $skip->('failed', 'no such repository');
  $repo = $res{repo} = $meta->{full_name} // $repo;
  return $skip->('failed', 'private') if $meta->{private};
  unless($i->{repo}) {
    return $skip->('unavailable', 'a fork') if $meta->{fork};
    return $skip->('unavailable', 'archived') if $meta->{archived};
  }

  my $rel;
  if(my $tag = $i->{tag}) {
    $rel = api("/repos/$repo/releases/tags/$tag") // return $skip->('unavailable', "no release $tag");
    my $latest = api("/repos/$repo/releases/latest");
    push @$notes, "$repo is pinned at $tag; the latest release is $latest->{tag_name}"
      if $latest && ($latest->{tag_name} // '') ne $tag;
  } else {
    $rel = api("/repos/$repo/releases/latest") // return $skip->('unavailable', 'no release');
  }
  my $tag = $rel->{tag_name};
  return $skip->('failed', 'malformed release: no tag_name') unless defined $tag && $tag =~ /^[\w.+-]+$/;
  $res{tag} = $tag;
  return $skip->('unavailable', "$tag is a draft") if $rel->{draft};
  return $skip->('unavailable', "$tag is a prerelease") if $rel->{prerelease};
  my $assets = $rel->{assets};
  return $skip->('failed', "$tag: malformed release: no assets list") unless ref $assets eq 'ARRAY';
  for my $a (@$assets) {
    return $skip->('failed', "$tag: malformed release: an asset without a name or size")
      unless ref $a eq 'HASH' && defined $a->{name} && $a->{name} =~ /^[\w.+-]+$/
        && defined $a->{size} && $a->{size} =~ /^\d+$/;
  }

  # The program.
  my $asset;
  my @names = map { $_->{name} } @$assets;
  if(my $want = $i->{asset}) {
    ($asset) = grep { $_->{name} eq $want } @$assets;
    return $skip->('failed', "$tag has no asset $want (assets: @{[ join(' ', @names) || 'none' ]})") unless $asset;
  } else {
    my($name) = $repo =~ m{/(.*)};
    my $stem = lc($name) =~ s/\Q@{[ lc $r->{suffix} ]}\E$//r;
    my @progs = grep { lc($_->{name}) =~ /^(\Q$stem\E|\Q@{[ lc $name ]}\E)\.(exe|com)$/ } @$assets;
    my %bases;
    $bases{lc base($_->{name})}++ for @progs;
    return $skip->('unavailable', "$tag has no program asset $stem.exe or $stem.com (assets: @{[ join(' ', @names) || 'none' ]})")
      unless @progs;
    return $skip->('failed', "$tag has more than one program (@{[ join ' ', map { $_->{name} } @progs ]}): set asset= in dist16/config")
      if keys %bases > 1;
    # A .COM and an .EXE: the prefer= of its include, or prefer, or the
    # .exe, the C reference (issue #42).
    my $prefer = $i->{prefer} // $c->{prefer};
    my $why = defined $i->{prefer} ? "prefer=$prefer" : $prefer eq 'exe' ? 'the default' : "prefer $prefer";
    my %ext;
    $ext{lc($_->{name}) =~ s/.*\.//r} = $_ for @progs;
    if($ext{$prefer}) {
      $asset = $ext{$prefer};
      $res{chosen} = ".$prefer preferred ($why)" if keys %ext > 1;
    } else {
      ($asset) = values %ext;
      $res{chosen} = "no .$prefer, so the .@{[ lc($asset->{name}) =~ s/.*\.//r ]} ($why)" unless $why eq 'the default';
    }
  }
  $res{asset} = $asset->{name};
  $res{name} = uc $asset->{name};
  $res{ignored} = [ grep { $_ ne $asset->{name} } @names ];
  return $skip->('failed', "$tag: $asset->{name} is not an 8.3 .COM or .EXE name") unless valid_83($res{name});

  my $commit = api("/repos/$repo/commits/$tag") // return $skip->('failed', "$tag: no commit");
  return $skip->('failed', "$tag: malformed commit") unless ($commit->{sha} // '') =~ /^[0-9a-f]{40}$/;
  $res{commit} = $commit->{sha};

  my $lic = api("/repos/$repo/license?ref=$res{commit}") // return $skip->('failed', "$tag: no license");
  my $spdx = $lic->{license}{spdx_id} // 'NOASSERTION';
  my $lpath = $lic->{path} // '';
  my $ltext;
  # A license GitHub does not recognize, which dist16/config's
  # license-override for this repository names, by file and SHA-256, at
  # this commit (issue #83). Anything else fails as without it.
  if((my $o = $c->{override}{lc $repo}) && $spdx eq 'NOASSERTION') {
    my $why = "license-override $o->{spdx} ($o->{where})";
    return $skip->('failed', "$tag: GitHub finds an unrecognized license in $lpath, but the $why names $o->{license}")
      unless $lpath eq $o->{license};
    $ltext = raw($repo, $res{commit}, $lpath) // return $skip->('failed', "$tag: license file $lpath is missing, for the $why");
    my $sha = sha256_hex($ltext);
    return $skip->('failed', "$tag: $lpath at $res{commit} has SHA-256 $sha, but the $why pins $o->{sha256}")
      unless $sha eq $o->{sha256};
    $res{override} = { repo => $repo, github => $spdx, spdx => $o->{spdx}, license => $lpath, sha256 => $sha };
    $res{notices} = [];
    for my $path ($o->{notices}->@*) {
      my $text = raw($repo, $res{commit}, $path) // return $skip->('failed', "$tag: the notice $path ($why) is not at the commit");
      push $res{notices}->@*, { repo => $repo, path => $path, sha256 => sha256_hex($text) };
    }
    $spdx = $o->{spdx};
  } elsif(my $o2 = $c->{override}{lc $repo}) {
    # GitHub now recognizes the override's license itself: the override is
    # to be removed, not silently kept (the lock would need its line).
    return $skip->('failed', "$tag: GitHub finds $spdx itself, so the license-override ($o2->{where}) is not needed: remove it")
      if $spdx eq $o2->{spdx};
    push @$notes, "$repo $tag: the license-override ($o2->{where}) is not used: GitHub finds $spdx";
  }
  return $skip->('failed', "$tag: license $spdx is not one dist16/config allows")
    unless $c->{license}{$spdx} || source_licenses($c, $spdx);
  return $skip->('failed', "$tag: malformed license path") unless safe_path($lpath);
  $ltext //= raw($repo, $res{commit}, $lpath) // return $skip->('failed', "$tag: license file $lpath is missing");
  @res{qw( spdx license license_sha256 )} = ($spdx, $lpath, sha256_hex($ltext));

  my($data, $why) = download($repo, $tag, $asset);
  return $skip->('failed', "$tag: $why") if $why;
  if(my $why = not_dos($asset->{name}, $data)) {
    return $skip->('failed', "$tag: $why");
  }
  @res{qw( size sha256 )} = (length $data, sha256_hex($data));
  # The release's license notice for the program (issue #37): its own
  # asset, which must be the license at the commit, byte for byte.
  if(defined(my $want = $i->{license_asset})) {
    my($la) = grep { $_->{name} eq $want } @$assets;
    return $skip->('failed', "$tag has no license asset $want (license-asset=)") unless $la;
    return $skip->('failed', "$tag: license-asset= names the program $want") if $want eq $asset->{name};
    my($text, $why) = download($repo, $tag, $la);
    return $skip->('failed', "$tag: $why") if $why;
    return $skip->('failed', "$tag: the license asset $want is not $lpath at $res{commit}")
      unless $text eq $ltext;
    $res{license_asset} = { repo => $repo, asset => $want, name => lic_name($res{name}),
      size => length $text, sha256 => sha256_hex($text) };
    $res{ignored} = [ grep { $_ ne $want } $res{ignored}->@* ];
  }
  unless($c->{license}{$spdx}) {
    my $why = source_of($c, \%res, $assets, $data, $ltext);
    return $skip->('failed', "$tag: $why") if $why;
  }
  return { %res, kind => 'included' };
}

sub safe_path ($path) { $path =~ m{^[\w.+-][\w./+-]*$} && $path !~ m{(^|/)\.\.(/|$)} && $path !~ m{//} }

# A file at a commit, or undef if it has none.
sub raw ($repo, $commit, $path) {
  my($status, $text) = get("$opt{raw}/$repo/$commit/$path");
  die "$opt{raw}/$repo/$commit/$path: HTTP $status\n" unless $status == 200 || $status == 404;
  return $status == 200 ? $text : undef;
}

# A release asset, checked against the size and digest GitHub gives:
# (data), or (undef, why not).
sub download ($repo, $tag, $asset) {
  my $url = "$opt{github}/$repo/releases/download/$tag/$asset->{name}";
  my($as, $data) = get($url);
  die "$url: HTTP $as\n" unless $as == 200 || $as == 404;
  return (undef, "$asset->{name} cannot be downloaded") unless $as == 200;
  my $sha = sha256_hex($data);
  if(length($data) != $asset->{size}) {
    return (undef, "$asset->{name} is @{[ length $data ]} bytes, but GitHub says $asset->{size}");
  }
  if(defined $asset->{digest} && $asset->{digest} ne '') {
    my($want) = $asset->{digest} =~ /^sha256:([0-9a-f]{64})$/
      or return (undef, "$asset->{name} has a malformed digest");
    return (undef, "$asset->{name} checksum mismatch: GitHub says $want, downloaded $sha")
      if $want ne $sha;
  }
  return ($data);
}

# A source archive's files, { path => content }, or why it cannot be read.
sub archive ($name, $data) {
  my %f;
  if($name =~ /\.zip$/i) {
    my $z = IO::Uncompress::Unzip->new(\$data, Transparent => 0) or return "$name is not a zip archive";
    my $status;
    for($status = 1; $status > 0; $status = $z->nextStream) {
      my $h = $z->getHeaderInfo or return "$name is not a zip archive";
      my $path = $h->{Name} // '';
      my $content = '';
      while(($status = $z->read(my $chunk)) > 0) { $content .= $chunk }
      last if $status < 0;
      $f{$path} = $content unless $path =~ m{/$};
    }
    return "$name is a damaged zip archive" if $status < 0;
  } elsif($name =~ /\.(tar\.gz|tgz)$/i) {
    my $tar;
    IO::Uncompress::Gunzip::gunzip(\$data => \$tar, Transparent => 0) or return "$name is not gzip compressed";
    local $Archive::Tar::WARN = 0;
    open my $fh, '<', \$tar or die "$name: $!\n";
    my $t = Archive::Tar->new;
    $t->read($fh) or return "$name is not a tar archive";
    $f{$_->full_path} = $_->get_content for grep { $_->is_file } $t->get_files;
  } else {
    return "$name is not a .zip, .tar.gz or .tgz archive";
  }
  %f = map { (s{^\./}{}r, $f{$_}) } keys %f;
  return "$name is empty" unless %f;
  return \%f;
}

# The top directory of an archive that has FILE in it ('' for none), or
# undef.
sub top ($files, $file) {
  my @tops = sort map { m{^([^/]+/)?\Q$file\E$} ? $1 // '' : () } keys %$files;
  return @tops == 1 ? $tops[0] : undef;
}

sub read_manifest ($text) {
  my %m = (notice => [], depends => []);
  my $n = 0;
  for my $line (split /\r?\n/, $text) {
    $n++;
    $line =~ s/#.*//;
    my @w = split ' ', $line;
    next unless @w;
    my $cmd = shift @w;
    if($cmd =~ /^(license|source|build)$/) {
      return "line $n: $cmd takes one value" unless @w == 1;
      return "line $n: $cmd is given twice" if defined $m{$cmd};
      return "line $n: malformed $cmd" unless $cmd eq 'license' ? $w[0] =~ /^[\w.+-]+$/
        : $cmd eq 'source' ? $w[0] =~ /^[\w.+-]+$/ : safe_path($w[0]);
      $m{$cmd} = $w[0];
    } elsif($cmd eq 'notice') {
      return "line $n: notice PATH" unless @w == 1 && safe_path($w[0]);
      push $m{notice}->@*, $w[0];
    } elsif($cmd eq 'depends') {
      return "line $n: depends OWNER/NAME TAG ASSET"
        unless @w == 3 && $w[0] =~ m{^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$} && $w[1] =~ /^[\w.+-]+$/ && $w[2] =~ /^[\w.+-]+$/;
      push $m{depends}->@*, [@w];
    } else {
      return "line $n: unknown directive $cmd";
    }
  }
  for (qw( license source build )) {
    return "no $_ line" unless defined $m{$_};
  }
  return \%m;
}

# A program under a source license: its dist16.source at the release's
# commit, and the corresponding source the manifest names, each checked.
# Fills in RES; returns why the program fails, or undef.
sub source_of ($c, $res, $assets, $exe, $ltext) {
  my($repo, $tag, $commit) = $res->@{qw( repo tag commit )};
  my $mtext = raw($repo, $commit, $MANIFEST)
    // return "license $res->{spdx} needs the program's source, but there is no $MANIFEST at its commit";
  my $m = read_manifest($mtext);
  return "$MANIFEST: $m" unless ref $m;
  return "GitHub finds $res->{spdx} in $res->{license}, but $MANIFEST says $m->{license}"
    unless spdx_base($m->{license}) eq $res->{spdx};
  return "license $m->{license} ($MANIFEST) is not one dist16/config allows" unless $c->{source_license}{$m->{license}};
  return "$res->{asset} contains Open Watcom's C runtime, which $MANIFEST does not cover"
    if $exe =~ m{WATCOM C/C\+\+\d* Run.?Time}i;

  # The program's source: an asset of the same release.
  my($sa) = grep { $_->{name} eq $m->{source} } @$assets;
  return "$MANIFEST names the source $m->{source}, which the release does not have" unless $sa;
  return "$MANIFEST names the program as its source" if $sa->{name} eq $res->{asset};
  my($data, $why) = download($repo, $tag, $sa);
  return $why if $why;
  my $files = archive($sa->{name}, $data);
  return $files unless ref $files;
  my $top = top($files, $MANIFEST) // return "the source $sa->{name} has no $MANIFEST (or more than one)";
  return "the source $sa->{name} has another $MANIFEST than the commit's" unless $files->{"$top$MANIFEST"} eq $mtext;
  return "the source $sa->{name} has no $res->{license}, or another one than the commit's"
    unless ($files->{"$top$res->{license}"} // '') eq $ltext && $ltext ne '';
  return "the source $sa->{name} has no $m->{build} (the build instructions $MANIFEST names)"
    unless defined $files->{"$top$m->{build}"};
  $res->{ignored} = [ grep { $_ ne $sa->{name} } $res->{ignored}->@* ];
  $res->{source} = { repo => $repo, asset => $sa->{name}, size => length $data, sha256 => sha256_hex($data), build => $m->{build} };

  # Further notices: at the commit, and the same in the source.
  $res->{notices} = [];
  for my $path ($m->{notice}->@*) {
    my $text = raw($repo, $commit, $path) // return "the notice $path ($MANIFEST) is not at the commit";
    return "the source $sa->{name} has no $path, or another one than the commit's" unless ($files->{"$top$path"} // '') eq $text;
    push $res->{notices}->@*, { repo => $repo, path => $path, sha256 => sha256_hex($text) };
  }

  # The libraries linked into the program, and their source.
  $res->{depends} = [];
  my %names = ($sa->{name} => $repo);
  for my $d ($m->{depends}->@*) {
    my $dep = dependency($c, @$d);
    return "depends $d->[0] $d->[1]: $dep" unless ref $dep;
    return "depends $d->[0] $d->[1]: its source $dep->{asset} has the name of $names{$dep->{asset}}'s" if $names{$dep->{asset}};
    $names{$dep->{asset}} = $dep->{dep};
    push $res->{depends}->@*, { %$dep, repo => $repo };
  }
  $res->{spdx} = $m->{license};
  return undef;
}

# A library a program is linked with: its release, commit, license, and
# the source ASSET, checked; or why not.
sub dependency ($c, $repo, $tag, $name) {
  my $rel = api("/repos/$repo/releases/tags/$tag") // return "no release $tag";
  return "$tag is a draft" if $rel->{draft};
  return "$tag is a prerelease" if $rel->{prerelease};
  return "malformed release: no assets list" unless ref $rel->{assets} eq 'ARRAY';
  my($asset) = grep { ref $_ eq 'HASH' && ($_->{name} // '') eq $name } $rel->{assets}->@*;
  return "no asset $name" unless $asset;
  return "malformed release: $name has no size" unless ($asset->{size} // '') =~ /^\d+$/;
  my $commit = api("/repos/$repo/commits/$tag") // return "no commit";
  return "malformed commit" unless ($commit->{sha} // '') =~ /^[0-9a-f]{40}$/;
  my $lic = api("/repos/$repo/license?ref=$commit->{sha}") // return "no license";
  my $spdx = $lic->{license}{spdx_id} // 'NOASSERTION';
  my $lpath = $lic->{path} // '';
  return "license $spdx is not one dist16/config allows" unless $c->{license}{$spdx} || source_licenses($c, $spdx);
  return "malformed license path" unless safe_path($lpath);
  my $ltext = raw($repo, $commit->{sha}, $lpath) // return "license file $lpath is missing";
  my($data, $why) = download($repo, $tag, $asset);
  return $why if $why;
  my $files = archive($name, $data);
  return $files unless ref $files;
  my $top = top($files, $lpath);
  return "its source $name has no $lpath, or another one than the commit's"
    unless defined $top && $files->{"$top$lpath"} eq $ltext;
  return { dep => $repo, tag => $tag, commit => $commit->{sha}, asset => $name, size => length $data,
    sha256 => sha256_hex($data), spdx => $spdx, license => $lpath, license_sha256 => sha256_hex($ltext) };
}

sub lock_text ($results) {
  my @lines = (
    '# The *16 programs of the full distribution (issue #36), written by',
    '# `make dist16-resolve` from dist16/config: do not edit. Review changes in',
    '# the pull request that updates it (docs/dist16.md).',
    '#',
    "# program @{[ map { uc } @FIELDS ]}",
    '# and after a program under a source license (dist16/config, dist16.source):',
    "# source @{[ map { uc } @SOURCE ]}",
    "# notice @{[ map { uc } @NOTICE ]}",
    "# depend @{[ map { uc } @DEPEND ]}",
    '# and after a program under a license-override (dist16/config), before its notices:',
    "# override @{[ map { uc } @OVERRIDE ]}",
    '# and right after a program whose include has license-asset= (dist16/config):',
    "# license-asset @{[ map { uc } @LICENSE_ASSET ]}",
    '# skip REPO KIND REASON',
  );
  for my $res (@$results) {
    if($res->{kind} eq 'included') {
      push @lines, join ' ', 'program', map { $res->{$_} } @FIELDS;
      if(my $l = $res->{license_asset}) { push @lines, join ' ', 'license-asset', map { $l->{$_} } @LICENSE_ASSET }
      if(my $o = $res->{override}) { push @lines, join ' ', 'override', map { $o->{$_} } @OVERRIDE }
      if(my $s = $res->{source}) { push @lines, join ' ', 'source', map { $s->{$_} } @SOURCE }
      for my $x (($res->{notices} // [])->@*) { push @lines, join ' ', 'notice', map { $x->{$_} } @NOTICE }
      for my $x (($res->{depends} // [])->@*) { push @lines, join ' ', 'depend', map { $x->{$_} } @DEPEND }
    } else {
      push @lines, join ' ', 'skip', $res->{repo}, $res->{kind}, $res->{reason};
    }
  }
  return join("\n", @lines) . "\n";
}

sub report ($results, $notes) {
  for my $res (@$results) {
    if($res->{kind} eq 'included') {
      my $ign = $res->{ignored}->@* ? " (ignored: @{ $res->{ignored} })" : '';
      my $src = '';
      if(my $s = $res->{source}) {
        $src = ", source $s->{asset}" . join '', map { ", with $_->{dep} $_->{tag} ($_->{spdx}, source $_->{asset})" } $res->{depends}->@*;
      }
      my $chosen = $res->{chosen} ? ", $res->{chosen}" : '';
      $chosen .= ", license $res->{license_asset}{asset} as $res->{license_asset}{name}" if $res->{license_asset};
      if(my $o = $res->{override}) {
        $src = " by license-override (GitHub finds $o->{github}; $o->{license} SHA-256 verified"
          . join('', map { ", notice $_->{path}" } $res->{notices}->@*) . ')';
      }
      say sprintf '%-12s %s %s %s as %s, %s%s%s%s', 'included', $res->{repo}, $res->{tag}, $res->{asset}, $res->{name}, $res->{spdx}, $src, $chosen, $ign;
    } else {
      say sprintf '%-12s %s: %s', $res->{kind}, $res->{repo}, $res->{reason};
    }
  }
  say sprintf '%-12s %s', 'note', $_ for @$notes;
}

sub read_lock () {
  my $c = read_config($opt{config});
  my @programs;
  my $n = 0;
  my $hex = sub ($v, $len) { $v =~ /^[0-9a-f]{$len}$/ };
  my $fields = sub ($kind, $names, @w) {
    die "$opt{lock}:$n: a $kind line has @{[ scalar @$names ]} fields\n" unless @w == @$names;
    my %h;
    @h{@$names} = @w;
    return \%h;
  };
  for my $line (split /\n/, slurp($opt{lock})) {
    $n++;
    next if $line =~ /^\s*(#|$)/;
    my($kind, @w) = split ' ', $line;
    if($kind eq 'program') {
      my $p = $fields->('program', \@FIELDS, @w);
      die "$opt{lock}:$n: malformed program line\n"
        unless $p->{repo} =~ m{^[\w.-]+/[\w.-]+$} && $hex->($p->{commit}, 40) && $p->{size} =~ /^\d+$/
          && $hex->($p->{sha256}, 64) && $hex->($p->{license_sha256}, 64) && valid_83($p->{name})
          && $p->{name} eq uc $p->{asset} && safe_path($p->{license});
      $p->{notices} = [];
      $p->{depends} = [];
      push @programs, $p;
    } elsif($kind eq 'license-asset') {
      my $x = $fields->($kind, \@LICENSE_ASSET, @w);
      my $p = $programs[-1];
      die "$opt{lock}:$n: a license-asset line must follow its program's\n" unless $p && $p->{repo} eq $x->{repo};
      die "$opt{lock}:$n: a license-asset line out of place\n"
        if $p->{license_asset} || $p->{override} || $p->{source} || $p->{notices}->@*;
      die "$opt{lock}:$n: malformed license-asset line\n"
        unless $x->{asset} =~ /^[\w.+-]+$/ && $x->{asset} ne $p->{asset} && $x->{size} =~ /^\d+$/
          && $hex->($x->{sha256}, 64) && $x->{name} eq lic_name($p->{name});
      die "$opt{lock}:$n: the license-asset line is not its program's license\n" unless $x->{sha256} eq $p->{license_sha256};
      $p->{license_asset} = $x;
    } elsif($kind eq 'override') {
      my $x = $fields->($kind, \@OVERRIDE, @w);
      my $p = $programs[-1];
      die "$opt{lock}:$n: an override line must follow its program's\n" unless $p && $p->{repo} eq $x->{repo};
      die "$opt{lock}:$n: an override line out of place\n" if $p->{override} || $p->{source} || $p->{notices}->@*;
      die "$opt{lock}:$n: malformed override line\n" unless $hex->($x->{sha256}, 64) && safe_path($x->{license});
      die "$opt{lock}:$n: the override line is not its program's license\n"
        unless $x->{spdx} eq $p->{spdx} && $x->{license} eq $p->{license} && $x->{sha256} eq $p->{license_sha256};
      $p->{override} = $x;
    } elsif($kind eq 'source' || $kind eq 'notice' || $kind eq 'depend') {
      my $x = $fields->($kind, { source => \@SOURCE, notice => \@NOTICE, depend => \@DEPEND }->{$kind}, @w);
      my $p = $programs[-1];
      die "$opt{lock}:$n: a $kind line must follow its program's\n" unless $p && $p->{repo} eq $x->{repo};
      die "$opt{lock}:$n: a $kind line out of place\n"
        unless $kind eq 'source' ? !$p->{source} && !$p->{override}
          : $kind eq 'notice' ? $p->{source} || $p->{override} : $p->{source};
      die "$opt{lock}:$n: malformed $kind line\n" unless $hex->($x->{sha256}, 64) && ($kind eq 'notice'
        ? safe_path($x->{path})
        : $x->{asset} =~ /^[\w.+-]+$/ && $x->{size} =~ /^\d+$/ && ($kind eq 'source' ? safe_path($x->{build})
          : $x->{dep} =~ m{^[\w.-]+/[\w.-]+$} && $x->{tag} =~ /^[\w.+-]+$/ && $hex->($x->{commit}, 40)
            && $hex->($x->{license_sha256}, 64) && safe_path($x->{license})));
      if($kind eq 'source') { $p->{source} = $x }
      else { push $p->{$kind . 's'}->@*, $x }
    } elsif($kind ne 'skip') {
      die "$opt{lock}:$n: unknown line $kind\n";
    }
  }
  my $reserved = reserved();
  my %seen;
  for my $p (@programs) {
    my $b = base($p->{name});
    die "$opt{lock}: $p->{name} ($p->{repo}) has the name of GR-DOS's $reserved->{$b}\n" if $reserved->{$b};
    die "$opt{lock}: $p->{name} ($p->{repo}) has the name of $seen{$b}'s program\n" if $seen{$b};
    $seen{$b} = $p->{repo};
    # The license decides whether the source must be shipped: a program
    # under a source license with no source line is refused, not shipped.
    if($p->{source}) {
      die "$opt{lock}: $p->{name} ($p->{repo}) has a source line, but $p->{spdx} is not a source-license in $opt{config}\n"
        unless $c->{source_license}{$p->{spdx}};
      my %names;
      for ($p->{source}, $p->{depends}->@*) {
        die "$opt{lock}: $p->{name} ($p->{repo}) has two sources named $_->{asset}\n" if $names{$_->{asset}}++;
      }
    } else {
      die "$opt{lock}: $p->{name} ($p->{repo}) is under $p->{spdx}, which needs a source line\n"
        if $c->{source_license}{$p->{spdx}};
      die "$opt{lock}: $p->{name} ($p->{repo}) is under $p->{spdx}, which is not a license in $opt{config}\n"
        unless $c->{license}{$p->{spdx}};
    }
    # A license-override in the lock must be the config's, exactly; and a
    # program under the license of the config's override for its
    # repository must have it, with its notices: the lock records that
    # GitHub did not recognize the license, and what was verified instead.
    my $want = $c->{override}{lc $p->{repo}};
    die "$opt{lock}: $p->{name} ($p->{repo}) is under $p->{spdx}, the license-override's ($want->{where}), but has no override line\n"
      if $want && !$p->{override} && $p->{spdx} eq $want->{spdx};
    if(my $x = $p->{override}) {
      my $o = $c->{override}{lc $p->{repo}};
      die "$opt{lock}: $p->{name} ($p->{repo}) has a license-override that $opt{config} does not have\n" unless $o;
      die "$opt{lock}: $p->{name} ($p->{repo}) has another license-override than $opt{config}'s ($o->{where})\n"
        unless $x->{spdx} eq $o->{spdx} && $x->{license} eq $o->{license} && $x->{sha256} eq $o->{sha256}
          && join("\0", map { $_->{path} } $p->{notices}->@*) eq join("\0", $o->{notices}->@*);
    }
    # A license-asset in the lock is the one the config's include names,
    # and the include's is in the lock.
    my $la = ($c->{include}{lc $p->{repo}} // {})->{license_asset};
    die "$opt{lock}: $p->{name} ($p->{repo}) has no license-asset line, but $opt{config} names $la\n"
      if defined $la && !$p->{license_asset};
    die "$opt{lock}: $p->{name} ($p->{repo}) has the license-asset $p->{license_asset}{asset}, but $opt{config} names "
      . ($la // 'none') . "\n" if $p->{license_asset} && ($la // '') ne $p->{license_asset}{asset};
    for my $d ($p->{depends}->@*) {
      die "$opt{lock}: $p->{name} ($p->{repo}) depends on $d->{dep}, under $d->{spdx}, which $opt{config} does not allow\n"
        unless $c->{license}{$d->{spdx}} || source_licenses($c, $d->{spdx});
    }
  }
  return \@programs;
}

# A verified copy of a file the lock pins, from the cache or downloaded.
sub cached ($url, $path, $sha256, $what) {
  return $path if -f $path && sha256_hex(slurp($path)) eq $sha256;
  my($status, $data) = get($url);
  die "$what: cannot download $url (HTTP $status), and no verified copy is in $opt{cache}\n" unless $status == 200;
  my $got = sha256_hex($data);
  die "$what: checksum mismatch: dist16/lock pins $sha256, $url is $got\n" unless $got eq $sha256;
  make_path(dirname($path));
  spew($path, $data);
  return $path;
}

sub sourced ($programs) { grep { $_->{source} } @$programs }

sub release_url ($repo, $tag, $asset) { "$opt{github}/$repo/releases/download/$tag/$asset" }

sub cmd_fetch ($dest) {
  my $programs = read_lock();
  die "$dest exists and is not a dist16 directory\n" if -e $dest && !-e "$dest/.dist16";
  remove_tree($dest);
  make_path("$dest/licenses");
  # Marked at once, so a fetch that fails part way can be run again.
  spew("$dest/.dist16", '');
  for my $p (@$programs) {
    my $dir = "$opt{cache}/$p->{repo}/$p->{tag}";
    my $what = "$p->{repo} $p->{tag}";
    my $exe = cached(release_url($p->{repo}, $p->{tag}, $p->{asset}), "$dir/$p->{asset}", $p->{sha256}, "$what $p->{asset}");
    my $lic = cached("$opt{raw}/$p->{repo}/$p->{commit}/$p->{license}", "$dir/license",
      $p->{license_sha256}, "$what $p->{license}");
    copy($exe, "$dest/$p->{name}") or die "$dest/$p->{name}: $!\n";
    copy($lic, "$dest/licenses/$p->{name}.txt") or die "$dest/licenses/$p->{name}.txt: $!\n";
    # The release's license notice, beside the program (issue #37).
    if(my $l = $p->{license_asset}) {
      my $f = cached(release_url($p->{repo}, $p->{tag}, $l->{asset}), "$dir/$l->{asset}", $l->{sha256}, "$what $l->{asset}");
      copy($f, "$dest/$l->{name}") or die "$dest/$l->{name}: $!\n";
    }
    # The further notices (a source license's, or a license-override's),
    # in licenses.
    my $k = 0;
    for my $x ($p->{notices}->@*) {
      $k++;
      my $f = cached("$opt{raw}/$p->{repo}/$p->{commit}/$x->{path}", "$dir/notice/" . ($x->{path} =~ tr{/}{_}r),
        $x->{sha256}, "$what $x->{path}");
      copy($f, "$dest/licenses/$p->{name}.notice$k.txt") or die "$dest/licenses: $!\n";
    }
    my $s = $p->{source} or next;
    # The corresponding source, in source/NAME, and the libraries'
    # licenses, in licenses.
    my $sdir = "$dest/source/" . base($p->{name});
    make_path($sdir);
    my $src = cached(release_url($p->{repo}, $p->{tag}, $s->{asset}), "$dir/$s->{asset}", $s->{sha256}, "$what $s->{asset}");
    copy($src, "$sdir/$s->{asset}") or die "$sdir/$s->{asset}: $!\n";
    $k = 0;
    for my $d ($p->{depends}->@*) {
      $k++;
      my $ddir = "$opt{cache}/$d->{dep}/$d->{tag}";
      my $f = cached(release_url($d->{dep}, $d->{tag}, $d->{asset}), "$ddir/$d->{asset}", $d->{sha256}, "$d->{dep} $d->{tag} $d->{asset}");
      copy($f, "$sdir/$d->{asset}") or die "$sdir/$d->{asset}: $!\n";
      $f = cached("$opt{raw}/$d->{dep}/$d->{commit}/$d->{license}", "$ddir/license.$d->{license_sha256}",
        $d->{license_sha256}, "$d->{dep} $d->{tag} $d->{license}");
      copy($f, "$dest/licenses/$p->{name}.depend$k.txt") or die "$dest/licenses: $!\n";
    }
  }
  # How to get the source, with the licenses, beside the programs: in
  # C:\DOS, and the ZIP's BIN.
  if(my @s = sourced($programs)) {
    spew("$dest/$SOURCES", (sources_text(@s) . license_text($dest, @s)) =~ s/\r?\n/\r\n/gr);
  }
  say "$_->{name}  $_->{repo} $_->{tag}" for @$programs;
}

# Each program's license, and under a source license its further notices
# and its libraries' licenses, from a fetch's DEST.
sub license_text ($dest, @programs) {
  my $out = '';
  my $text = sub ($head, $path) {
    my $t = slurp($path) =~ s/\r//gr;
    $t =~ s/\n*\z/\n/;
    $out .= "\n\n$head\n" . ('-' x length $head) . "\n\n$t";
  };
  for my $p (@programs) {
    $text->("$p->{name}: $p->{repo} $p->{tag} (commit $p->{commit}), $p->{spdx}", "$dest/licenses/$p->{name}.txt");
    my $k = 0;
    for my $x ($p->{notices}->@*) {
      $k++;
      $text->("$p->{name}: $x->{path}", "$dest/licenses/$p->{name}.notice$k.txt");
    }
    $k = 0;
    for my $d ($p->{depends}->@*) {
      $k++;
      $text->("$p->{name}: linked with $d->{dep} $d->{tag} (commit $d->{commit}), $d->{spdx}", "$dest/licenses/$p->{name}.depend$k.txt");
    }
  }
  return $out;
}

# Where the exact source of each program under a source license is: in
# the release ZIP, and on GitHub, pinned by the lock.
sub sources_text (@programs) {
  return '' unless @programs;
  my $out = <<'END';
Corresponding source
--------------------

GR-DOS is an aggregation of separately licensed programs; it does not
relicense them. The programs below are under licenses, such as the GNU
GPL, that require their complete corresponding source to be available to
everyone who receives them. GR-DOS ships each one unchanged, as its
project released it, and its source is that release's source archive,
with the source of each library linked into it. These are the exact
files, pinned by commit and SHA-256 in GR-DOS's dist16/lock, not a link to
a branch that changes.

The release ZIP holds each archive in its SOURCE directory, as named
below. A CF card or hard disk installed with GR-DOS holds this text in
C:\DOS\SOURCES.TXT, but not the archives: get them from the ZIP of the
same GR-DOS release, or from GitHub at the addresses below, and check them
with sha256sum.
END
  for my $p (@programs) {
    my $s = $p->{source};
    my $dir = 'SOURCE\\' . base($p->{name}) . '\\';
    $out .= "\n$p->{name}: $p->{repo} $p->{tag}, $p->{spdx}\n";
    $out .= "  commit    $p->{commit}\n";
    $out .= "  program   https://github.com/$p->{repo}/releases/download/$p->{tag}/$p->{asset}\n";
    $out .= "            SHA-256 $p->{sha256}\n";
    $out .= "  source    https://github.com/$p->{repo}/releases/download/$p->{tag}/$s->{asset}\n";
    $out .= "            SHA-256 $s->{sha256}, $s->{size} bytes\n";
    $out .= "            in the ZIP: $dir$s->{asset}\n";
    $out .= "  build     $s->{build}, in the source archive\n";
    $out .= "  license   $p->{license} in the source archive, and at the end of this file\n";
    for my $d ($p->{depends}->@*) {
      $out .= "  linked    with $d->{dep} $d->{tag} (commit $d->{commit}), $d->{spdx}\n";
      $out .= "  source    https://github.com/$d->{dep}/releases/download/$d->{tag}/$d->{asset}\n";
      $out .= "            SHA-256 $d->{sha256}, $d->{size} bytes\n";
      $out .= "            in the ZIP: $dir$d->{asset}\n";
    }
  }
  return "$out\n";
}

sub cmd_notices ($dest) {
  print license_text($dest, read_lock()->@*);
}

# Check a packaged distribution, DIR: the release ZIP's tree (README.txt,
# BIN and SOURCE) or the CF install's files (no BIN), against the
# lock and what fetch staged in DEST. Each program under a source license
# must be there with its source, and its licenses in full, and nothing else
# may be in SOURCE.
sub cmd_check_dist ($dir, $dest) {
  my $programs = read_lock();
  my @s = sourced($programs);
  my $cf = !-d "$dir/BIN";
  my $bin = $cf ? $dir : "$dir/BIN";
  my $norm = sub ($t) { $t =~ s/\r//gr };
  my $sha = sub ($path) { -f $path ? sha256_hex(slurp($path)) : '' };
  my @texts;
  push @texts, $norm->(slurp("$bin/$SOURCES")) if -f "$bin/$SOURCES";
  push @texts, $norm->(slurp("$dir/README.txt")) unless $cf;
  my @problems;
  # Each program's license notice asset, beside it (issue #37).
  for my $p (grep { $_->{license_asset} } @$programs) {
    my $l = $p->{license_asset};
    push @problems, "$bin/$l->{name} is not the license of $p->{name} dist16/lock pins ($l->{asset})"
      unless $sha->("$bin/$l->{name}") eq $l->{sha256};
  }
  if(!@s) {
    push @problems, "$bin/$SOURCES: no program has a source license, but it exists" if -e "$bin/$SOURCES";
    push @problems, "$dir/SOURCE: no program has a source license, but it exists" if -e "$dir/SOURCE";
  } else {
    push @problems, "$bin/$SOURCES is missing" unless -f "$bin/$SOURCES";
    my %want;
    for my $p (@s) {
      push @problems, "$bin/$p->{name} is not the program dist16/lock pins" unless $sha->("$bin/$p->{name}") eq $p->{sha256};
      for my $x ($p->{source}, $p->{depends}->@*) {
        my $path = "SOURCE/" . base($p->{name}) . "/$x->{asset}";
        $want{$path} = 1;
        push @problems, "$dir/$path is not the source dist16/lock pins" if !$cf && $sha->("$dir/$path") ne $x->{sha256};
        for my $t (@texts) {
          push @problems, "the source text does not give $x->{asset}'s SHA-256" unless index($t, $x->{sha256}) >= 0;
        }
      }
      # The license texts, as fetched, in full.
      my @lic = map { $norm->(slurp($_)) =~ s/\n*\z//r }
        grep { m{/\Q$p->{name}\E\.(txt|notice\d+\.txt|depend\d+\.txt)$} } files_under("$dest/licenses");
      push @problems, "$dest/licenses has no license of $p->{name}" unless @lic;
      for my $t (@texts) {
        for my $l (@lic) {
          push @problems, "a license text of $p->{name} is not in full in the source text" unless index($t, $l) >= 0;
        }
        push @problems, "the source text does not name $p->{name}" unless $t =~ /^\Q$p->{name}: $p->{repo} $p->{tag}, $p->{spdx}\E$/m;
        push @problems, "the license text of $p->{name} ($p->{spdx}) is missing"
          unless $t =~ /^\Q$p->{name}: $p->{repo} $p->{tag} (commit $p->{commit}), $p->{spdx}\E$/m;
      }
    }
    if(!$cf) {
      for my $f (sort map { s{^\Q$dir\E/}{}r } files_under("$dir/SOURCE")) {
        push @problems, "$dir/$f is not a source dist16/lock pins" unless $want{$f};
      }
    }
  }
  die join('', map { "$_\n" } @problems) if @problems;
  if(my @l = grep { $_->{license_asset} } @$programs) {
    say "$dir: " . join(', ', map { "$_->{license_asset}{name}, the license of $_->{name}" } @l);
  }
  say "$dir: " . (@s ? join(', ', map { "$_->{name} ($_->{spdx})" } @s) . ' with source and licenses' : 'no program under a source license');
}

sub files_under ($dir) {
  return () unless -d $dir;
  opendir my $dh, $dir or die "$dir: $!\n";
  my @f;
  for my $e (sort grep { !/^\.\.?$/ } readdir $dh) {
    push @f, -d "$dir/$e" ? files_under("$dir/$e") : "$dir/$e";
  }
  return @f;
}

sub main (@args) {
  GetOptionsFromArray(\@args, \%opt, 'config=s', 'lock=s', 'cache=s', 'api=s', 'github=s', 'raw=s', 'reserved=s')
    or die "usage: scripts/dist16 [OPTIONS] resolve|check|fetch DEST|list|notices DEST|bin-list|sources|check-dist DIR DEST\n";
  my $cmd = shift(@args) // '';
  if($cmd eq 'resolve' || $cmd eq 'check') {
    my $c = read_config($opt{config});
    my($results, $notes) = resolve_all($c);
    report($results, $notes);
    my $text = lock_text($results);
    if($cmd eq 'resolve') {
      spew($opt{lock}, $text);
      say "wrote $opt{lock}";
      return 0;
    }
    my $old = -f $opt{lock} ? slurp($opt{lock}) : '';
    if($old eq $text) {
      say "$opt{lock} is up to date";
      return 0;
    }
    my %old = map { $_ => 1 } split /\n/, $old;
    my %new = map { $_ => 1 } split /\n/, $text;
    say "$opt{lock} differs from what resolve would write:";
    say "- $_" for grep { !$new{$_} } split /\n/, $old;
    say "+ $_" for grep { !$old{$_} } split /\n/, $text;
    return 1;
  }
  if($cmd eq 'fetch' && @args == 1) {
    cmd_fetch($args[0]);
    return 0;
  }
  if($cmd eq 'list') {
    my $programs = read_lock();
    for my $p (@$programs) {
      say $p->{name};
      say $p->{license_asset}{name} if $p->{license_asset};
    }
    say $SOURCES if sourced($programs);
    return 0;
  }
  if($cmd eq 'sources') {
    print sources_text(sourced(read_lock()));
    return 0;
  }
  if($cmd eq 'check-dist' && @args == 2) {
    cmd_check_dist(@args);
    return 0;
  }
  if($cmd eq 'notices' && @args == 1) {
    cmd_notices($args[0]);
    return 0;
  }
  if($cmd eq 'bin-list') {
    my %skip = map { uc($_) => 1 } @args;
    my $programs = read_lock();
    for my $p (grep { !$skip{$_->{name}} } @$programs) {
      printf "  BIN\\%-12s from %s %s, %s\n", $p->{name}, $p->{repo}, $p->{tag}, $p->{spdx};
      printf "  BIN\\%-12s %s's license notice, the release's %s\n", $p->{license_asset}{name}, $p->{name}, $p->{license_asset}{asset}
        if $p->{license_asset};
    }
    printf "  BIN\\%-12s where to get the source of %s\n", $SOURCES, join ', ', map { $_->{name} } sourced($programs)
      if sourced($programs);
    return 0;
  }
  die "usage: scripts/dist16 [OPTIONS] resolve|check|fetch DEST|list|notices DEST|bin-list|sources|check-dist DIR DEST\n";
}

my $rc = eval { main(@ARGV) };
if(!defined $rc) {
  print STDERR "dist16: $@";
  exit 2;
}
exit $rc;
